# ==============================================================================
# ANIKALANG RAG APP - UNIVERSAL AI ARCHITECTURE
# Uses ai_init for provider config + rag_init for chunking settings
# Works with: Ollama, OpenRouter, OpenAI, Groq, LM Studio, etc.
# ==============================================================================

# --- GLOBAL STATE ---
win = null
chat_text_view = null
question_text = null
status_label = null
stats_label = null
chunk_size_entry = null
overlap_entry = null
top_k_entry = null
api_key_entry = null
base_url_entry = null
embed_model_entry = null
chat_model_entry = null
provider_combo = null

# Global UI References for Resizing
header_bg = null
statusbar_bg = null
left_panel = null
center_panel = null
right_panel = null
btn_ingest = null
btn_clear = null
btn_apply = null
btn_ask = null

# ==============================================================================
# INITIALIZATION
# ==============================================================================

def init_app() {
    build_ui()
    
    api_key = ""
    base_url = "http://127.0.0.1:11434/v1"
    embed_model = "nomic-embed-text"
    chat_model = "llama3.2:3b"
    chunk_size = 1000
    overlap = 200
    top_k = 5
    
    try {
        ai_init(api_key, base_url, chat_model, embed_model)
        rag_init(chunk_size, overlap, top_k)
        
        set_status("✅ RAG System Initialized (Ollama)")
        ui_color(status_label, "#27ae60", "")
        update_stats()
    } catch err {
        set_status(rejoin("⚠️ Init Error: ", err))
        ui_color(status_label, "#e74c3c", "")
    }
    
    ui_mainloop(win)
}

# ==============================================================================
# UI LAYOUT
# ==============================================================================

