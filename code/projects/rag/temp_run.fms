# ==============================================================================
# PROVIDER PRESETS
# ==============================================================================

def on_provider_change() {
    idx = ui_combobox_get_index(provider_combo)
    
    # ✅ FIX: Replaced 'else if' with sequential 'if' statements to avoid parser ambiguity
    if idx == 0 {
        ui_set(api_key_entry, "")
        ui_set(base_url_entry, "http://127.0.0.1:11434/v1")
        ui_set(embed_model_entry, "nomic-embed-text")
        ui_set(chat_model_entry, "llama3.2:3b")
    }
    if idx == 1 {
        ui_set(base_url_entry, "https://openrouter.ai/api/v1")
        ui_set(embed_model_entry, "openai/text-embedding-3-small")
        ui_set(chat_model_entry, "openrouter/free")
    }
    if idx == 2 {
        ui_set(base_url_entry, "https://api.openai.com/v1")
        ui_set(embed_model_entry, "text-embedding-3-small")
        ui_set(chat_model_entry, "gpt-4o-mini")
    }
    if idx == 3 {
        ui_set(base_url_entry, "https://api.groq.com/openai/v1")
        ui_set(embed_model_entry, "")
        ui_set(chat_model_entry, "llama-3.1-70b-versatile")
    }
    if idx == 4 {
        ui_set(api_key_entry, "")
        ui_set(base_url_entry, "http://localhost:1234/v1")
        ui_set(embed_model_entry, "nomic-embed-text")
        ui_set(chat_model_entry, "local-model")
    }
}

# ==============================================================================
# ACTIONS
# ==============================================================================

def do_ingest_pdf() {
    file_path = ui_file_open(null)
    
    if file_path == "" or file_path == null { return }
    if starts_with(file_path, "ERROR") {
        ui_alert_err(rejoin("File dialog failed:\n\n", file_path))
        return
    }
    
    file_path = trim(file_path)
    ext = lower(path_ext(file_path))
    if ext != ".pdf" {
        ui_alert_err(rejoin("Please select a PDF file!\n\nSelected: ", file_path))
        return
    }
    
    chunk_size = 1000
    overlap = 200
    try {
        chunk_size = int(ui_get(chunk_size_entry))
        overlap = int(ui_get(overlap_entry))
    } catch err {
    }
    
    file_name = path_file(file_path)
    
    set_status(rejoin("⏳ Processing ", file_name, "..."))
    ui_color(status_label, "#f39c12", "")
    ui_refresh(win)
    
    try {
        result = rag_ingest_pdf(file_path, chunk_size, overlap)
        
        set_status(rejoin("✅ ", result))
        ui_color(status_label, "#27ae60", "")
        update_stats()
        
        stats = rag_get_stats()
        if stats["chunks"] < 5 and stats["total_pages"] > 10 {
            ui_alert(rejoin("⚠️ WARNING: Only ", str(stats["chunks"]), " chunks from ", str(stats["total_pages"]), " pages!\n\nThe PDF may be scanned images requiring OCR."))
        } else {
            ui_alert(rejoin("Success!\n\n", result))
        }
        
    } catch err {
        set_status(rejoin("❌ Error: ", err))
        ui_color(status_label, "#e74c3c", "")
        ui_alert_err(rejoin("Failed to ingest PDF:\n\n", err))
    }
}

def do_ask() {
    question = trim(ui_text_get(question_text))
    if len(question) == 0 {
        ui_alert_err("Please enter a question!")
        return
    }
    
    stats = rag_get_stats()
    if stats["chunks"] == 0 {
        ui_alert_err("Knowledge base is empty! Please ingest a PDF first.")
        return
    }
    
    top_k = 5
    try {
        top_k = int(ui_get(top_k_entry))
    } catch err {
    }
    
    append_chat_text("You", question)
    ui_text_set(question_text, "")
    
    set_status("🔍 Searching knowledge base & generating answer...")
    ui_color(status_label, "#f39c12", "")
    ui_refresh(win)
    
    try {
        answer = rag_query(question, top_k)
        append_chat_text("🤖 AI", answer)
        set_status("✅ Answer generated")
        ui_color(status_label, "#27ae60", "")
    } catch err {
        append_chat_text("❌ Error", err)
        set_status("❌ Query failed")
        ui_color(status_label, "#e74c3c", "")
    }
}

def apply_settings() {
    api_key = trim(ui_get(api_key_entry))
    base_url = trim(ui_get(base_url_entry))
    embed_model = trim(ui_get(embed_model_entry))
    chat_model = trim(ui_get(chat_model_entry))
    chunk_size = 1000
    overlap = 200
    top_k = 5
    
    try {
        chunk_size = int(ui_get(chunk_size_entry))
        overlap = int(ui_get(overlap_entry))
        top_k = int(ui_get(top_k_entry))
    } catch err {
    }
    
    if len(base_url) == 0 or len(embed_model) == 0 or len(chat_model) == 0 {
        ui_alert_err("Base URL, Embed Model, and Chat Model cannot be empty!")
        return
    }
    
    stats = rag_get_stats()
    if stats["chunks"] > 0 {
        ui_alert_err("Clear the Knowledge Base before changing the Embedding Model!\n\nDifferent models have different vector dimensions.")
        return
    }
    
    try {
        ai_init(api_key, base_url, chat_model, embed_model)
        rag_init(chunk_size, overlap, top_k)
        
        set_status(rejoin("✅ Connected to ", base_url))
        ui_color(status_label, "#27ae60", "")
        update_stats()
        ui_alert(rejoin("Settings applied successfully!\n\nProvider: ", base_url, "\nEmbed: ", embed_model, "\nChat: ", chat_model))
    } catch err {
        set_status(rejoin("❌ Init failed: ", err))
        ui_color(status_label, "#e74c3c", "")
        ui_alert_err(rejoin("Failed to connect:\n\n", err))
    }
}

def clear_kb() {
    confirm = ui_alert("Are you sure you want to clear the Knowledge Base?\n\nThis will:\n• Remove all loaded chunks from memory\n• Delete all cached index files from disk\n\nThis cannot be undone.")
    try {
        rag_clear()
        del_result = rag_delete_cache("")
        update_stats()
        
        ui_text_set(chat_text_view, rejoin("🧠 Knowledge Base Cleared.\n\n", del_result, "\n\nUpload a new PDF to begin.\n\n"))
        set_status("Knowledge Base cleared")
        ui_color(status_label, "#27ae60", "")
    } catch err {
        ui_alert_err(rejoin("Failed to clear KB: ", err))
    }
}

# ==============================================================================
# UI HELPERS
# ==============================================================================

def append_chat_text(role, message) {
    separator = "═══════════════════════════════════════════════════════"
    new_text = rejoin("\n[", role, "]\n", message, "\n\n", separator, "\n\n")
    ui_text_append(chat_text_view, new_text)
}

def update_stats() {
    stats = rag_get_stats()
    file_info = ""
    if stats["current_file"] != "" {
        file_info = rejoin(" | ", path_file(stats["current_file"]))
    }
    ui_set(stats_label, rejoin(str(stats["chunks"]), " chunks | ", str(stats["total_pages"]), " pages", file_info))
}

def set_status(message) {
    ui_set(status_label, rejoin("  ", message))
}

def exit_app() {
    ui_close(win)
}

def show_about() {
    about_text = rejoin(
        "AnikaLang Universal RAG v3.0\n\n",
        "OpenAI-Compatible AI Architecture\n\n",
        "Works with:\n",
        "• Ollama (local, free)\n",
        "• OpenRouter (free router)\n",
        "• OpenAI (GPT-4o, etc.)\n",
        "• Groq (fast inference)\n",
        "• LM Studio (local)\n",
        "• Any OpenAI-compatible server\n\n",
        "Features:\n",
        "• Local FAISS storage\n",
        "• Per-document caching\n",
        "• Page-level citations\n",
        "• Switch providers anytime\n\n",
        "Built with AnikaLang wxPython"
    )
    ui_alert(about_text)
}

# --- FULLY RESPONSIVE RESIZE HANDLER ---
def on_resize(widget, w, h) {
    cs = ui_get_client_size(win)
    cw = cs[0]
    ch = cs[1]
    
    if cw < 1000 { cw = 1000 }
    if ch < 600 { ch = 600 }
    
    header_h = 50
    statusbar_h = 30
    
    left_w = cw * 0.21
    right_w = cw * 0.23
    center_w = cw - left_w - right_w
    content_h = ch - header_h - statusbar_h
    
    ui_pos(header_bg, 0, 0, cw, header_h)
    ui_pos(statusbar_bg, 0, ch - statusbar_h, cw, statusbar_h)
    ui_pos(left_panel, 0, header_h, left_w, content_h)
    ui_pos(center_panel, left_w, header_h, center_w, content_h)
    ui_pos(right_panel, cw - right_w, header_h, right_w, content_h)
    
    ui_pos(btn_ingest, 20, 90, left_w - 40, 40)
    ui_pos(btn_clear, 20, 140, left_w - 40, 40)
    ui_pos(chunk_size_entry, 20, 255, left_w - 40, 30)
    ui_pos(overlap_entry, 20, 325, left_w - 40, 30)
    
    ui_size(chat_text_view, center_w - 40, content_h - 120)
    ui_pos(question_text, 20, content_h - 80, center_w - 130, 45)
    ui_pos(btn_ask, center_w - 100, content_h - 80, 90, 45)
    
    ui_pos(provider_combo, 20, 50, right_w - 40, 30)
    ui_pos(api_key_entry, 20, 120, right_w - 40, 30)
    ui_pos(base_url_entry, 20, 190, right_w - 40, 30)
    ui_pos(embed_model_entry, 20, 260, right_w - 40, 30)
    ui_pos(chat_model_entry, 20, 330, right_w - 40, 30)
    ui_pos(btn_apply, 20, 375, right_w - 40, 35)
    ui_pos(top_k_entry, 20, 450, right_w - 40, 30)
    
    ui_pos(status_label, cw - 400, 15, 380, 20)
    
    ui_refresh(win)
}

# ==============================================================================
# LAUNCH
# ==============================================================================

init_app()