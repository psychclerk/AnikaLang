    ui_set(country_lbl, "Offline mode — showing sample data")
    ui_set(weather_icon_lbl, "⛅")
    ui_set(temp_lbl, "22°C")
    ui_set(condition_lbl, "Partly cloudy (demo)")
    ui_set(feels_like_lbl, "🌡️ Feels Like: 21°C")
    ui_set(humidity_lbl, "💧 Humidity: 65%")
    ui_set(wind_lbl, "💨 Wind: 12 km/h")
    ui_set(pressure_lbl, "🧭 Pressure: 1013 hPa")
    ui_set(visibility_lbl, "👁️ Visibility: 10 km")
    ui_set(last_update_lbl, rejoin("Last update: ", now(), " (demo)"))
    
    ui_listview_clear(forecast_list)
    ui_listview_insert(forecast_list, ["Today", "⛅", "Partly cloudy", "16", "22", "20%", "12"])
    ui_listview_insert(forecast_list, ["Tomorrow", "🌧️", "Light rain", "14", "19", "70%", "18"])
    ui_listview_insert(forecast_list, ["Day 3", "☀️", "Clear sky", "15", "24", "5%", "10"])
    ui_listview_insert(forecast_list, ["Day 4", "☁️", "Overcast", "13", "20", "30%", "15"])
    ui_listview_insert(forecast_list, ["Day 5", "🌦️", "Drizzle", "12", "18", "60%", "20"])
    ui_listview_insert(forecast_list, ["Day 6", "⛅", "Partly cloudy", "14", "21", "25%", "14"])
    ui_listview_insert(forecast_list, ["Day 7", "☀️", "Clear sky", "16", "25", "10%", "8"])
    
    current_city = city
}

# ==============================================================================
# HELPERS
# ==============================================================================

def set_status(msg) {
    ui_set(status_lbl, rejoin("  ", msg))
}

def url_encode(text) {
    result = replace(text, " ", "%20")
    return result
}

# ==============================================================================
# FULLY RESPONSIVE RESIZE HANDLER
# ==============================================================================

def on_resize(widget, w, h) {
    cs = ui_get_client_size(win)
    cw = cs[0]
    ch = cs[1]
    
    if cw < 700 { cw = 700 }
    if ch < 500 { ch = 500 }
    
    header_h = 60
    statusbar_h = 30
    content_h = ch - header_h - statusbar_h
    
    left_w = cw * 0.375
    right_w = cw - left_w
    
    ui_pos(header_bg, 0, 0, cw, header_h)
    ui_pos(statusbar_bg, 0, ch - statusbar_h, cw, statusbar_h)
    ui_pos(left_panel, 0, header_h, left_w, content_h)
    ui_pos(right_panel, left_w, header_h, right_w, content_h)
    
    ui_pos(clock_lbl, cw - 150, 20, 130, 25)
    ui_pos(status_lbl, 15, 5, cw - 30, 20)
    
    # Left panel children
    search_w = left_w - 40
    entry_w = search_w - 140
    if entry_w < 100 { entry_w = 100 }
    ui_pos(city_entry, 20, 45, entry_w, 32)
    ui_pos(btn_search, 20 + entry_w + 10, 45, 120, 32)
    
    half_btn = (search_w - 10) / 2
    ui_pos(btn_refresh, 20, 85, half_btn, 30)
    ui_pos(btn_fav_add, 30 + half_btn, 85, half_btn, 30)
    
    fav_w = search_w - 110
    if fav_w < 100 { fav_w = 100 }
    ui_size(fav_list, fav_w, 120)
    ui_pos(btn_fav_del, 20 + fav_w + 10, 150, 90, 120)
    
    card_y = 285
    card_h = content_h - card_y - 15
    if card_h < 200 { card_h = 200 }
    ui_pos(weather_card, 20, card_y, search_w, card_h)
    
    card_w = search_w
    half_card = card_w / 2
    
    ui_size(city_name_lbl, card_w - 30, 28)
    ui_size(country_lbl, card_w - 30, 20)
    ui_size(divider, card_w - 30, 2)
    ui_size(feels_like_lbl, half_card - 20, 25)
    ui_pos(humidity_lbl, half_card, 205, half_card - 20, 25)
    ui_size(wind_lbl, half_card - 20, 25)
    ui_pos(pressure_lbl, half_card, 235, half_card - 20, 25)
    ui_size(visibility_lbl, card_w - 30, 25)
    ui_size(last_update_lbl, card_w - 30, 25)
    
    # Right panel children
    forecast_w = right_w - 40
    forecast_h = content_h - 65
    if forecast_h < 200 { forecast_h = 200 }
    ui_pos(forecast_list, 20, 45, forecast_w, forecast_h)
    
    ui_listview_set_column_width(forecast_list, 0, forecast_w * 0.14)
    ui_listview_set_column_width(forecast_list, 1, forecast_w * 0.07)
    ui_listview_set_column_width(forecast_list, 2, forecast_w * 0.28)
    ui_listview_set_column_width(forecast_list, 3, forecast_w * 0.11)
    ui_listview_set_column_width(forecast_list, 4, forecast_w * 0.11)
    ui_listview_set_column_width(forecast_list, 5, forecast_w * 0.11)
    ui_listview_set_column_width(forecast_list, 6, forecast_w * 0.14)
    
    ui_refresh(win)
}

# ==============================================================================
# LAUNCH
# ==============================================================================

main()