current_lat = 0
current_lon = 0
refresh_timer_id = null
clock_timer_id = null
weather_data = null
favorites = []
favorites_file = ""

# ==============================================================================
# SAFE STRING HELPERS (no undefined built-ins)
# ==============================================================================

def char_at(text, i) {
    n = len(text)
    if i < 0 or i >= n { return "" }
    return left(right(text, n - i), 1)
}

def str_find(text, search) {
    tlen = len(text)
    slen = len(search)
    if slen == 0 { return 0 }
    if slen > tlen { return -1 }
    i = 0
    while i <= tlen - slen {
        sub = left(right(text, tlen - i), slen)
        if sub == search { return i }
        i = i + 1
    }
    return -1
}

def str_sub(text, start, length) {
    n = len(text)
    if start < 0 { start = 0 }
    if start >= n { return "" }
    if length <= 0 { return "" }
    if start + length > n { length = n - start }
    return left(right(text, n - start), length)
}

def str_split(text, delim) {
    result = []
    dlen = len(delim)
    if dlen == 0 {
        list_append(result, text)
        return result
    }
    remaining = text
    while true {
        idx = str_find(remaining, delim)
        if idx == -1 {
            list_append(result, remaining)
            return result
        }
        piece = str_sub(remaining, 0, idx)
        list_append(result, piece)
        remaining = str_sub(remaining, idx + dlen, len(remaining) - idx - dlen)
    }
    return result
}

# ==============================================================================
# MAIN
# ==============================================================================

def main() {
    # ✅ FIX: Use absolute path so file is always found regardless of working dir
    favorites_file = path_join(path_cwd(), "weather_favorites.txt")
    build_ui()
    load_favorites()
    start_clock()
    start_auto_refresh()
    ui_mainloop(win)
}

