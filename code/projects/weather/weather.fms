# ==============================================================================
# CLOCK & AUTO-REFRESH
# ==============================================================================

def start_clock() {
    update_clock()
}

def update_clock() {
    now_str = now()
    time_part = right(now_str, 8)
    ui_set(clock_lbl, rejoin("🕒 ", time_part))
    clock_timer_id = ui_after(1000, "update_clock")
}

def start_auto_refresh() {
    refresh_timer_id = ui_after(600000, "do_auto_refresh")
}

def do_auto_refresh() {
    if len(current_city) > 0 {
        set_status("🔄 Auto-refreshing weather...")
        fetch_weather_for_city(current_city)
    }
    refresh_timer_id = ui_after(600000, "do_auto_refresh")
}

def do_manual_refresh() {
    if len(current_city) == 0 {
        ui_alert_err("Please search for a city first!")
        return
    }
    set_status("🔄 Refreshing weather data...")
    fetch_weather_for_city(current_city)
}

# ==============================================================================
# SEARCH
# ==============================================================================

def do_search() {
    city = trim(ui_get(city_entry))
    if len(city) == 0 {
        ui_alert_err("Please enter a city name!")
        return
    }
    fetch_weather_for_city(city)
}

# ==============================================================================
# ✅ FAVORITES — PERSISTENT FILE STORAGE
# ==============================================================================

def load_favorites() {
    favorites = []
    
    # ✅ FIX: Use try/catch instead of file_exists (which may not exist)
    try {
        content = file_read(favorites_file)
        if starts_with(content, "ERROR") == false {
            # ✅ FIX: Use str_split instead of split
            lines = str_split(content, "\n")
            for line in lines {
                line = trim(line)
                if len(line) > 0 {
                    list_append(favorites, line)
                }
            }
        }
    } catch err {
        # File doesn't exist yet — that's OK, start with empty list
    }
    
    refresh_favorites_list()
    set_status(rejoin("📂 Loaded ", str(len(favorites)), " favorite cities"))
}

def save_favorites() {
    # ✅ FIX: Build content with newline-separated city names
    content = ""
    i = 0
    while i < len(favorites) {
        if i > 0 {
            content = rejoin(content, "\n")
        }
        content = rejoin(content, favorites[i])
        i = i + 1
    }
    
    # ✅ FIX: Write with error handling
    try {
        file_write(favorites_file, content)
        set_status(rejoin("💾 Saved ", str(len(favorites)), " favorites to disk"))
    } catch err {
        set_status(rejoin("❌ Failed to save favorites: ", str(err)))
    }
}

def refresh_favorites_list() {
    ui_listview_clear(fav_list)
    i = 0
    while i < len(favorites) {
        ui_listview_insert(fav_list, [favorites[i]])
        i = i + 1
    }
}

def do_add_favorite() {
    if len(current_city) == 0 {
        ui_alert_err("Search for a city first, then add to favorites.")
        return
    }
    
    # Check for duplicates (case-insensitive)
    i = 0
    while i < len(favorites) {
        if lower(favorites[i]) == lower(current_city) {
            ui_alert("City already in favorites!")
            return
        }
        i = i + 1
    }
    
    list_append(favorites, current_city)
    save_favorites()
    refresh_favorites_list()
    set_status(rejoin("⭐ Added '", current_city, "' to favorites"))
}

def do_remove_favorite() {
    selected = ui_listview_get_selected(fav_list)
    if selected == null {
        ui_alert_err("Select a favorite city to remove.")
        return
    }
    
    city_to_remove = selected[0]
    
    # Find and remove from list
    i = 0
    while i < len(favorites) {
        if favorites[i] == city_to_remove {
            list_remove(favorites, i)
            save_favorites()
            refresh_favorites_list()
            set_status(rejoin("🗑 Removed '", city_to_remove, "' from favorites"))
            return
        }
        i = i + 1
    }
}

def on_fav_select(widget) {
    selected = ui_listview_get_selected(fav_list)
    if selected == null { return }
    city = selected[0]
    ui_set(city_entry, city)
    fetch_weather_for_city(city)
}

# ==============================================================================
# WEATHER FETCHING (Open-Meteo API)
# ==============================================================================

def fetch_weather_for_city(city) {
    set_status(rejoin("🌐 Looking up '", city, "'..."))
    ui_color(status_lbl, "#f1c40f", "")
    ui_refresh(win)
    
    try {
        # Step 1: Geocode city → lat/lon
        geocode_url = rejoin("https://geocoding-api.open-meteo.com/v1/search?name=", url_encode(city), "&count=1")
        geo_response = http_get(geocode_url)
        
        if starts_with(geo_response, "ERROR") {
            set_status("⚠️ Offline — using demo data")
            load_demo_data(city)
            return
        }
        
        geo_data = json_parse(geo_response)
        if geo_data == null {
            set_status("⚠️ Geocoding failed — using demo data")
            load_demo_data(city)
            return
        }
        
        results = geo_data["results"]
        if results == null or len(results) == 0 {
            ui_alert_err(rejoin("City not found: ", city))
            set_status("❌ City not found")
            ui_color(status_lbl, "#e74c3c", "")
            return
        }
        
        lat = results[0]["latitude"]
        lon = results[0]["longitude"]
        country = results[0]["country"]
        full_name = rejoin(results[0]["name"], ", ", country)
        
        current_city = city
        current_lat = lat
        current_lon = lon
        
        # Step 2: Fetch current + forecast weather
        set_status("🌐 Fetching weather data...")
        ui_refresh(win)
        
        weather_url = rejoin("https://api.open-meteo.com/v1/forecast?latitude=", str(lat), "&longitude=", str(lon), "&current=temperature_2m,relative_humidity_2m,apparent_temperature,weather_code,wind_speed_10m,surface_pressure&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max,wind_speed_10m_max&timezone=auto&forecast_days=7")
        
        weather_response = http_get(weather_url)
        
        if starts_with(weather_response, "ERROR") {
            set_status("⚠️ Network error — using demo data")
            load_demo_data(city)
            return
        }
        
        weather_data = json_parse(weather_response)
        if weather_data == null {
            set_status("⚠️ Parse error — using demo data")
            load_demo_data(city)
            return
        }
        
        # Step 3: Update UI
        update_current_weather(weather_data, full_name)
        update_forecast(weather_data)
        
        set_status(rejoin("✅ Weather loaded for ", full_name))
        ui_color(status_lbl, "#2ecc71", "")
        
    } catch err {
        set_status("⚠️ Error — using demo data")
        ui_color(status_lbl, "#e74c3c", "")
        load_demo_data(city)
    }
}

# ==============================================================================
# UI UPDATE
# ==============================================================================

def update_current_weather(data, full_name) {
    current = data["current"]
    
    ui_set(city_name_lbl, full_name)
    ui_set(country_lbl, rejoin("Lat: ", str(current_lat), "  |  Lon: ", str(current_lon)))
    
    temp = current["temperature_2m"]
    feels = current["apparent_temperature"]
    humidity = current["relative_humidity_2m"]
    wind = current["wind_speed_10m"]
    pressure = current["surface_pressure"]
    code = current["weather_code"]
    
    info = get_weather_info(code)
    icon = info[0]
    description = info[1]
    
    ui_set(weather_icon_lbl, icon)
    ui_set(temp_lbl, rejoin(str(int(temp)), "°C"))
    ui_set(condition_lbl, description)
    ui_set(feels_like_lbl, rejoin("🌡️ Feels Like: ", str(int(feels)), "°C"))
    ui_set(humidity_lbl, rejoin("💧 Humidity: ", str(humidity), "%"))
    ui_set(wind_lbl, rejoin("💨 Wind: ", str(int(wind)), " km/h"))
    ui_set(pressure_lbl, rejoin("🧭 Pressure: ", str(int(pressure)), " hPa"))
    ui_set(visibility_lbl, "👁️ Visibility: N/A (Open-Meteo)")
    
    now_str = now()
    ui_set(last_update_lbl, rejoin("Last update: ", now_str))
}

def update_forecast(data) {
    ui_listview_clear(forecast_list)
    
    daily = data["daily"]
    times = daily["time"]
    codes = daily["weather_code"]
    max_temps = daily["temperature_2m_max"]
    min_temps = daily["temperature_2m_min"]
    rain_probs = daily["precipitation_probability_max"]
    winds = daily["wind_speed_10m_max"]
    
    i = 0
    while i < len(times) {
        date_str = times[i]
        day_name = format_day_name(date_str, i)
        code = codes[i]
        
        info = get_weather_info(code)
        icon = info[0]
        description = info[1]
        
        max_t = str(int(max_temps[i]))
        min_t = str(int(min_temps[i]))
        rain = str(rain_probs[i])
        wind = str(int(winds[i]))
        
        ui_listview_insert(forecast_list, [day_name, icon, description, min_t, max_t, rejoin(rain, "%"), wind])
        
        i = i + 1
    }
}

def format_day_name(date_str, index) {
    if index == 0 { return "Today" }
    if index == 1 { return "Tomorrow" }
    # ✅ FIX: Use str_split instead of split
    parts = str_split(date_str, "-")
    if len(parts) >= 3 {
        return rejoin(parts[2], "-", parts[1])
    }
    return date_str
}

# ==============================================================================
# WMO WEATHER CODE → ICON + DESCRIPTION
# ==============================================================================

def get_weather_info(code) {
    if code == 0 { return ["☀️", "Clear sky"] }
    if code == 1 { return ["🌤️", "Mainly clear"] }
    if code == 2 { return ["⛅", "Partly cloudy"] }
    if code == 3 { return ["☁️", "Overcast"] }
    if code == 45 { return ["🌫️", "Fog"] }
    if code == 48 { return ["🌫️", "Rime fog"] }
    if code == 51 { return ["🌦️", "Light drizzle"] }
    if code == 53 { return ["🌦️", "Moderate drizzle"] }
    if code == 55 { return ["🌦️", "Dense drizzle"] }
    if code == 61 { return ["🌧️", "Slight rain"] }
    if code == 63 { return ["🌧️", "Moderate rain"] }
    if code == 65 { return ["🌧️", "Heavy rain"] }
    if code == 71 { return ["🌨️", "Slight snow"] }
    if code == 73 { return ["🌨️", "Moderate snow"] }
    if code == 75 { return ["❄️", "Heavy snow"] }
    if code == 77 { return ["🌨️", "Snow grains"] }
    if code == 80 { return ["🌦️", "Rain showers"] }
    if code == 81 { return ["🌧️", "Moderate showers"] }
    if code == 82 { return ["⛈️", "Violent showers"] }
    if code == 95 { return ["⛈️", "Thunderstorm"] }
    if code == 96 { return ["⛈️", "Storm w/ hail"] }
    if code == 99 { return ["⛈️", "Storm w/ heavy hail"] }
    return ["🌡️", "Unknown"]
}

