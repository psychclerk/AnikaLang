mgmt_search_entry = null

# DSM tab widgets
dsm_search = null
dsm_cat_filter = null

# ==============================================================================
# DATABASE INITIALIZATION
# ==============================================================================

def init_database() {
    db = db_connect("psych_resident_logbook.db")
    
    db_execute(db, "CREATE TABLE IF NOT EXISTS entries (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        entry_date TEXT NOT NULL,
        category TEXT NOT NULL,
        patient_id TEXT,
        patient_age TEXT,
        patient_gender TEXT,
        diagnosis TEXT,
        dx_code TEXT,
        setting TEXT,
        supervisor TEXT,
        procedure TEXT,
        notes TEXT,
        outcome TEXT,
        learning_points TEXT,
        created_at TEXT DEFAULT (datetime('now','localtime')),
        updated_at TEXT DEFAULT (datetime('now','localtime'))
    )")
    
    db_execute(db, "CREATE TABLE IF NOT EXISTS supervisors (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        name TEXT UNIQUE NOT NULL,
        designation TEXT
    )")
    
    db_execute(db, "DROP TABLE IF EXISTS diagnoses")
    db_execute(db, "CREATE TABLE diagnoses (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        dx_code TEXT NOT NULL,
        name TEXT NOT NULL,
        category TEXT,
        subcategory TEXT,
        notes TEXT,
        UNIQUE(dx_code, name)
    )")
    
    count = db_query(db, "SELECT COUNT(*) as c FROM diagnoses")
    if count[0]["c"] == 0 {
        seed_dsm5_diagnoses()
    }
    
    sup_count = db_query(db, "SELECT COUNT(*) as c FROM supervisors")
    if sup_count[0]["c"] == 0 {
        db_execute(db, "INSERT OR IGNORE INTO supervisors (name, designation) VALUES ('Dr. ___________ (Unit Head)', 'Unit Head'), ('Dr. ___________ (Guide)', 'Guide'), ('Dr. ___________ (Co-Guide)', 'Co-Guide')")
    }
}

