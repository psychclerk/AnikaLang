        ui_listview_insert(dsm_list, [d["dx_code"], d["name"], d["category"]])
        i = i + 1
    }
}

def search_dsm_diagnoses() {
    search_term = trim(ui_get(dsm_search))
    cat_filter = ui_get(dsm_cat_filter)
    ui_listview_clear(dsm_list)
    sql = "SELECT * FROM diagnoses WHERE 1=1"
    if cat_filter != "All" { sql = rejoin(sql, " AND category = '", escape_sql(cat_filter), "'") }
    if len(search_term) > 0 {
        escaped = rejoin("%", escape_sql(search_term), "%")
        sql = rejoin(sql, " AND (dx_code LIKE '", escaped, "' OR name LIKE '", escaped, "')")
    }
    sql = rejoin(sql, " ORDER BY dx_code")
    diagnoses = db_query(db, sql)
    i = 0
    while i < len(diagnoses) {
