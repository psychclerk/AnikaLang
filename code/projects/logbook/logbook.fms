stats_lbl = null

# Search/Filter widgets
search_entry = null
category_filter = null
date_from = null
date_to = null

# Entry form widgets
form_entry_id = null
form_date = null
form_category = null
form_patient_id = null
form_age = null
form_gender = null
form_diagnosis = null
form_dx_code = null
form_setting = null
form_supervisor = null
form_procedure = null
form_notes = null
form_outcome = null
form_learning = null

# State
current_entry_id = null
current_mode = "new"
current_dx_id = null

# Popup references
diag_popup = null
dx_list_widget = null
dx_search_entry = null
dx_cat_combo = null
mgmt_popup = null
mgmt_list_widget = null
mgmt_code_entry = null
mgmt_name_entry = null
