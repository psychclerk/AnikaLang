    }
}

def reset_filters() {
    ui_set(search_entry, "")
    ui_set(category_filter, "ALL")
    ui_set(date_from, "")
    ui_set(date_to, "")
    refresh_entries_list()
}

def exit_app() {
    ui_close(win)
}

# ==============================================================================
# UI LAYOUT - ABSOLUTE POSITIONING (1400 x 900)
# ==============================================================================

win = ui_window("Psychiatry Resident Logbook - DSM-5", 1400, 900)

# --- HEADER (y=0, h=45) ---
header_bg = ui_panel(win, 0, 0, 1400, 45)
ui_color(header_bg, null, "#2C3E50")
header_lbl = ui_label(header_bg, "  Psychiatry Resident Logbook - DSM-5 Edition", 10, 10, 800, 25)
ui_color(header_lbl, "#FFFFFF", null)
ui_font(header_lbl, 13, "", true)
btn_exit = ui_button(header_bg, "Exit", "exit_app", 1310, 8, 80, 30)
ui_color(btn_exit, "#FFFFFF", "#7F8C8D")

# --- MAIN TABS (y=45, h=810) ---
main_tabs = ui_tabs(win, 0, 45, 1400, 810)

# ==============================================================================
# TAB 1: LOG ENTRY
# ==============================================================================
log_tab = ui_tab_add(main_tabs, "Log Entry")

# LEFT: Form Panel (x=0, y=0, w=770, h=810)
form_bg = ui_panel(log_tab, 0, 0, 770, 810)
ui_color(form_bg, null, "#F8F9FA")

# Row 1: Date + Category (y=10)
date_lbl = ui_label(form_bg, "Date:", 15, 15, 50, 25)
form_date = ui_datepicker(form_bg, 70, 12, 130, 28)
cat_form_lbl = ui_label(form_bg, "Category:", 220, 15, 70, 25)
form_category = ui_combobox(form_bg, ["OPD", "IPD Admission", "IPD Follow-up", "Emergency", "ECT", "Psychotherapy", "Liaison", "Teaching", "CME/Conference", "Journal Club", "Case Presentation", "Procedure", "On-Call"], 295, 12, 200, 28)
ui_set(form_category, "OPD")

# Row 2: Patient ID + Age + Sex (y=50)
pid_lbl = ui_label(form_bg, "Patient ID:", 15, 52, 75, 25)
form_patient_id = ui_entry(form_bg, "", 95, 50, 180, 28)
age_lbl = ui_label(form_bg, "Age:", 290, 52, 35, 25)
form_age = ui_entry(form_bg, "", 330, 50, 60, 28)
sex_lbl = ui_label(form_bg, "Sex:", 405, 52, 35, 25)
form_gender = ui_combobox(form_bg, ["Male", "Female", "Other"], 445, 50, 100, 28)
ui_set(form_gender, "Male")

# Row 3: DSM-5 Dx + Code (y=90)
dx_form_lbl = ui_label(form_bg, "DSM-5 Dx:", 15, 92, 75, 25)
form_diagnosis = ui_entry(form_bg, "", 95, 90, 400, 28)
btn_dx_pick = ui_button(form_bg, "DSM-5", "show_diagnosis_picker", 505, 90, 75, 28)
ui_color(btn_dx_pick, "#FFFFFF", "#8E44AD")
code_form_lbl = ui_label(form_bg, "Code:", 590, 92, 40, 25)
form_dx_code = ui_entry(form_bg, "", 635, 90, 120, 28)

# Row 4: Setting + Supervisor (y=130)
setting_lbl = ui_label(form_bg, "Setting:", 15, 132, 75, 25)
form_setting = ui_entry(form_bg, "", 95, 130, 320, 28)
sup_form_lbl = ui_label(form_bg, "Supervisor:", 430, 132, 80, 25)
form_supervisor = ui_entry(form_bg, "", 515, 130, 240, 28)

# Row 5: Procedure (y=170)
proc_lbl = ui_label(form_bg, "Procedure:", 15, 172, 75, 25)
form_procedure = ui_entry(form_bg, "", 95, 170, 660, 28)

# Clinical Notes (y=210)
notes_form_lbl = ui_label(form_bg, "Clinical Notes / Session Details:", 15, 208, 300, 22)
ui_font(notes_form_lbl, 10, "", true)
form_notes = ui_text(form_bg, "", 15, 232, 740, 160)

# Outcome (y=400)
outcome_form_lbl = ui_label(form_bg, "Outcome / Plan:", 15, 398, 200, 22)
ui_font(outcome_form_lbl, 10, "", true)
form_outcome = ui_text(form_bg, "", 15, 422, 740, 110)

# Learning Points (y=540)
learn_lbl = ui_label(form_bg, "Learning Points:", 15, 538, 200, 22)
ui_font(learn_lbl, 10, "", true)
form_learning = ui_text(form_bg, "", 15, 562, 740, 110)

# Action Buttons (y=685)
btn_save = ui_button(form_bg, "Save", "save_entry", 15, 685, 170, 40)
ui_color(btn_save, "#FFFFFF", "#27AE60")
ui_font(btn_save, 11, "", true)
btn_new = ui_button(form_bg, "New", "new_entry", 195, 685, 170, 40)
ui_color(btn_new, "#FFFFFF", "#3498DB")
ui_font(btn_new, 11, "", true)
btn_dup = ui_button(form_bg, "Duplicate", "duplicate_entry", 375, 685, 170, 40)
ui_color(btn_dup, "#FFFFFF", "#F39C12")
ui_font(btn_dup, 11, "", true)
btn_del = ui_button(form_bg, "Delete", "delete_entry", 555, 685, 170, 40)
ui_color(btn_del, "#FFFFFF", "#E74C3C")
ui_font(btn_del, 11, "", true)

# RIGHT: Recent Entries List (x=780, y=0, w=610, h=810)
list_bg = ui_panel(log_tab, 780, 0, 610, 810)
ui_color(list_bg, null, "#ECF0F1")

list_header = ui_label(list_bg, "  Recent Entries", 0, 0, 610, 30)
ui_color(list_header, "#FFFFFF", "#34495E")
ui_font(list_header, 12, "", true)

entries_list = ui_listview(list_bg, ["ID", "", "Date", "Category", "Patient", "DSM-5 Diagnosis"], 10, 40, 590, 760)
ui_listview_set_column_width(entries_list, 0, 1)     # Hidden ID
ui_listview_set_column_width(entries_list, 1, 50)     # Icon
ui_listview_set_column_width(entries_list, 2, 85)     # Date
ui_listview_set_column_width(entries_list, 3, 90)     # Category
ui_listview_set_column_width(entries_list, 4, 80)     # Patient
ui_listview_set_column_width(entries_list, 5, 270)    # Diagnosis
ui_bind(entries_list, "select", "on_entry_select")

# ==============================================================================
# TAB 2: BROWSE & SEARCH
# ==============================================================================
browse_tab = ui_tab_add(main_tabs, "Browse")

# Filter Row (y=0, h=45)
filter_bg = ui_panel(browse_tab, 0, 0, 1400, 45)
ui_color(filter_bg, null, "#F8F9FA")

search_lbl = ui_label(filter_bg, "Search:", 15, 10, 55, 25)
search_entry = ui_entry(filter_bg, "", 75, 8, 250, 28)
cat_filter_lbl = ui_label(filter_bg, "Category:", 340, 10, 70, 25)
category_filter = ui_combobox(filter_bg, ["ALL", "OPD", "IPD Admission", "IPD Follow-up", "Emergency", "ECT", "Psychotherapy", "Liaison", "Teaching", "CME/Conference", "Journal Club", "Case Presentation", "Procedure", "On-Call"], 415, 8, 160, 28)
ui_set(category_filter, "ALL")
from_lbl = ui_label(filter_bg, "From:", 590, 10, 40, 25)
date_from = ui_datepicker(filter_bg, 635, 8, 130, 28)
to_lbl = ui_label(filter_bg, "To:", 780, 10, 25, 25)
date_to = ui_datepicker(filter_bg, 810, 8, 130, 28)
btn_search = ui_button(filter_bg, "Search", "refresh_entries_list", 955, 8, 85, 28)
ui_color(btn_search, "#FFFFFF", "#2980B9")
btn_reset = ui_button(filter_bg, "Reset", "reset_filters", 1050, 8, 85, 28)
ui_color(btn_reset, "#FFFFFF", "#95A5A6")

# Browse List (y=50)
browse_list = ui_listview(browse_tab, ["ID", "", "Date", "Category", "Patient", "Age/Sex", "DSM-5 Diagnosis", "Code", "Supervisor"], 10, 55, 1380, 740)
ui_listview_set_column_width(browse_list, 0, 1)     # Hidden ID
ui_listview_set_column_width(browse_list, 1, 50)    # Icon
ui_listview_set_column_width(browse_list, 2, 90)    # Date
ui_listview_set_column_width(browse_list, 3, 100)   # Category
ui_listview_set_column_width(browse_list, 4, 80)    # Patient
ui_listview_set_column_width(browse_list, 5, 60)    # Age/Sex
ui_listview_set_column_width(browse_list, 6, 280)   # Diagnosis
ui_listview_set_column_width(browse_list, 7, 70)    # Code
ui_listview_set_column_width(browse_list, 8, 150)   # Supervisor
ui_bind(browse_list, "select", "on_browse_select")

# ==============================================================================
# TAB 3: REPORTS
# ==============================================================================
report_tab = ui_tab_add(main_tabs, "Reports")

# Report Button Row (y=0, h=50)
report_btn_bg = ui_panel(report_tab, 0, 0, 1400, 50)
ui_color(report_btn_bg, null, "#F8F9FA")

btn_summary = ui_button(report_btn_bg, "Generate Summary", "generate_summary_report", 15, 10, 200, 32)
ui_color(btn_summary, "#FFFFFF", "#27AE60")
btn_exp_html = ui_button(report_btn_bg, "Export HTML", "export_report", 230, 10, 150, 32)
ui_color(btn_exp_html, "#FFFFFF", "#3498DB")
btn_exp_csv = ui_button(report_btn_bg, "Export CSV", "export_csv", 395, 10, 150, 32)
ui_color(btn_exp_csv, "#FFFFFF", "#F39C12")

# HTML Viewer (y=55)
report_html = ui_htmlview(report_tab, 10, 55, 1380, 740)

# ==============================================================================
# TAB 4: DSM-5 REFERENCE
# ==============================================================================
dsm_tab = ui_tab_add(main_tabs, "DSM-5")

# DSM Header Row (y=0, h=45)
dsm_hdr_bg = ui_panel(dsm_tab, 0, 0, 1400, 45)
ui_color(dsm_hdr_bg, null, "#F8F9FA")

dsm_title = ui_label(dsm_hdr_bg, "DSM-5 Diagnosis Dictionary", 15, 10, 300, 25)
ui_font(dsm_title, 12, "", true)
btn_add_dx_hdr = ui_button(dsm_hdr_bg, "Add New", "manage_diagnoses", 900, 8, 120, 30)
ui_color(btn_add_dx_hdr, "#FFFFFF", "#27AE60")
btn_edit_dx_hdr = ui_button(dsm_hdr_bg, "Manage All", "manage_diagnoses", 1030, 8, 120, 30)
ui_color(btn_edit_dx_hdr, "#FFFFFF", "#3498DB")
btn_refresh_hdr = ui_button(dsm_hdr_bg, "Refresh", "load_dsm_diagnoses", 1160, 8, 100, 30)
ui_color(btn_refresh_hdr, "#FFFFFF", "#95A5A6")

# DSM Search Row (y=50, h=40)
dsm_srch_bg = ui_panel(dsm_tab, 0, 50, 1400, 40)
ui_color(dsm_srch_bg, null, "#ECF0F1")

dsm_search_lbl = ui_label(dsm_srch_bg, "Search:", 15, 8, 55, 25)
dsm_search = ui_entry(dsm_srch_bg, "", 75, 5, 350, 28)
dsm_cat_lbl = ui_label(dsm_srch_bg, "Category:", 440, 8, 70, 25)
dsm_cat_filter = ui_combobox(dsm_srch_bg, ["All", "Neurodevelopmental", "Psychotic", "Bipolar", "Depressive", "Anxiety", "OCD", "Trauma", "Dissociative", "Somatic", "Eating", "Sleep", "Sexual", "Gender", "Disruptive", "Substance", "Neurocognitive", "Personality", "Paraphilic"], 515, 5, 200, 28)
ui_set(dsm_cat_filter, "All")
btn_dsm_search = ui_button(dsm_srch_bg, "Search", "search_dsm_diagnoses", 730, 5, 90, 28)
ui_color(btn_dsm_search, "#FFFFFF", "#2980B9")
btn_dsm_reset = ui_button(dsm_srch_bg, "Reset", "search_dsm_diagnoses", 830, 5, 90, 28)
ui_color(btn_dsm_reset, "#FFFFFF", "#95A5A6")

# DSM List (y=95)
dsm_list = ui_listview(dsm_tab, ["Code", "Diagnosis", "Category"], 10, 95, 1380, 695)
ui_listview_set_column_width(dsm_list, 0, 100)
ui_listview_set_column_width(dsm_list, 1, 880)
ui_listview_set_column_width(dsm_list, 2, 380)

# ==============================================================================
# STATUS BAR (y=855, h=45)
# ==============================================================================
status_bg = ui_panel(win, 0, 855, 1400, 45)
ui_color(status_bg, null, "#34495E")

stats_lbl = ui_label(status_bg, "  Loading...", 0, 0, 1000, 45)
ui_color(stats_lbl, "#FFFFFF", null)

status_lbl = ui_label(status_bg, "  Ready  ", 1000, 0, 400, 45)
ui_color(status_lbl, "#ECF0F1", null)

# ==============================================================================
# INITIALIZATION
# ==============================================================================
init_database()
clear_form()
refresh_entries_list()
load_dsm_diagnoses()

ui_mainloop(win)