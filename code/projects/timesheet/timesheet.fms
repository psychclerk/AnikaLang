db_execute(db, "CREATE TABLE IF NOT EXISTS timesheet (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    title TEXT,
    category TEXT,
    start_time TEXT,
    end_time TEXT,
    duration_mins TEXT,
    notes TEXT,
    entry_date TEXT,
    created_at TEXT DEFAULT (datetime('now','localtime'))
)")

db_execute(db, "CREATE TABLE IF NOT EXISTS categories (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT UNIQUE NOT NULL,
    color TEXT DEFAULT '#3498db',
    is_active INTEGER DEFAULT 1
)")

catCount = db_query(db, "SELECT COUNT(*) as c FROM categories")
if catCount[0]["c"] == 0 {
    db_execute(db, "INSERT INTO categories (name, color) VALUES
        ('Patient Care', '#e74c3c'),
        ('UG Teaching (Clinic)', '#3498db'),
        ('PG Teaching (Clinic)', '#2980b9'),
        ('UG Lecture', '#16a085'),
        ('PG Lecture', '#27ae60'),
        ('Physiotherapy Lecture', '#f39c12'),
        ('Other Lecture', '#d35400'),
        ('Research', '#9b59b6'),
        ('Admin Work', '#34495e'),
        ('Journal Work', '#8e44ad'),
        ('CME/Conference', '#1abc9c'),
        ('Miscellaneous', '#95a5a6')")
}

