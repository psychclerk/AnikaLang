# ==============================================================================
# Helper Functions
# ==============================================================================

def escapeSql(text) {
    return replace(str(text), "'", "''")
}

def escapeHtml(text) {
    t = str(text)
    t = replace(t, "&", "&amp;")
    t = replace(t, "<", "&lt;")
    t = replace(t, ">", "&gt;")
    return t
}

def getCategoryColor(catName) {
    cats = db_query(db, "SELECT color FROM categories WHERE name = '" + escapeSql(catName) + "'")
    if len(cats) > 0 {
        return cats[0]["color"]
    }
    return "#95a5a6"
}

def parseDurationToMins(durStr) {
    if durStr == null or durStr == "" { return 0 }
    if contains(durStr, ":") {
        parts = split(durStr, ":")
        mins = (int(parts[0]) * 60) + int(parts[1])
        if int(parts[2]) >= 30 { mins = mins + 1 }
        return mins
    }
    return int(durStr)
}

def formatDuration(durStr) {
    if durStr == null or durStr == "" { return "00:00:00" }
    
    # If it's already in HH:MM:SS format (from new calc_duration)
    if contains(durStr, ":") {
        return durStr
    }
    
    # If it's a number (minutes from old data or calculated totals), convert to HH:MM:SS
    totalMins = int(durStr)
    hrs = int(totalMins / 60)
    mins = totalMins - (hrs * 60)
    
    # Pad with leading zeros
    if hrs < 10 { hStr = "0" + hrs } else { hStr = str(hrs) }
    if mins < 10 { mStr = "0" + mins } else { mStr = str(mins) }
    
    return hStr + ":" + mStr + ":00"
}

def getWeekStart(refDate) {
    parts = split(refDate, "-")
    if len(parts) < 3 { return refDate }
    y = int(parts[0])
    m = int(parts[1])
    d = int(parts[2])
    
    a = int((14 - m) / 12)
    y2 = y - a
    m2 = m + (12 * a) - 2
    dow = (d + int((31 * m2) / 12) + y2 + int(y2 / 4) - int(y2 / 100) + int(y2 / 400))
    dow = mod(dow, 7)
    
    offset = (dow + 6)
    offset = mod(offset, 7)
    monD = d - offset
    
    if monD < 1 {
        m = m - 1
        if m < 1 {
            m = 12
            y = y - 1
        }
        monD = monD + 28
    }
    
    monStr = str(y) + "-"
    if m < 10 { monStr = monStr + "0" }
    monStr = monStr + str(m) + "-"
    if monD < 10 { monStr = monStr + "0" }
    monStr = monStr + str(monD)
    
    return monStr
}

def addDays(dateStr, days) {
    parts = split(dateStr, "-")
    if len(parts) < 3 { return dateStr }
    y = int(parts[0])
    m = int(parts[1])
    d = int(parts[2]) + days
    
    daysInMonth = 31
    if m == 4 or m == 6 or m == 9 or m == 11 { daysInMonth = 30 }
    if m == 2 {
        daysInMonth = 28
        if mod(y, 4) == 0 { daysInMonth = 29 }
        if mod(y, 100) == 0 and mod(y, 400) != 0 { daysInMonth = 28 }
    }
    
    while d > daysInMonth {
        d = d - daysInMonth
        m = m + 1
        if m > 12 {
            m = 1
            y = y + 1
        }
        daysInMonth = 31
        if m == 4 or m == 6 or m == 9 or m == 11 { daysInMonth = 30 }
        if m == 2 {
            daysInMonth = 28
            if mod(y, 4) == 0 { daysInMonth = 29 }
        }
    }
    
    while d < 1 {
        m = m - 1
        if m < 1 {
            m = 12
            y = y - 1
        }
        daysInMonth = 31
        if m == 4 or m == 6 or m == 9 or m == 11 { daysInMonth = 30 }
        if m == 2 {
            daysInMonth = 28
            if mod(y, 4) == 0 { daysInMonth = 29 }
        }
        d = d + daysInMonth
    }
    
    result = str(y) + "-"
    if m < 10 { result = result + "0" }
    result = result + str(m) + "-"
    if d < 10 { result = result + "0" }
    result = result + str(d)
    return result
}

def getTotalForDate(dateStr) {
    results = db_query(db, "SELECT duration_mins FROM timesheet WHERE entry_date = '" + escapeSql(dateStr) + "'")
    totalMins = 0
    i = 0
    while i < len(results) {
        totalMins = totalMins + parseDurationToMins(results[i]["duration_mins"])
        i = i + 1
    }
    return totalMins
}

def escapeCsv(text) {
    t = str(text)
    t = replace(t, '"', '""')
    if contains(t, ",") or contains(t, '"') or contains(t, "\n") {
        t = '"' + t + '"'
    }
    return t
}

def getActiveCategoryNames() {
    cats = db_query(db, "SELECT name FROM categories WHERE is_active = 1")
    names = []
    i = 0
    while i < len(cats) {
        list_append(names, cats[i]["name"])
        i = i + 1
    }
    return names
}

# ==============================================================================
# Active Timer
# ==============================================================================

def updateTimerDisplay() {
    if activeStartTime == null {
        ui_set(statusLabel, "  No Active Task")
        ui_color(statusLabel, "#ECF0F1", "#34495E")
        return
    }
    
    elapsed = calc_duration(activeStartTime, now())
    display = "  RUNNING: " + activeCategory
    if len(trim(activeTitle)) > 0 {
        display = display + " - " + activeTitle
    }
    display = display + "  |  Elapsed: " + formatDuration(elapsed)
    
    ui_set(statusLabel, display)
    ui_color(statusLabel, "#FFFFFF", "#C0392B")
    
    timerUpdateId = ui_after(1000, "updateTimerDisplay")
}

def startTimer() {
    cat = ui_get(catCombo)
    title = trim(ui_get(titleEntry))
    
    if cat == "" or cat == "Select Category..." {
        ui_alert_err("Please select a category first")
        return
    }
    
    if activeStartTime != null {
        ui_alert_err("A timer is already running. Stop it first.")
        return
    }
    
    activeStartTime = now()
    activeCategory = cat
    activeTitle = title
    
    ui_button_set_state(btnStart, "disabled")
    ui_button_set_state(btnStop, "normal")
    
    updateTimerDisplay()
}

def stopTimer() {
    if activeStartTime == null {
        ui_alert_err("No active timer to stop")
        return
    }
    
    activeEndTime = now()
    duration = calc_duration(activeStartTime, activeEndTime)

    todayDate = date()
    
    sql = "INSERT INTO timesheet (title, category, start_time, end_time, duration_mins, notes, entry_date) VALUES ('"
    sql = sql + escapeSql(activeTitle) + "', '"
    sql = sql + escapeSql(activeCategory) + "', '"
    sql = sql + escapeSql(activeStartTime) + "', '"
    sql = sql + escapeSql(activeEndTime) + "', '"
    sql = sql + escapeSql(duration) + "', '', '"
    sql = sql + escapeSql(todayDate) + "')"
    db_execute(db, sql)
    
    activeStartTime = null
    activeCategory = null
    activeTitle = null
    
    ui_button_set_state(btnStart, "normal")
    ui_button_set_state(btnStop, "disabled")
    
    updateTimerDisplay()
    loadTodayEntries()
}

# ==============================================================================
# Today Tab
# ==============================================================================

def loadTodayEntries() {
    ui_listview_clear(entryList)
    
    viewDate = currentViewDate
    if viewDate == null { viewDate = date() }
    
    results = db_query(db, "SELECT id, title, category, start_time, end_time, duration_mins, notes FROM timesheet WHERE entry_date='" + escapeSql(viewDate) + "' ORDER BY start_time ASC")
    
    totalMins = 0
    i = 0
    while i < len(results) {
        row = results[i]
        dur = row["duration_mins"]
        totalMins = totalMins + parseDurationToMins(dur)
        
        titleDisp = row["title"]
        if titleDisp == null or titleDisp == "" { titleDisp = "-" }
        
        endDisp = to_indian_datetime(row["end_time"])
        if row["end_time"] == null or row["end_time"] == "" { endDisp = "Running..." }
        
        ui_listview_insert(entryList, [str(row["id"]), titleDisp, row["category"], to_indian_datetime(row["start_time"]), endDisp, formatDuration(dur), row["notes"]])
        i = i + 1
    }
    
    totalText = "Total for " + to_indian_date(viewDate) + ": " + formatDuration(totalMins) + " (" + str(len(results)) + " entries)"
    ui_set(todayTotalLbl, "  " + totalText)
    ui_set(todayDateLbl, "  " + to_indian_date(viewDate))
}

def viewPreviousDay() {
    if currentViewDate == null { currentViewDate = date() }
    currentViewDate = addDays(currentViewDate, -1)
    loadTodayEntries()
}

def viewNextDay() {
    if currentViewDate == null { currentViewDate = date() }
    currentViewDate = addDays(currentViewDate, 1)
    loadTodayEntries()
}

def viewToday() {
    currentViewDate = date()
    loadTodayEntries()
}

def pickViewDate() {
    if datePopup != null { ui_close(datePopup) }
    
    datePopup = ui_popup("Select Date", 400, 220)
    
    header = ui_label(datePopup, "  Select a date to view", 0, 0, 380, 35)
    ui_color(header, "#FFFFFF", "#3498DB")
    ui_font(header, 11, "", true)
    
    datePickWidget = ui_datepicker(datePopup, 20, 50, 340, 28)
    if currentViewDate != null {
        ui_set(datePickWidget, currentViewDate)
    }
    
    btnLoad = ui_button(datePopup, "Load", "confirmViewDate", 20, 100, 165, 40)
    ui_color(btnLoad, "#FFFFFF", "#27AE60")
    btnCancel = ui_button(datePopup, "Cancel", "closeDatePopup", 195, 100, 165, 40)
    ui_color(btnCancel, "#FFFFFF", "#95A5A6")
}

def confirmViewDate() {
    picked = ui_get(datePickWidget)
    if len(picked) > 0 {
        currentViewDate = picked
        loadTodayEntries()
    }
    if datePopup != null {
        ui_close(datePopup)
        datePopup = null
    }
}

def closeDatePopup() {
    if datePopup != null {
        ui_close(datePopup)
        datePopup = null
    }
}

def onEntryDoubleClick(widget) {
    selected = ui_listview_get_selected(entryList)
    if selected != null {
        editingEntryId = int(selected[0])
        openEditPopup()
    }
}

