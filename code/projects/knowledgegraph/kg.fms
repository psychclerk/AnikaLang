# ==============================================================================
# ACTIONS
# ==============================================================================

def do_add_files() {
    file_path = ui_file_open(null)
    if file_path == "" or file_path == null { return }
    
    if ends_with(lower(file_path), ".fms") == false {
        ui_alert_err("Please select .fms files only!")
        return
    }
    
    if contains(files_to_process, file_path) {
        ui_alert("File already in list!")
        return
    }
    
    list_append(files_to_process, file_path)
    refresh_file_list()
    set_status(rejoin("➕ Added: ", path_file(file_path)))
}

def do_clear_files() {
    files_to_process = []
    ui_listview_clear(file_list_view)
    set_status("🗑 File list cleared")
}

def do_scan() {
    if len(files_to_process) == 0 {
        ui_alert_err("No files to analyze! Add some .fms files first.")
        return
    }
    
    set_status("⏳ Building knowledge graph...")
    ui_color(status_label, "#f39c12", "")
    ui_refresh(win)
    
    try {
        graph_nodes = []
        graph_edges = []
        node_types = []
        node_files = []
        
        processed = 0
        for f in files_to_process {
            process_file(f)
            processed = processed + 1
        }
        
        refresh_tree()
        refresh_details()
        update_stats()
        
        set_status(rejoin("✅ Analyzed ", str(processed), " files"))
        ui_color(status_label, "#27ae60", "")
        ui_alert(rejoin("Knowledge graph built successfully!\n\nFiles: ", str(processed), "\nNodes: ", str(len(graph_nodes)), "\nEdges: ", str(len(graph_edges))))
        
    } catch err {
        set_status(rejoin("❌ Error: ", err))
        ui_color(status_label, "#e74c3c", "")
        ui_alert_err(rejoin("Failed to build graph:\n\n", err))
    }
}

def do_clear() {
    graph_nodes = []
    graph_edges = []
    node_types = []
    node_files = []
    
    ui_tree_clear(tree_view)
    ui_text_set(details_view, "Graph cleared. Add files and build the graph to see results.")
    ui_set(stats_label, "Nodes: 0  |  Edges: 0")
    set_status("🗑 Graph cleared")
    ui_color(status_label, "#8b949e", "")
}

def do_export() {
    if len(graph_nodes) == 0 {
        ui_alert_err("No graph to export! Build the graph first.")
        return
    }
    
    save_path = ui_file_save(null)
    if save_path == "" or save_path == null { return }
    
    if ends_with(lower(save_path), ".txt") == false {
        save_path = rejoin(save_path, ".txt")
    }
    
    try {
        output = build_text_export()
        file_write(save_path, output)
        set_status(rejoin("💾 Exported to: ", path_file(save_path)))
        ui_color(status_label, "#27ae60", "")
        ui_alert(rejoin("Graph exported successfully!\n\n", save_path))
    } catch err {
        ui_alert_err(rejoin("Failed to export:\n\n", err))
    }
}

# ==============================================================================
# FILE LIST MANAGEMENT
# ==============================================================================

def refresh_file_list() {
    ui_listview_clear(file_list_view)
    for f in files_to_process {
        ui_listview_insert(file_list_view, [path_file(f)])
    }
}

# ==============================================================================
# GRAPH BUILDING
# ==============================================================================

def process_file(file_path) {
    content = file_read(file_path)
    if starts_with(content, "ERROR") { return }
    
    file_name = path_file(file_path)
    add_node(file_name, "file", file_path)
    
    functions = extract_functions(content)
    for func in functions {
        func_name = func[0]
        func_body = func[1]
        
        add_node(func_name, "function", file_path)
        add_edge(file_name, func_name, "contains")
        
        calls = extract_calls(func_body)
        for call in calls {
            if call != func_name {
                add_edge(func_name, call, "calls")
            }
        }
        
        vars_used = extract_variables(func_body)
        for v in vars_used {
            add_node(v, "variable", file_path)
            add_edge(func_name, v, "uses")
        }
    }
}

def add_node(name, node_type, file_path) {
    i = 0
    while i < len(graph_nodes) {
        if graph_nodes[i] == name and node_types[i] == node_type {
            return
        }
        i = i + 1
    }
    list_append(graph_nodes, name)
    list_append(node_types, node_type)
    list_append(node_files, file_path)
}

def add_edge(from_node, to_node, relation) {
    i = 0
    while i < len(graph_edges) {
        edge = graph_edges[i]
        if edge[0] == from_node and edge[1] == to_node and edge[2] == relation {
            return
        }
        i = i + 1
    }
    list_append(graph_edges, [from_node, to_node, relation])
}

# ==============================================================================
# PARSING
# ==============================================================================

def extract_functions(content) {
    functions = []
    lines = str_split(content, "\n")
    i = 0
    while i < len(lines) {
        line = lines[i]
        trimmed = trim(line)
        
        if starts_with(trimmed, "def ") {
            paren_pos = str_find(trimmed, "(")
            if paren_pos > 0 {
                # "def " is 4 chars long
                name_part = str_sub(trimmed, 4, paren_pos - 4)
                func_name = trim(name_part)
                
                body = ""
                brace_count = 0
                started = false
                j = i
                while j < len(lines) {
                    body = rejoin(body, lines[j], "\n")
                    
                    k = 0
                    line_len = len(lines[j])
                    while k < line_len {
                        ch = char_at(lines[j], k)
                        if ch == "{" {
                            brace_count = brace_count + 1
                            started = true
                        }
                        if ch == "}" {
                            brace_count = brace_count - 1
                        }
                        k = k + 1
                    }
                    
                    if started and brace_count == 0 {
                        break
                    }
                    j = j + 1
                }
                
                list_append(functions, [func_name, body])
                i = j
            }
        }
        i = i + 1
    }
    return functions
}

def extract_calls(body) {
    calls = []
    words = tokenize(body)
    i = 0
    while i < len(words) {
        word = words[i]
        if i + 1 < len(words) {
            next_word = words[i + 1]
            if next_word == "(" {
                if is_keyword(word) == false {
                    if contains(calls, word) == false {
                        list_append(calls, word)
                    }
                }
            }
        }
        i = i + 1
    }
    return calls
}

def extract_variables(body) {
    vars_used = []
    words = tokenize(body)
    i = 0
    while i < len(words) {
        word = words[i]
        if i + 1 < len(words) {
            next_word = words[i + 1]
            if next_word == "=" or next_word == "[" {
                if is_keyword(word) == false {
                    if contains(vars_used, word) == false {
                        list_append(vars_used, word)
                    }
                }
            }
        }
        i = i + 1
    }
    return vars_used
}

def tokenize(text) {
    tokens = []
    current = ""
    i = 0
    n = len(text)
    while i < n {
        ch = char_at(text, i)
        if is_alnum(ch) or ch == "_" {
            current = rejoin(current, ch)
        } else {
            if len(current) > 0 {
                list_append(tokens, current)
                current = ""
            }
            if ch == "(" or ch == ")" or ch == "=" or ch == "[" or ch == "]" {
                list_append(tokens, ch)
            }
        }
        i = i + 1
    }
    if len(current) > 0 {
        list_append(tokens, current)
    }
    return tokens
}

def is_keyword(word) {
    if word == "def" { return true }
    if word == "if" { return true }
    if word == "else" { return true }
    if word == "while" { return true }
    if word == "for" { return true }
    if word == "in" { return true }
    if word == "try" { return true }
    if word == "catch" { return true }
    if word == "return" { return true }
    if word == "null" { return true }
    if word == "true" { return true }
    if word == "false" { return true }
    if word == "and" { return true }
    if word == "or" { return true }
    if word == "not" { return true }
    return false
}

def is_alnum(ch) {
    if ch == "" { return false }
    if contains("abcdefghijklmnopqrstuvwxyz", ch) { return true }
    if contains("ABCDEFGHIJKLMNOPQRSTUVWXYZ", ch) { return true }
    if contains("0123456789", ch) { return true }
    return false
}

# ==============================================================================
# DISPLAY
# ==============================================================================

def refresh_tree() {
    ui_tree_clear(tree_view)
    
    file_list = []
    i = 0
    while i < len(graph_nodes) {
        if node_types[i] == "file" {
            list_append(file_list, graph_nodes[i])
        }
        i = i + 1
    }
    
    for f in file_list {
        file_id = rejoin("file:", f)
        ui_tree_insert(tree_view, "root", file_id, rejoin("📁 ", f))
        ui_tree_expand(tree_view, file_id, true)
        
        j = 0
        while j < len(graph_nodes) {
            if node_types[j] == "function" and node_files[j] == find_file_path(f) {
                func_name = graph_nodes[j]
                func_id = rejoin("func:", func_name)
                ui_tree_insert(tree_view, file_id, func_id, rejoin("🔷 ", func_name))
                ui_tree_expand(tree_view, func_id, true)
                
                k = 0
                while k < len(graph_edges) {
                    edge = graph_edges[k]
                    if edge[0] == func_name {
                        if edge[2] == "calls" {
                            call_id = rejoin("call:", func_name, "->", edge[1])
                            ui_tree_insert(tree_view, func_id, call_id, rejoin("  → calls ", edge[1]))
                        }
                        if edge[2] == "uses" {
                            use_id = rejoin("use:", func_name, "->", edge[1])
                            ui_tree_insert(tree_view, func_id, use_id, rejoin("  • uses ", edge[1]))
                        }
                    }
                    k = k + 1
                }
            }
            j = j + 1
        }
    }
}

def find_file_path(file_name) {
    i = 0
    while i < len(graph_nodes) {
        if graph_nodes[i] == file_name and node_types[i] == "file" {
            return node_files[i]
        }
        i = i + 1
    }
    return ""
}

def refresh_details() {
    output = build_text_export()
    ui_text_set(details_view, output)
}

def build_text_export() {
    lines = []
    list_append(lines, "========================================")
    list_append(lines, "ANIKALANG KNOWLEDGE GRAPH")
    list_append(lines, "========================================")
    list_append(lines, rejoin("Nodes: ", str(len(graph_nodes))))
    list_append(lines, rejoin("Edges: ", str(len(graph_edges))))
    list_append(lines, "")
    
    list_append(lines, "--- NODES ---")
    i = 0
    while i < len(graph_nodes) {
        icon = "•"
        if node_types[i] == "file" { icon = "📁" }
        if node_types[i] == "function" { icon = "🔷" }
        if node_types[i] == "variable" { icon = "🔶" }
        list_append(lines, rejoin(icon, " ", graph_nodes[i], " [", node_types[i], "]"))
        i = i + 1
    }
    list_append(lines, "")
    
    list_append(lines, "--- RELATIONSHIPS ---")
    i = 0
    while i < len(graph_edges) {
        edge = graph_edges[i]
        list_append(lines, rejoin(edge[0], " --[", edge[2], "]--> ", edge[1]))
        i = i + 1
    }
    list_append(lines, "")
    
    list_append(lines, "--- SUMMARY ---")
    file_count = count_type("file")
    func_count = count_type("function")
    var_count = count_type("variable")
    list_append(lines, rejoin("Files: ", str(file_count)))
    list_append(lines, rejoin("Functions: ", str(func_count)))
    list_append(lines, rejoin("Variables: ", str(var_count)))
    list_append(lines, rejoin("Function Calls: ", str(count_relation("calls"))))
    list_append(lines, rejoin("Variable Uses: ", str(count_relation("uses"))))
    list_append(lines, rejoin("File Contains: ", str(count_relation("contains"))))
    
    result = ""
    for line in lines {
        result = rejoin(result, line, "\n")
    }
    return result
}

def count_type(node_type) {
    count = 0
    i = 0
    while i < len(node_types) {
        if node_types[i] == node_type {
            count = count + 1
        }
        i = i + 1
    }
    return count
}

def count_relation(relation) {
    count = 0
    i = 0
    while i < len(graph_edges) {
        if graph_edges[i][2] == relation {
            count = count + 1
        }
        i = i + 1
    }
    return count
}

def update_stats() {
    ui_set(stats_label, rejoin("Nodes: ", str(len(graph_nodes)), "  |  Edges: ", str(len(graph_edges))))
}

def set_status(message) {
    ui_set(status_label, rejoin("  ", message))
}

# ==============================================================================
# RESIZE HANDLER
# ==============================================================================

def on_resize(widget, w, h) {
    cs = ui_get_client_size(win)
    cw = cs[0]
    ch = cs[1]
    
    if cw < 1000 { cw = 1000 }
    if ch < 600 { ch = 600 }
    
    header_h = 50
    statusbar_h = 30
    left_w = 320
    right_w = 400
    center_w = cw - left_w - right_w
    content_h = ch - header_h - statusbar_h
    
    ui_pos(header_bg, 0, 0, cw, header_h)
    ui_pos(statusbar_bg, 0, ch - statusbar_h, cw, statusbar_h)
    ui_pos(left_panel, 0, header_h, left_w, content_h)
    ui_pos(center_panel, left_w, header_h, center_w, content_h)
    ui_pos(right_panel, cw - right_w, header_h, right_w, content_h)
    
    ui_size(tree_view, center_w - 40, content_h - 60)
    ui_size(details_view, right_w - 40, content_h - 60)
    
    ui_pos(status_label, cw - 500, 15, 480, 20)
    
    ui_refresh(win)
}

# ==============================================================================
# LAUNCH
# ==============================================================================

main()