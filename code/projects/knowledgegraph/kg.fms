# ==============================================================================
# ANIKALANG KNOWLEDGE GRAPH BUILDER
# Reads AnikaLang files and converts them into a knowledge graph
# ==============================================================================

# --- GLOBAL STATE ---
win = null
tree_view = null
details_view = null
status_label = null
stats_label = null
btn_add_files = null
btn_scan = null
btn_export = null
btn_clear = null
file_list_view = null

# Graph Data
graph_nodes = []
graph_edges = []
node_types = []
node_files = []
files_to_process = []

# ==============================================================================
# SAFE STRING HELPERS (built from confirmed primitives only)
# ==============================================================================

# Get a single character at index i (0-based)
def char_at(text, i) {
    n = len(text)
    if i < 0 or i >= n { return "" }
    # right(text, n - i) gives us text[i..end]
    # left(..., 1) gives us just text[i]
    return left(right(text, n - i), 1)
}

# Find index of 'search' inside 'text'. Returns -1 if not found.
def str_find(text, search) {
    tlen = len(text)
    slen = len(search)
    if slen == 0 { return 0 }
    if slen > tlen { return -1 }
    i = 0
    while i <= tlen - slen {
        # Extract substring of length slen starting at i
        sub = left(right(text, tlen - i), slen)
        if sub == search { return i }
        i = i + 1
    }
    return -1
}

# Extract substring: start index (0-based), length
def str_sub(text, start, length) {
    n = len(text)
    if start < 0 { start = 0 }
    if start >= n { return "" }
    if length <= 0 { return "" }
    if start + length > n { length = n - start }
    return left(right(text, n - start), length)
}

# Split text by delimiter into a list
def str_split(text, delim) {
    result = []
    dlen = len(delim)
    if dlen == 0 {
        list_append(result, text)
        return result
    }
    remaining = text
    while true {
        idx = str_find(remaining, delim)
        if idx == -1 {
            list_append(result, remaining)
            return result
        }
        piece = str_sub(remaining, 0, idx)
        list_append(result, piece)
        # Skip past the delimiter
        remaining = str_sub(remaining, idx + dlen, len(remaining) - idx - dlen)
    }
    return result
}

# ==============================================================================
# MAIN
# ==============================================================================

def main() {
    build_ui()
    ui_mainloop(win)
}

# ==============================================================================
# UI LAYOUT
# ==============================================================================

