# ==============================================================================
# ACTIONS
# ==============================================================================

def do_select_pdf() {
    file_path = ui_file_open(null)
    if file_path == "" or file_path == null { return }
    
    if ends_with(lower(file_path), ".pdf") == false {
        ui_alert_err("Please select a PDF file!")
        return
    }
    
    ui_set(pdf_entry, file_path)
    set_status(rejoin("📄 Selected: ", path_file(file_path)))
}

def do_convert() {
    pdf_path = trim(ui_get(pdf_entry))
    if len(pdf_path) == 0 {
        ui_alert_err("Please select a PDF file first!")
        return
    }
    
    if file_exists(pdf_path) == false {
        ui_alert_err(rejoin("File not found:\n\n", pdf_path))
        return
    }
    
    set_status("⏳ Extracting text from PDF...")
    ui_color(status_label, "#f39c12", "")
    ui_refresh(win)
    
    try {
        entities = []
        relations = []
        entity_types = []
        
        # ✅ FIX: Use RAG system to extract PDF text
        # First ingest the PDF with minimal chunking to get full text
        rag_init(5000, 0, 1)
        rag_ingest_pdf(pdf_path, 5000, 0)
        
        # Query with a broad search to get all text
        pdf_text = rag_query("extract all content", 100)
        
        if len(pdf_text) == 0 or starts_with(pdf_text, "ERROR") {
            ui_alert_err("Failed to extract text from PDF.")
            set_status("❌ Failed to read PDF")
            ui_color(status_label, "#e74c3c", "")
            return
        }
        
        set_status("💊 Extracting medications...")
        ui_refresh(win)
        extract_medications(pdf_text)
        
        set_status("🧪 Extracting neurotransmitters & receptors...")
        ui_refresh(win)
        extract_neurochemistry(pdf_text)
        
        set_status("🧠 Extracting brain regions...")
        ui_refresh(win)
        extract_brain_regions(pdf_text)
        
        set_status("🩺 Extracting disorders...")
        ui_refresh(win)
        extract_disorders(pdf_text)
        
        set_status("🤒 Extracting symptoms...")
        ui_refresh(win)
        extract_symptoms(pdf_text)
        
        set_status("🏥 Extracting therapies...")
        ui_refresh(win)
        extract_therapies(pdf_text)
        
        set_status("📋 Extracting assessment tools...")
        ui_refresh(win)
        extract_assessment_tools(pdf_text)
        
        set_status("🔗 Building clinical relationships...")
        ui_refresh(win)
        extract_clinical_relations(pdf_text)
        
        refresh_entity_list()
        refresh_relation_list()
        refresh_tree()
        refresh_details()
        update_stats()
        
        set_status(rejoin("✅ Extracted: ", str(len(entities)), " entities, ", str(len(relations)), " relations"))
        ui_color(status_label, "#27ae60", "")
        ui_alert(rejoin("Medical knowledge graph created!\n\nEntities: ", str(len(entities)), "\nRelations: ", str(len(relations))))
        
    } catch err {
        set_status(rejoin("❌ Error: ", err))
        ui_color(status_label, "#e74c3c", "")
        ui_alert_err(rejoin("Failed to process PDF:\n\n", err))
    }
}

def do_clear() {
    pdf_text = ""
    entities = []
    relations = []
    entity_types = []
    
    ui_set(pdf_entry, "")
    ui_tree_clear(tree_view)
    ui_listview_clear(entity_list)
    ui_listview_clear(relation_list)
    ui_text_set(details_view, "Select a medical PDF to begin extraction.")
    ui_set(stats_label, "Entities: 0 | Relations: 0")
    set_status("🗑 Cleared")
    ui_color(status_label, "#8b949e", "")
}

def do_export() {
    if len(entities) == 0 {
        ui_alert_err("No graph to export!")
        return
    }
    
    save_path = ui_file_save(null)
    if save_path == "" or save_path == null { return }
    
    if ends_with(lower(save_path), ".txt") == false {
        save_path = rejoin(save_path, ".txt")
    }
    
    try {
        output = build_text_export()
        file_write(save_path, output)
        set_status(rejoin("💾 Exported: ", path_file(save_path)))
        ui_color(status_label, "#27ae60", "")
        ui_alert(rejoin("Graph exported!\n\n", save_path))
    } catch err {
        ui_alert_err(rejoin("Failed to export:\n\n", err))
    }
}

# ==============================================================================
# MEDICAL ENTITY EXTRACTION
# ==============================================================================

def extract_medications(text) {
    dict_text = lower(get_psychotropics())
    drugs = str_split(dict_text, ",")
    text_lower = lower(text)
    
    for drug in drugs {
        drug = trim(drug)
        if len(drug) > 2 {
            if contains(text_lower, drug) {
                add_entity(drug, "Medication")
                extract_dosage_context(text, drug)
            }
        }
    }
    
    extract_drug_classes(text)
}

def extract_dosage_context(text, drug) {
    idx = str_find(lower(text), lower(drug))
    if idx > -1 {
        context = str_sub(text, idx, 100)
        words = tokenize(context)
        i = 0
        while i < len(words) - 1 {
            if is_number(words[i]) {
                if i + 1 < len(words) {
                    unit = lower(words[i + 1])
                    if unit == "mg" or unit == "mcg" or unit == "g" or unit == "ml" {
                        dosage = rejoin(words[i], " ", words[i + 1])
                        add_entity(dosage, "Dosage")
                        add_relation(drug, "has_dosage", dosage)
                    }
                }
            }
            i = i + 1
        }
    }
}

def extract_drug_classes(text) {
    classes = "ssri,snri,tca,maoi,atypical_antipsychotic,typical_antipsychotic,mood_stabilizer,benzodiazepine,stimulant,anticonvulsant"
    class_list = str_split(classes, ",")
    text_lower = lower(text)
    
    for cls in class_list {
        cls = trim(cls)
        if contains(text_lower, cls) {
            add_entity(cls, "DrugClass")
        }
    }
}

def extract_neurochemistry(text) {
    dict_text = lower(get_neurotransmitters())
    nts = str_split(dict_text, ",")
    text_lower = lower(text)
    
    for nt in nts {
        nt = trim(nt)
        if len(nt) > 2 {
            if contains(text_lower, nt) {
                add_entity(nt, "Neurotransmitter")
            }
        }
    }
    
    rec_text = lower(get_receptors())
    recs = str_split(rec_text, ",")
    for rec in recs {
        rec = trim(rec)
        if len(rec) > 1 {
            if contains(text_lower, rec) {
                add_entity(rec, "Receptor")
            }
        }
    }
}

def extract_brain_regions(text) {
    dict_text = lower(get_brain_regions())
    regions = str_split(dict_text, ",")
    text_lower = lower(text)
    
    for region in regions {
        region = trim(region)
        if len(region) > 3 {
            if contains(text_lower, region) {
                add_entity(region, "BrainRegion")
            }
        }
    }
}

def extract_disorders(text) {
    dict_text = lower(get_disorders())
    disorders = str_split(dict_text, ",")
    text_lower = lower(text)
    
    for disorder in disorders {
        disorder = trim(disorder)
        if len(disorder) > 3 {
            if contains(text_lower, disorder) {
                add_entity(disorder, "Disorder")
            }
        }
    }
    
    extract_diagnostic_codes(text)
}

def extract_diagnostic_codes(text) {
    words = tokenize(text)
    i = 0
    while i < len(words) - 1 {
        word = upper(words[i])
        if word == "DSM" or word == "ICD" {
            if i + 1 < len(words) {
                code = words[i + 1]
                if len(code) > 0 {
                    full_code = rejoin(word, "-", code)
                    add_entity(full_code, "DiagnosticCode")
                }
            }
        }
        i = i + 1
    }
}

def extract_symptoms(text) {
    dict_text = lower(get_symptoms())
    symptoms = str_split(dict_text, ",")
    text_lower = lower(text)
    
    for symptom in symptoms {
        symptom = trim(symptom)
        if len(symptom) > 3 {
            if contains(text_lower, symptom) {
                add_entity(symptom, "Symptom")
            }
        }
    }
}

def extract_therapies(text) {
    dict_text = lower(get_therapies())
    therapies = str_split(dict_text, ",")
    text_lower = lower(text)
    
    for therapy in therapies {
        therapy = trim(therapy)
        if len(therapy) > 3 {
            if contains(text_lower, therapy) {
                add_entity(therapy, "Therapy")
            }
        }
    }
}

def extract_assessment_tools(text) {
    dict_text = lower(get_assessment_tools())
    tools = str_split(dict_text, ",")
    text_lower = lower(text)
    
    for tool in tools {
        tool = trim(tool)
        if len(tool) > 2 {
            if contains(text_lower, tool) {
                add_entity(tool, "AssessmentTool")
            }
        }
    }
}

# ==============================================================================
# CLINICAL RELATIONSHIP EXTRACTION
# ==============================================================================

def extract_clinical_relations(text) {
    text_lower = lower(text)
    sentences = str_split(text, ".")
    
    for sentence in sentences {
        sentence_lower = lower(sentence)
        
        extract_treats_relations(sentence, sentence_lower)
        extract_mechanism_relations(sentence, sentence_lower)
        extract_symptom_relations(sentence, sentence_lower)
        extract_neuroanatomy_relations(sentence, sentence_lower)
        extract_side_effect_relations(sentence, sentence_lower)
        extract_contraindication_relations(sentence, sentence_lower)
        extract_interaction_relations(sentence, sentence_lower)
        extract_therapy_relations(sentence, sentence_lower)
        extract_assessment_relations(sentence, sentence_lower)
    }
}

def extract_treats_relations(sentence, sentence_lower) {
    drugs = get_entities_of_type("Medication")
    disorders = get_entities_of_type("Disorder")
    
    if contains(sentence_lower, "treats") or contains(sentence_lower, "indicated for") or contains(sentence_lower, "used for") or contains(sentence_lower, "effective for") or contains(sentence_lower, "first-line") {
        for drug in drugs {
            if contains(sentence_lower, lower(drug)) {
                for disorder in disorders {
                    if contains(sentence_lower, lower(disorder)) {
                        add_relation(drug, "treats", disorder)
                    }
                }
            }
        }
    }
}

def extract_mechanism_relations(sentence, sentence_lower) {
    drugs = get_entities_of_type("Medication")
    nts = get_entities_of_type("Neurotransmitter")
    recs = get_entities_of_type("Receptor")
    
    if contains(sentence_lower, "inhibits") or contains(sentence_lower, "blocks") or contains(sentence_lower, "agonist") or contains(sentence_lower, "antagonist") or contains(sentence_lower, "reuptake") or contains(sentence_lower, "binds to") or contains(sentence_lower, "activates") {
        for drug in drugs {
            if contains(sentence_lower, lower(drug)) {
                for nt in nts {
                    if contains(sentence_lower, lower(nt)) {
                        add_relation(drug, "affects", nt)
                    }
                }
                for rec in recs {
                    if contains(sentence_lower, lower(rec)) {
                        add_relation(drug, "binds_to", rec)
                    }
                }
            }
        }
    }
}

def extract_symptom_relations(sentence, sentence_lower) {
    disorders = get_entities_of_type("Disorder")
    symptoms = get_entities_of_type("Symptom")
    
    if contains(sentence_lower, "characterized by") or contains(sentence_lower, "symptoms include") or contains(sentence_lower, "presents with") or contains(sentence_lower, "manifests as") or contains(sentence_lower, "diagnostic criteria") {
        for disorder in disorders {
            if contains(sentence_lower, lower(disorder)) {
                for symptom in symptoms {
                    if contains(sentence_lower, lower(symptom)) {
                        add_relation(disorder, "has_symptom", symptom)
                    }
                }
            }
        }
    }
}

def extract_neuroanatomy_relations(sentence, sentence_lower) {
    regions = get_entities_of_type("BrainRegion")
    disorders = get_entities_of_type("Disorder")
    nts = get_entities_of_type("Neurotransmitter")
    
    if contains(sentence_lower, "located in") or contains(sentence_lower, "found in") or contains(sentence_lower, "originates in") or contains(sentence_lower, "projects to") {
        for nt in nts {
            if contains(sentence_lower, lower(nt)) {
                for region in regions {
                    if contains(sentence_lower, lower(region)) {
                        add_relation(nt, "located_in", region)
                    }
                }
            }
        }
    }
    
    if contains(sentence_lower, "associated with") or contains(sentence_lower, "implicated in") or contains(sentence_lower, "dysfunction in") {
        for region in regions {
            if contains(sentence_lower, lower(region)) {
                for disorder in disorders {
                    if contains(sentence_lower, lower(disorder)) {
                        add_relation(region, "implicated_in", disorder)
                    }
                }
            }
        }
    }
}

def extract_side_effect_relations(sentence, sentence_lower) {
    drugs = get_entities_of_type("Medication")
    symptoms = get_entities_of_type("Symptom")
    
    if contains(sentence_lower, "side effect") or contains(sentence_lower, "adverse effect") or contains(sentence_lower, "causes") or contains(sentence_lower, "may cause") or contains(sentence_lower, "associated with") {
        for drug in drugs {
            if contains(sentence_lower, lower(drug)) {
                for symptom in symptoms {
                    if contains(sentence_lower, lower(symptom)) {
                        add_relation(drug, "side_effect", symptom)
                    }
                }
            }
        }
    }
}

def extract_contraindication_relations(sentence, sentence_lower) {
    drugs = get_entities_of_type("Medication")
    disorders = get_entities_of_type("Disorder")
    
    if contains(sentence_lower, "contraindicated") or contains(sentence_lower, "avoid in") or contains(sentence_lower, "should not be used") {
        for drug in drugs {
            if contains(sentence_lower, lower(drug)) {
                for disorder in disorders {
                    if contains(sentence_lower, lower(disorder)) {
                        add_relation(drug, "contraindicated_in", disorder)
                    }
                }
            }
        }
    }
}

def extract_interaction_relations(sentence, sentence_lower) {
    drugs = get_entities_of_type("Medication")
    
    if contains(sentence_lower, "interacts with") or contains(sentence_lower, "interaction") or contains(sentence_lower, "combined with") {
        drug_list = []
        for drug in drugs {
            if contains(sentence_lower, lower(drug)) {
                list_append(drug_list, drug)
            }
        }
        
        if len(drug_list) >= 2 {
            add_relation(drug_list[0], "interacts_with", drug_list[1])
        }
    }
}

def extract_therapy_relations(sentence, sentence_lower) {
    therapies = get_entities_of_type("Therapy")
    disorders = get_entities_of_type("Disorder")
    
    if contains(sentence_lower, "effective for") or contains(sentence_lower, "treats") or contains(sentence_lower, "used for") or contains(sentence_lower, "indicated for") {
        for therapy in therapies {
            if contains(sentence_lower, lower(therapy)) {
                for disorder in disorders {
                    if contains(sentence_lower, lower(disorder)) {
                        add_relation(therapy, "treats", disorder)
                    }
                }
            }
        }
    }
}

def extract_assessment_relations(sentence, sentence_lower) {
    tools = get_entities_of_type("AssessmentTool")
    symptoms = get_entities_of_type("Symptom")
    disorders = get_entities_of_type("Disorder")
    
    if contains(sentence_lower, "measures") or contains(sentence_lower, "assesses") or contains(sentence_lower, "evaluates") or contains(sentence_lower, "screens for") {
        for tool in tools {
            if contains(sentence_lower, lower(tool)) {
                for symptom in symptoms {
                    if contains(sentence_lower, lower(symptom)) {
                        add_relation(tool, "measures", symptom)
                    }
                }
                for disorder in disorders {
                    if contains(sentence_lower, lower(disorder)) {
                        add_relation(tool, "screens_for", disorder)
                    }
                }
            }
        }
    }
}

# ==============================================================================
# ENTITY HELPERS
# ==============================================================================

def add_entity(name, entity_type) {
    name = trim(name)
    if len(name) == 0 { return }
    
    i = 0
    while i < len(entities) {
        if lower(entities[i][0]) == lower(name) and entities[i][1] == entity_type {
            return
        }
        i = i + 1
    }
    
    list_append(entities, [name, entity_type])
    list_append(entity_types, entity_type)
}

def add_relation(from_entity, relation, to_entity) {
    i = 0
    while i < len(relations) {
        r = relations[i]
        if lower(r[0]) == lower(from_entity) and r[1] == relation and lower(r[2]) == lower(to_entity) {
            return
        }
        i = i + 1
    }
    
    list_append(relations, [from_entity, relation, to_entity])
}

def get_entities_of_type(entity_type) {
    result = []
    for e in entities {
        if e[1] == entity_type {
            list_append(result, e[0])
        }
    }
    return result
}

# ==============================================================================
# UI REFRESH
# ==============================================================================

def refresh_entity_list() {
    ui_listview_clear(entity_list)
    for e in entities {
        ui_listview_insert(entity_list, [e[1], e[0]])
    }
}

def refresh_relation_list() {
    ui_listview_clear(relation_list)
    for r in relations {
        ui_listview_insert(relation_list, [r[0], r[1], r[2]])
    }
}

def refresh_tree() {
    ui_tree_clear(tree_view)
    
    categories = "Medication,DrugClass,Neurotransmitter,Receptor,BrainRegion,Disorder,DiagnosticCode,Symptom,Therapy,AssessmentTool,Dosage"
    cat_list = str_split(categories, ",")
    
    icons = "💊,💊,🧪,🧬,🧠,🩺,🔢,🤒,🏥,📋,⚖️"
    icon_list = str_split(icons, ",")
    
    c = 0
    while c < len(cat_list) {
        cat = trim(cat_list[c])
        icon = trim(icon_list[c])
        
        cat_entities = get_entities_of_type(cat)
        if len(cat_entities) > 0 {
            cat_id = rejoin("cat:", cat)
            ui_tree_insert(tree_view, "root", cat_id, rejoin(icon, " ", cat, " (", str(len(cat_entities)), ")"))
            ui_tree_expand(tree_view, cat_id, true)
            
            for ent in cat_entities {
                ent_id = rejoin("ent:", cat, ":", ent)
                ui_tree_insert(tree_view, cat_id, ent_id, rejoin("  🔷 ", ent))
                ui_tree_expand(tree_view, ent_id, true)
                
                for rel in relations {
                    if lower(rel[0]) == lower(ent) {
                        rel_id = rejoin("rel:", ent, "->", rel[2])
                        ui_tree_insert(tree_view, ent_id, rel_id, rejoin("    → ", rel[1], " → ", rel[2]))
                    }
                }
            }
        }
        c = c + 1
    }
}

def refresh_details() {
    output = build_text_export()
    ui_text_set(details_view, output)
}

def update_stats() {
    ui_set(stats_label, rejoin("Entities: ", str(len(entities)), " | Relations: ", str(len(relations))))
}

def set_status(message) {
    ui_set(status_label, rejoin("  ", message))
}

# ==============================================================================
# EXPORT
# ==============================================================================

def build_text_export() {
    lines = []
    list_append(lines, "============================================================")
    list_append(lines, "MEDICAL KNOWLEDGE GRAPH - PSYCHIATRY & NEUROSCIENCE")
    list_append(lines, "============================================================")
    list_append(lines, rejoin("Source: ", ui_get(pdf_entry)))
    list_append(lines, rejoin("Total Entities: ", str(len(entities))))
    list_append(lines, rejoin("Total Relations: ", str(len(relations))))
    list_append(lines, "")
    
    categories = "Medication,DrugClass,Neurotransmitter,Receptor,BrainRegion,Disorder,DiagnosticCode,Symptom,Therapy,AssessmentTool,Dosage"
    cat_list = str_split(categories, ",")
    
    for cat in cat_list {
        cat = trim(cat)
        cat_entities = get_entities_of_type(cat)
        if len(cat_entities) > 0 {
            list_append(lines, rejoin("--- ", upper(cat), " (", str(len(cat_entities)), ") ---"))
            for ent in cat_entities {
                list_append(lines, rejoin("  • ", ent))
            }
            list_append(lines, "")
        }
    }
    
    list_append(lines, "--- CLINICAL RELATIONSHIPS ---")
    for r in relations {
        list_append(lines, rejoin(r[0], " --[", r[1], "]--> ", r[2]))
    }
    list_append(lines, "")
    
    list_append(lines, "--- SUMMARY ---")
    list_append(lines, rejoin("Medications: ", str(len(get_entities_of_type("Medication")))))
    list_append(lines, rejoin("Disorders: ", str(len(get_entities_of_type("Disorder")))))
    list_append(lines, rejoin("Symptoms: ", str(len(get_entities_of_type("Symptom")))))
    list_append(lines, rejoin("Brain Regions: ", str(len(get_entities_of_type("BrainRegion")))))
    list_append(lines, rejoin("Neurotransmitters: ", str(len(get_entities_of_type("Neurotransmitter")))))
    list_append(lines, rejoin("Receptors: ", str(len(get_entities_of_type("Receptor")))))
    list_append(lines, rejoin("Therapies: ", str(len(get_entities_of_type("Therapy")))))
    list_append(lines, rejoin("Assessment Tools: ", str(len(get_entities_of_type("AssessmentTool")))))
    
    result = ""
    for line in lines {
        result = rejoin(result, line, "\n")
    }
    return result
}

# ==============================================================================
# STRING HELPERS
# ==============================================================================

def char_at(text, i) {
    n = len(text)
    if i < 0 or i >= n { return "" }
    return left(right(text, n - i), 1)
}

def str_sub(text, start, length) {
    n = len(text)
    if start < 0 { start = 0 }
    if start >= n { return "" }
    if length <= 0 { return "" }
    if start + length > n { length = n - start }
    return left(right(text, n - start), length)
}

def str_split(text, delim) {
    result = []
    dlen = len(delim)
    if dlen == 0 {
        list_append(result, text)
        return result
    }
    remaining = text
    while true {
        idx = str_find(remaining, delim)
        if idx == -1 {
            list_append(result, remaining)
            return result
        }
        piece = str_sub(remaining, 0, idx)
        list_append(result, piece)
        remaining = str_sub(remaining, idx + dlen, len(remaining) - idx - dlen)
    }
    return result
}

def str_find(text, search) {
    tlen = len(text)
    slen = len(search)
    if slen == 0 { return 0 }
    if slen > tlen { return -1 }
    i = 0
    while i <= tlen - slen {
        sub = left(right(text, tlen - i), slen)
        if sub == search { return i }
        i = i + 1
    }
    return -1
}

def tokenize(text) {
    tokens = []
    current = ""
    i = 0
    n = len(text)
    while i < n {
        ch = char_at(text, i)
        if is_alnum(ch) or ch == "_" or ch == "-" or ch == "." {
            current = rejoin(current, ch)
        } else {
            if len(current) > 0 {
                list_append(tokens, current)
                current = ""
            }
        }
        i = i + 1
    }
    if len(current) > 0 {
        list_append(tokens, current)
    }
    return tokens
}

def is_alnum(ch) {
    if contains("abcdefghijklmnopqrstuvwxyz", ch) { return true }
    if contains("ABCDEFGHIJKLMNOPQRSTUVWXYZ", ch) { return true }
    if contains("0123456789", ch) { return true }
    return false
}

def is_number(word) {
    if len(word) == 0 { return false }
    i = 0
    while i < len(word) {
        ch = char_at(word, i)
        if contains("0123456789.", ch) == false {
            return false
        }
        i = i + 1
    }
    return true
}

# ==============================================================================
# RESIZE HANDLER
# ==============================================================================

def on_resize(widget, w, h) {
    cs = ui_get_client_size(win)
    cw = cs[0]
    ch = cs[1]
    
    if cw < 1200 { cw = 1200 }
    if ch < 700 { ch = 700 }
    
    header_h = 50
    statusbar_h = 30
    left_w = 350
    right_w = 400
    center_w = cw - left_w - right_w
    content_h = ch - header_h - statusbar_h
    
    ui_pos(header_bg, 0, 0, cw, header_h)
    ui_pos(statusbar_bg, 0, ch - statusbar_h, cw, statusbar_h)
    ui_pos(left_panel, 0, header_h, left_w, content_h)
    ui_pos(center_panel, left_w, header_h, center_w, content_h)
    ui_pos(right_panel, cw - right_w, header_h, right_w, content_h)
    
    ui_size(tree_view, center_w - 40, content_h - 60)
    ui_size(details_view, right_w - 40, content_h - 60)
    
    ui_pos(status_label, cw - 500, 15, 480, 20)
    
    ui_refresh(win)
}

