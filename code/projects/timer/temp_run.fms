# ==============================================================================
# ANIKALANG 1.2 TIMER & CLOCK DEMO
# Demonstrates ui_after, ui_after_cancel, and absolute positioning
# Run: python main.py timer_demo.fms
# ==============================================================================

# --- GLOBAL STATE ---
clock_timer = null
stopwatch_timer = null
countdown_timer = null
periodic_timer = null

stopwatch_running = false
stopwatch_ms = 0
countdown_seconds = 0
countdown_running = false
periodic_count = 0

# --- UI REFERENCES ---
lbl_clock = null
lbl_stopwatch = null
lbl_countdown = null
lbl_periodic = null
lbl_periodic_count = null
lbl_delayed = null
lbl_laps = null
entry_countdown = null
entry_delay = null

# ==============================================================================
# MATH HELPERS
# ==============================================================================

def mod(a, b) {
    return a - int(a / b) * b
}

def is_between(val, low, high) {
    if val >= low and val <= high {
        return true
    }
    return false
}

def clamp(val, low, high) {
    if val < low { return low }
    if val > high { return high }
    return val
}

def digit_count(n) {
    return len(str(abs(n)))
}

# ==============================================================================
# 1. LIVE CLOCK (updates every second)
# ==============================================================================

def format_time_12hr(time_str) {
    hours = int(left(time_str, 2))
    mins = mid(time_str, 3, 2)
    secs = right(time_str, 2)
    
    ampm = "AM"
    if is_between(hours, 12, 23) {
        ampm = "PM"
    }
    
    hours12 = mod(hours, 12)
    if hours12 == 0 {
        hours12 = 12
    }
    
    hours_str = str(hours12)
    if hours12 < 10 {
        hours_str = rejoin("0", hours_str)
    }
    
    return rejoin(hours_str, ":", mins, ":", secs, " ", ampm)
}

def update_clock() {
    now_str = now()
    time_part = right(now_str, 8)
    
    ui_set(lbl_clock, rejoin("  ", format_time_12hr(time_part)))
    
    clock_timer = ui_after(1000, "update_clock")
}

def start_clock() {
    update_clock()
}

# ==============================================================================
# 2. STOPWATCH (start/stop/reset, updates every 10ms)
# ==============================================================================

def pad_number(num, width) {
    str_num = str(int(num))
    count = digit_count(int(num))
    padding = ""
    i = count
    while i < width {
        padding = rejoin(padding, "0")
        i = i + 1
    }
    return rejoin(padding, str_num)
}

def format_stopwatch() {
    total_ms = stopwatch_ms
    
    ms_part = mod(total_ms, 1000)
    total_secs = int(total_ms / 1000)
    secs_part = mod(total_secs, 60)
    total_mins = int(total_secs / 60)
    mins_part = mod(total_mins, 60)
    hrs_part = int(total_mins / 60)
    
    return rejoin(pad_number(hrs_part, 2), ":", pad_number(mins_part, 2), ":", pad_number(secs_part, 2), ".", pad_number(ms_part, 3))
}

def update_stopwatch() {
    if stopwatch_running == false { return }
    
    stopwatch_ms = stopwatch_ms + 10
    ui_set(lbl_stopwatch, format_stopwatch())
    
    stopwatch_timer = ui_after(10, "update_stopwatch")
}

def start_stopwatch() {
    if stopwatch_running == true { return }
    stopwatch_running = true
    update_stopwatch()
}

def stop_stopwatch() {
    stopwatch_running = false
    if stopwatch_timer != null {
        ui_after_cancel(stopwatch_timer)
        stopwatch_timer = null
    }
}

def reset_stopwatch() {
    stop_stopwatch()
    stopwatch_ms = 0
    ui_set(lbl_stopwatch, "00:00:00.000")
}

def lap_stopwatch() {
    current = format_stopwatch()
    old_text = ui_text_get(lbl_laps)
    new_text = rejoin("Lap: ", current, "\n", old_text)
    ui_text_set(lbl_laps, new_text)
}

# ==============================================================================
# 3. COUNTDOWN TIMER (user-specified seconds)
# ==============================================================================

def format_countdown() {
    total = countdown_seconds
    mins = int(total / 60)
    secs = mod(total, 60)
    
    return rejoin(pad_number(mins, 2), ":", pad_number(secs, 2))
}

def get_countdown_color() {
    if countdown_seconds <= 0 { return "#c0392b" }
    if is_between(countdown_seconds, 1, 5) { return "#c0392b" }
    if is_between(countdown_seconds, 6, 10) { return "#e67e22" }
    return "#16a085"
}

def update_countdown() {
    if countdown_running == false { return }
    
    if countdown_seconds <= 0 {
        countdown_running = false
        ui_set(lbl_countdown, "00:00")
        ui_color(lbl_countdown, "white", "#c0392b")
        ui_alert("Countdown finished!")
        return
    }
    
    ui_set(lbl_countdown, format_countdown())
    ui_color(lbl_countdown, "white", get_countdown_color())
    
    countdown_seconds = countdown_seconds - 1
    countdown_timer = ui_after(1000, "update_countdown")
}

def start_countdown() {
    if countdown_running == true { return }
    
    input_val = ui_get(entry_countdown)
    seconds = int(input_val)
    
    if seconds <= 0 {
        ui_alert_err("Enter a positive number of seconds!")
        return
    }
    
    countdown_seconds = seconds
    countdown_running = true
    ui_set(lbl_countdown, format_countdown())
    update_countdown()
}

def stop_countdown() {
    countdown_running = false
    if countdown_timer != null {
        ui_after_cancel(countdown_timer)
        countdown_timer = null
    }
    ui_color(lbl_countdown, "white", "#34495e")
}

def reset_countdown() {
    stop_countdown()
    countdown_seconds = 0
    ui_set(lbl_countdown, "00:00")
    ui_color(lbl_countdown, "white", "#34495e")
}

# ==============================================================================
# 4. PERIODIC TASK (runs every 2 seconds)
# ==============================================================================

def get_periodic_color() {
    if mod(periodic_count, 2) == 0 {
        return "#16a085"
    }
    return "#2980b9"
}

def update_periodic() {
    periodic_count = periodic_count + 1
    
    now_str = now()
    time_part = right(now_str, 8)
    
    msg = rejoin("Task #", periodic_count, " at ", time_part)
    ui_set(lbl_periodic, msg)
    ui_color(lbl_periodic, "white", get_periodic_color())
    
    ui_set(lbl_periodic_count, rejoin("Executions: ", periodic_count))
    
    periodic_timer = ui_after(2000, "update_periodic")
}

def start_periodic() {
    update_periodic()
}

def stop_periodic() {
    if periodic_timer != null {
        ui_after_cancel(periodic_timer)
        periodic_timer = null
    }
}

# ==============================================================================
# 5. DELAYED ACTION (one-shot, runs after N seconds)
# ==============================================================================

def trigger_delayed() {
    input_val = ui_get(entry_delay)
    seconds = int(input_val)
    
    seconds = clamp(seconds, 1, 3600)
    
    if seconds <= 0 {
        ui_alert_err("Enter seconds between 1 and 3600!")
        return
    }
    
    ui_set(lbl_delayed, rejoin("Scheduled in ", seconds, "s..."))
    ui_color(lbl_delayed, "white", "#e67e22")
    
    ui_after(seconds * 1000, "delayed_action")
}

def delayed_action() {
    now_str = now()
    time_part = right(now_str, 8)
    ui_set(lbl_delayed, rejoin("Triggered at ", time_part))
    ui_color(lbl_delayed, "white", "#16a085")
}

# ==============================================================================
# 6. STOP ALL / RESET ALL
# ==============================================================================

def stop_all() {
    stop_stopwatch()
    stop_countdown()
    stop_periodic()
    ui_alert("All timers stopped (clock continues)")
}

def reset_all() {
    stop_all()
    reset_stopwatch()
    reset_countdown()
    periodic_count = 0
    ui_set(lbl_periodic, "Stopped")
    ui_set(lbl_periodic_count, "Executions: 0")
    ui_set(lbl_delayed, "Idle")
    ui_color(lbl_delayed, "white", "#34495e")
}

# ==============================================================================
# PRESET HELPERS
# ==============================================================================

def set_10() { ui_set(entry_countdown, "10") }
def set_30() { ui_set(entry_countdown, "30") }
def set_60() { ui_set(entry_countdown, "60") }
def set_300() { ui_set(entry_countdown, "300") }

