    # Appointment list
    appointment_list = ui_listview(parent, ["Date", "Time", "Patient", "Type", "Status", "Duration"], 10, 55, 1360, 740)
    ui_bind(appointment_list, "DOUBLE_CLICK", "open_appointment")
    
    refresh_appointments()
}

def show_all_appointments() {
    refresh_appointments()
}

def open_appointment(widget) {
    selected = ui_listview_get_selected(appointment_list)
    if selected == null { return }
    
    appt_date = selected[0]
    appt_time = selected[1]
    patient_name = selected[2]
    
    info = rejoin(
        "Appointment Details\n\n",
        "Date: ", appt_date, "\n",
        "Time: ", appt_time, "\n",
        "Patient: ", patient_name, "\n",
        "Type: ", selected[3], "\n",
        "Status: ", selected[4], "\n",
        "Duration: ", selected[5], " minutes"
    )
    
    ui_alert(info)
}

def schedule_appointment() {
    if schedule_popup != null {
        ui_close(schedule_popup)
    }
    
    popup = ui_popup("Schedule Appointment", 550, 500)
    
    y = 15
    ui_color(ui_label(popup, "Patient:", 15, y, 200, 22), "#2c3e50", "")
    patient_combo = ui_combobox(popup, get_patient_names(), 15, y + 25, 515, 28)
    
    y = 75
    ui_color(ui_label(popup, "Date:", 15, y, 200, 22), "#2c3e50", "")
    appt_date = ui_datepicker(popup, 15, y + 25, 250, 28)
    
    ui_color(ui_label(popup, "Time:", 280, y, 200, 22), "#2c3e50", "")
    appt_time = ui_entry(popup, "09:00", 280, y + 25, 250, 28)
    
    y = 135
    ui_color(ui_label(popup, "Duration (minutes):", 15, y, 200, 22), "#2c3e50", "")
    duration_combo = ui_combobox(popup, ["30", "50", "60", "90"], 15, y + 25, 250, 28)
    ui_set(duration_combo, "50")
    
    ui_color(ui_label(popup, "Appointment Type:", 280, y, 200, 22), "#2c3e50", "")
    type_combo = ui_combobox(popup, ["Initial Evaluation", "Follow-up", "Medication Check", "Therapy", "Crisis"], 280, y + 25, 250, 28)
    
    y = 195
    ui_color(ui_label(popup, "Notes:", 15, y, 515, 22), "#2c3e50", "")
    notes_text = ui_text(popup, "", 15, y + 25, 515, 180)
    
    y = 415
    ui_color(ui_button(popup, " Schedule", "save_appointment", 15, y, 250, 40), "white", "#27ae60")
    ui_color(ui_button(popup, "Cancel", "close_popup", 280, y, 250, 40), "white", "#95a5a6")
    
    schedule_popup = popup
    schedule_data = {
        "patient": patient_combo,
        "date": appt_date,
        "time": appt_time,
        "duration": duration_combo,
        "type": type_combo,
        "notes": notes_text
    }
}

def save_appointment() {
    patient_name = ui_get(schedule_data["patient"])
    appt_date = ui_get(schedule_data["date"])
    appt_time = ui_get(schedule_data["time"])
    duration = ui_get(schedule_data["duration"])
    appt_type = ui_get(schedule_data["type"])
    notes = ui_text_get(schedule_data["notes"])
    
    if len(patient_name) == 0 or len(appt_date) == 0 or len(appt_time) == 0 {
        ui_alert_err("Please fill in patient, date, and time")
        return
    }
    
    patient_id = find_patient_id_by_name(patient_name)
    if patient_id == null {
        ui_alert_err(rejoin("Patient not found: ", patient_name))
        return
    }
    
    sql = rejoin(
        "INSERT INTO appointments (patient_id, appointment_date, appointment_time, duration_minutes, appointment_type, notes) VALUES (",
        patient_id, ", '", escape_sql(appt_date), "', '", escape_sql(appt_time), "', ", duration, ", '",
        escape_sql(appt_type), "', '", escape_sql(notes), "')"
    )
    
    try {
        db_execute(db, sql)
        ui_close(schedule_popup)
        schedule_popup = null
        refresh_appointments()
        refresh_dashboard()
        sb_set_success(rejoin("Appointment scheduled for ", patient_name))
    } catch err {
        ui_alert_err(rejoin("Failed to schedule: ", err))
    }
}

def refresh_appointments() {
    ui_listview_clear(appointment_list)
    sql = "SELECT a.appointment_date, a.appointment_time, p.first_name || ' ' || p.last_name as patient_name, a.appointment_type, a.status, a.duration_minutes FROM appointments a JOIN patients p ON a.patient_id = p.id ORDER BY a.appointment_date DESC, a.appointment_time DESC"
    appointments = db_query(db, sql)
    for appt in appointments {
        ui_listview_insert(appointment_list, [appt["appointment_date"], appt["appointment_time"], appt["patient_name"], appt["appointment_type"], appt["status"], str(appt["duration_minutes"])])
    }
}

