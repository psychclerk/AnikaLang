    note_data = {
        "patient": note_patient_combo,
        "type": note_type_combo,
        "subjective": subjective_text,
        "objective": objective_text,
        "assessment": assessment_text,
        "plan": plan_text,
        "risk": risk_text
    }
}

def clear_note() {
    ui_text_set(note_data["subjective"], "")
    ui_text_set(note_data["objective"], "")
    ui_text_set(note_data["assessment"], "")
    ui_text_set(note_data["plan"], "")
    ui_text_set(note_data["risk"], "")
}

def save_clinical_note() {
    patient_name = ui_get(note_data["patient"])
    note_type = ui_get(note_data["type"])
    subjective = ui_text_get(note_data["subjective"])
    objective = ui_text_get(note_data["objective"])
    assessment = ui_text_get(note_data["assessment"])
    plan = ui_text_get(note_data["plan"])
    risk = ui_text_get(note_data["risk"])
    
    if len(patient_name) == 0 {
        ui_alert_err("Please select a patient")
        return
    }
    
    if len(subjective) == 0 and len(objective) == 0 and len(assessment) == 0 and len(plan) == 0 {
        ui_alert_err("Please fill in at least one SOAP section")
        return
    }
    
    patient_id = find_patient_id_by_name(patient_name)
    if patient_id == null {
        ui_alert_err(rejoin("Patient not found: ", patient_name))
        return
    }
    
    sql = rejoin(
        "INSERT INTO clinical_notes (patient_id, note_type, subjective, objective, assessment, plan, risk_assessment) VALUES (",
        patient_id, ", '", escape_sql(note_type), "', '", escape_sql(subjective), "', '", escape_sql(objective),
        "', '", escape_sql(assessment), "', '", escape_sql(plan), "', '", escape_sql(risk), "')"
    )
    
    try {
        db_execute(db, sql)
        clear_note()
        refresh_dashboard()
        sb_set_success(rejoin("Clinical note saved for ", patient_name))
    } catch err {
        ui_alert_err(rejoin("Failed to save note: ", err))
    }
}

