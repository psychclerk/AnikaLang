}

def save_new_patient() {
    mrn = trim(ui_get(new_patient_data["mrn"]))
    fname = trim(ui_get(new_patient_data["fname"]))
    lname = trim(ui_get(new_patient_data["lname"]))
    dob = ui_get(new_patient_data["dob"])
    
    if len(mrn) == 0 or len(fname) == 0 or len(lname) == 0 or len(dob) == 0 {
        ui_alert_err("Please fill in all required fields (MRN, First Name, Last Name, DOB)")
        return
    }
    
    existing = db_query(db, rejoin("SELECT id FROM patients WHERE mrn = '", escape_sql(mrn), "'"))
    if len(existing) > 0 {
        ui_alert_err(rejoin("A patient with MRN '", mrn, "' already exists"))
        return
    }
    
    gender = ui_get(new_patient_data["gender"])
    phone = ui_get(new_patient_data["phone"])
    email = ui_get(new_patient_data["email"])
    address = ui_get(new_patient_data["address"])
    ec = ui_get(new_patient_data["ec"])
    ec_phone = ui_get(new_patient_data["ec_phone"])
    insurance = ui_get(new_patient_data["insurance"])
    diagnosis = ui_get(new_patient_data["diagnosis"])
    
    sql = rejoin(
        "INSERT INTO patients (mrn, first_name, last_name, dob, gender, phone, email, address, emergency_contact, emergency_phone, insurance_info, primary_diagnosis) VALUES ('",
        escape_sql(mrn), "', '", escape_sql(fname), "', '", escape_sql(lname), "', '", escape_sql(dob), "', '",
        escape_sql(gender), "', '", escape_sql(phone), "', '", escape_sql(email), "', '", escape_sql(address), "', '",
        escape_sql(ec), "', '", escape_sql(ec_phone), "', '", escape_sql(insurance), "', '", escape_sql(diagnosis), "')"
    )
    
    try {
        db_execute(db, sql)
        ui_close(new_patient_popup)
        new_patient_popup = null
        load_patient_list()
        refresh_dashboard()
        sb_set_success(rejoin("Patient ", fname, " ", lname, " added successfully"))
    } catch err {
        ui_alert_err(rejoin("Failed to save patient: ", err))
    }
}

