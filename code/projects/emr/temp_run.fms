    # Assessment
    ui_color(ui_label(parent, "  ASSESSMENT (Diagnosis, clinical impression):", 10, 380, 1370, 22), "#f39c12", "")
    ui_font(ui_label(parent, "  ASSESSMENT (Diagnosis, clinical impression):", 10, 380, 1370, 22), 10, "Segoe UI", true)
    assessment_text = ui_text(parent, "", 10, 405, 1370, 110)
    
    # Plan
    ui_color(ui_label(parent, "  PLAN (Treatment plan, follow-up, referrals):", 10, 525, 1370, 22), "#9b59b6", "")
