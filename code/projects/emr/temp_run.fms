    plan_text = ui_text(parent, "", 10, 550, 1370, 110)
    
    # Risk Assessment
    ui_color(ui_label(parent, "  RISK ASSESSMENT (Suicidal/homicidal ideation, self-harm):", 10, 670, 1370, 22), "#c0392b", "")
