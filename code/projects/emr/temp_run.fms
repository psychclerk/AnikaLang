def create_medication_management(parent) {
    # Patient selector
    ui_color(ui_label(parent, "Patient:", 10, 15, 80, 25), "#2c3e50", "")
    med_patient_combo = ui_combobox(parent, get_patient_names(), 100, 12, 500, 28)
