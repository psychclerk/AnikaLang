def load_patient_list() {
    ui_listview_clear(patient_list)
    patients = db_query(db, "SELECT mrn, first_name || ' ' || last_name as name, dob, phone FROM patients ORDER BY last_name, first_name")
    for patient in patients {
        ui_listview_insert(patient_list, [patient["mrn"], patient["name"], patient["dob"], patient["phone"]])
    }
}

def search_patients() {
    search_term = ui_get(search_entry)
    if len(trim(search_term)) == 0 {
        load_patient_list()
        return
    }
    
    ui_listview_clear(patient_list)
    pattern = rejoin("%", search_term, "%")
    sql = rejoin("SELECT mrn, first_name || ' ' || last_name as name, dob, phone FROM patients WHERE first_name LIKE '", pattern, "' OR last_name LIKE '", pattern, "' OR mrn LIKE '", pattern, "' ORDER BY last_name, first_name")
    patients = db_query(db, sql)
    for patient in patients {
        ui_listview_insert(patient_list, [patient["mrn"], patient["name"], patient["dob"], patient["phone"]])
    }
    sb_set_info(rejoin("Found ", str(len(patients)), " patient(s)"))
}

def open_patient_record(widget) {
    selected = ui_listview_get_selected(patient_list)
    if selected == null { return }
    
    mrn = selected[0]
    patient = db_query(db, rejoin("SELECT * FROM patients WHERE mrn = '", escape_sql(mrn), "'"))
    
    if len(patient) == 0 { return }
    
    p = patient[0]
    current_patient_id = p["id"]
    
    ui_set(mrn_lbl, p["mrn"])
    ui_set(name_lbl, rejoin(p["first_name"], " ", p["last_name"]))
    ui_set(dob_lbl, p["dob"])
    ui_set(phone_lbl, p["phone"])
    ui_set(diagnosis_lbl, p["primary_diagnosis"])
    
    sb_set_info(rejoin("Viewing: ", p["first_name"], " ", p["last_name"]))
}

