def create_assessment_tools(parent) {
    # Top controls
    ui_color(ui_label(parent, "Assessment Tool:", 10, 15, 130, 25), "#2c3e50", "")
    assessment_type_combo = ui_combobox(parent, ["PHQ-9 (Depression)", "GAD-7 (Anxiety)", "PCL-5 (PTSD)", "AUDIT (Alcohol)", "Columbia Suicide Severity"], 150, 12, 280, 28)
    
    ui_color(ui_button(parent, "📋 Load", "load_assessment", 440, 10, 100, 30), "white", "#f39c12")
    
    ui_color(ui_label(parent, "Patient:", 560, 15, 70, 25), "#2c3e50", "")
    assess_patient_combo = ui_combobox(parent, get_patient_names(), 640, 12, 400, 28)
    
    ui_color(ui_button(parent, "💾 Save", "save_assessment", 1060, 10, 120, 30), "white", "#27ae60")
    ui_color(ui_button(parent, "📊 History", "view_assessment_history", 1190, 10, 120, 30), "white", "#9b59b6")
    
    # Question content area
    assess_content = ui_panel(parent, 10, 50, 1370, 680)
    ui_color(assess_content, "", "#f8f9fa")
    ui_color(ui_label(assess_content, "  Select an assessment tool and click 'Load' to begin", 20, 20, 1330, 30), "#7f8c8d", "")
    
    # Score display
    score_panel = ui_panel(parent, 10, 740, 1370, 55)
    ui_color(score_panel, "", "#34495e")
    ui_color(ui_label(score_panel, "  Total Score:", 10, 15, 120, 25), "white", "#34495e")
    score_lbl = ui_label(score_panel, "0", 140, 10, 80, 35)
    ui_color(score_lbl, "#f1c40f", "#34495e")
    ui_font(score_lbl, 20, "Segoe UI", true)
    
    ui_color(ui_label(score_panel, "Interpretation:", 240, 15, 120, 25), "white", "#34495e")
    interpretation_lbl = ui_label(score_panel, "-", 370, 15, 980, 25)
    ui_color(interpretation_lbl, "white", "#34495e")
    ui_font(interpretation_lbl, 12, "Segoe UI", true)
    
    assessment_data = {
        "type": assessment_type_combo,
        "patient": assess_patient_combo,
        "content": assess_content,
        "score": score_lbl,
        "interpretation": interpretation_lbl,
        "combos": []
    }
}

def view_assessment_history() {
    patient_name = ui_get(assessment_data["patient"])
    if len(patient_name) == 0 {
        ui_alert_err("Please select a patient")
        return
    }
    
    patient_id = find_patient_id_by_name(patient_name)
    if patient_id == null { return }
    
    history = db_query(db, rejoin("SELECT assessment_date, assessment_type, score, interpretation FROM assessments WHERE patient_id = ", patient_id, " ORDER BY assessment_date DESC LIMIT 20"))
    
    report = rejoin("Assessment History for ", patient_name, "\n============================================\n\n")
    
    if len(history) == 0 {
        report = rejoin(report, "No assessments recorded.")
    } else {
        for h in history {
            report = rejoin(report, h["assessment_date"], " | ", h["assessment_type"], "\n   Score: ", str(h["score"]), " - ", h["interpretation"], "\n\n")
        }
    }
    
    ui_alert(report)
}

def load_assessment() {
    assess_type = ui_get(assessment_data["type"])
    
    # Clear existing questions
    combos = assessment_data["combos"]
    for c in combos {
        ui_destroy(c)
    }
    dict_set(assessment_data, "combos", [])
    
    handled = false
    
    if assess_type == "PHQ-9 (Depression)" {
        load_phq9()
        handled = true
    }
    if assess_type == "GAD-7 (Anxiety)" {
        load_gad7()
        handled = true
    }
    if handled == false {
        ui_alert(rejoin("Assessment template for '", assess_type, "' is not yet implemented.\n\nAvailable: PHQ-9, GAD-7"))
    }
}

def load_phq9() {
    questions = [
        "Little interest or pleasure in doing things",
        "Feeling down, depressed, or hopeless",
        "Trouble falling or staying asleep, or sleeping too much",
        "Feeling tired or having little energy",
        "Poor appetite or overeating",
        "Feeling bad about yourself - or that you are a failure",
        "Trouble concentrating on things",
        "Moving or speaking slowly, or being fidgety/restless",
        "Thoughts that you would be better off dead, or of hurting yourself"
    ]
    
    options = ["0 - Not at all", "1 - Several days", "2 - More than half the days", "3 - Nearly every day"]
    
    title_lbl = ui_label(assessment_data["content"], "  PHQ-9: Over the last 2 weeks, how often have you been bothered by:", 10, 10, 1340, 25)
    ui_color(title_lbl, "#2c3e50", "")
    ui_font(title_lbl, 11, "Segoe UI", true)
    
    i = 0
    y = 45
    while i < len(questions) {
        q_lbl = ui_label(assessment_data["content"], rejoin(str(i + 1), ". ", questions[i]), 15, y, 900, 25)
        ui_color(q_lbl, "#2c3e50", "")
        
        combo = ui_combobox(assessment_data["content"], options, 930, y - 2, 420, 28)
        
        combos = assessment_data["combos"]
        list_append(combos, combo)
        
        i = i + 1
        y = y + 35
    }
    
    hint_lbl = ui_label(assessment_data["content"], "  Scoring: 0-4 Minimal | 5-9 Mild | 10-14 Moderate | 15-19 Moderately Severe | 20-27 Severe", 15, y + 10, 1340, 22)
    ui_color(hint_lbl, "#7f8c8d", "")
    
    ui_set(score_lbl, "0")
    ui_set(assessment_data["interpretation"], "Complete the assessment to see score")
}

def load_gad7() {
    questions = [
        "Feeling nervous, anxious, or on edge",
        "Not being able to stop or control worrying",
        "Worrying too much about different things",
        "Trouble relaxing",
        "Being so restless that it's hard to sit still",
        "Becoming easily annoyed or irritable",
        "Feeling afraid, as if something awful might happen"
    ]
    
    options = ["0 - Not at all", "1 - Several days", "2 - More than half the days", "3 - Nearly every day"]
    
    title_lbl = ui_label(assessment_data["content"], "  GAD-7: Over the last 2 weeks, how often have you been bothered by:", 10, 10, 1340, 25)
    ui_color(title_lbl, "#2c3e50", "")
    ui_font(title_lbl, 11, "Segoe UI", true)
    
    i = 0
    y = 45
    while i < len(questions) {
        q_lbl = ui_label(assessment_data["content"], rejoin(str(i + 1), ". ", questions[i]), 15, y, 900, 25)
        ui_color(q_lbl, "#2c3e50", "")
        
        combo = ui_combobox(assessment_data["content"], options, 930, y - 2, 420, 28)
        
        combos = assessment_data["combos"]
        list_append(combos, combo)
        
        i = i + 1
        y = y + 35
    }
    
    hint_lbl = ui_label(assessment_data["content"], "  Scoring: 0-4 Minimal | 5-9 Mild | 10-14 Moderate | 15-21 Severe", 15, y + 10, 1340, 22)
    ui_color(hint_lbl, "#7f8c8d", "")
    
    ui_set(score_lbl, "0")
    ui_set(assessment_data["interpretation"], "Complete the assessment to see score")
}

def compute_assessment_score() {
    combos = assessment_data["combos"]
    total = 0
    answered = 0
    
    for c in combos {
        val = ui_get(c)
        if len(val) > 0 {
            first_char = left(val, 1)
            try {
                num = int(first_char)
                total = total + num
                answered = answered + 1
            } catch e {
                # Skip non-numeric
            }
        }
    }
    
    return total
}

def get_phq9_interpretation(score) {
    if score <= 4 { return "Minimal depression" }
    if score <= 9 { return "Mild depression" }
    if score <= 14 { return "Moderate depression" }
    if score <= 19 { return "Moderately severe depression" }
    return "Severe depression"
}

def get_gad7_interpretation(score) {
    if score <= 4 { return "Minimal anxiety" }
    if score <= 9 { return "Mild anxiety" }
    if score <= 14 { return "Moderate anxiety" }
    return "Severe anxiety"
}

def save_assessment() {
    patient_name = ui_get(assessment_data["patient"])
    assess_type = ui_get(assessment_data["type"])
    
    if len(patient_name) == 0 {
        ui_alert_err("Please select a patient")
        return
    }
    
    patient_id = find_patient_id_by_name(patient_name)
    if patient_id == null {
        ui_alert_err(rejoin("Patient not found: ", patient_name))
        return
    }
    
    score = compute_assessment_score()
    
    # Determine interpretation using default + override pattern
    interpretation = rejoin("Score: ", str(score))
    if assess_type == "PHQ-9 (Depression)" {
        interpretation = get_phq9_interpretation(score)
    }
    if assess_type == "GAD-7 (Anxiety)" {
        interpretation = get_gad7_interpretation(score)
    }
    
    ui_set(score_lbl, str(score))
    ui_set(assessment_data["interpretation"], interpretation)
    
    sql = rejoin(
        "INSERT INTO assessments (patient_id, assessment_type, score, interpretation) VALUES (",
        patient_id, ", '", escape_sql(assess_type), "', ", score, ", '", escape_sql(interpretation), "')"
    )
    
    try {
        db_execute(db, sql)
        refresh_dashboard()
        sb_set_success(rejoin("Assessment saved: ", assess_type, " - Score ", str(score), " (", interpretation, ")"))
    } catch err {
        ui_alert_err(rejoin("Failed to save assessment: ", err))
    }
}

