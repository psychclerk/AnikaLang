def refresh_dashboard() {
    today = date()
    
    today_appts = db_query(db, rejoin("SELECT COUNT(*) as count FROM appointments WHERE appointment_date = '", today, "'"))
    total_patients = db_query(db, "SELECT COUNT(*) as count FROM patients")
    active_meds = db_query(db, "SELECT COUNT(*) as count FROM medications WHERE status = 'Active'")
    scheduled_today = db_query(db, rejoin("SELECT COUNT(*) as count FROM appointments WHERE appointment_date = '", today, "' AND status = 'Scheduled'"))
    
    if len(today_appts) > 0 { ui_set(today_count_lbl, str(today_appts[0]["count"])) }
    if len(total_patients) > 0 { ui_set(patient_count_lbl, str(total_patients[0]["count"])) }
    if len(active_meds) > 0 { ui_set(pending_lbl, str(active_meds[0]["count"])) }
    if len(scheduled_today) > 0 { ui_set(meds_lbl, str(scheduled_today[0]["count"])) }
    
    # Recent activity
    ui_listview_clear(activity_list)
    recent = db_query(db, "SELECT cn.note_date, p.first_name || ' ' || p.last_name as patient_name, cn.note_type FROM clinical_notes cn JOIN patients p ON cn.patient_id = p.id ORDER BY cn.created_date DESC LIMIT 15")
    for note in recent {
        ui_listview_insert(activity_list, [note["note_date"], note["patient_name"], "Progress Note", note["note_type"]])
    }
    
    recent_assess = db_query(db, "SELECT a.assessment_date, p.first_name || ' ' || p.last_name as patient_name, a.assessment_type, a.score FROM assessments a JOIN patients p ON a.patient_id = p.id ORDER BY a.assessment_date DESC LIMIT 10")
    for a in recent_assess {
        ui_listview_insert(activity_list, [a["assessment_date"], a["patient_name"], rejoin("Assessment: ", str(a["score"])), a["assessment_type"]])
    }
    
    sb_set_info("Dashboard refreshed")
}

