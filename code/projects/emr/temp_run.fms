def create_main_window() {
    win = ui_window("Psychiatry EMR - Professional Edition", 1400, 1000)
    
    # === MENU BAR ===
    menubar = ui_menu(win)
    
    file_menu = ui_menu_add(menubar, "File")
    ui_menu_item(file_menu, "Backup Database", "backup_database")
    ui_menu_separator(file_menu)
    ui_menu_item(file_menu, "Exit", "exit_app")
    
    patient_menu = ui_menu_add(menubar, "Patient")
    ui_menu_item(patient_menu, "New Patient", "new_patient_dialog")
    ui_menu_item(patient_menu, "Patient List", "show_patients_tab")
    
    clinical_menu = ui_menu_add(menubar, "Clinical")
    ui_menu_item(clinical_menu, "New Progress Note", "show_notes_tab")
    ui_menu_item(clinical_menu, "Assessment Tools", "show_assessments_tab")
    ui_menu_item(clinical_menu, "Medication Management", "show_meds_tab")
    ui_menu_separator(clinical_menu)
    ui_menu_item(clinical_menu, "Treatment Plans", "show_plans_tab")
    
    help_menu = ui_menu_add(menubar, "Help")
    ui_menu_item(help_menu, "About", "show_about")
    
    ui_set_menu(win, menubar)
    
    # === TOOLBAR (y=0, h=40) ===
    toolbar_bg = ui_panel(win, 0, 0, 1400, 40)
    ui_color(toolbar_bg, "white", "#ecf0f1")
    
    ui_color(ui_button(toolbar_bg, " New Patient", "new_patient_dialog", 10, 5, 130, 30), "white", "#3498db")
    ui_color(ui_button(toolbar_bg, " Schedule", "schedule_appointment", 150, 5, 120, 30), "white", "#9b59b6")
    ui_color(ui_button(toolbar_bg, " Progress Note", "show_notes_tab", 280, 5, 140, 30), "white", "#e74c3c")
    ui_color(ui_button(toolbar_bg, "📊 Assessments", "show_assessments_tab", 430, 5, 130, 30), "white", "#f39c12")
    ui_color(ui_button(toolbar_bg, "💊 Medications", "show_meds_tab", 570, 5, 130, 30), "white", "#1abc9c")
    ui_color(ui_button(toolbar_bg, "📋 Treatment Plans", "show_plans_tab", 710, 5, 150, 30), "white", "#34495e")
    ui_color(ui_button(toolbar_bg, "💾 Backup", "backup_database", 870, 5, 100, 30), "white", "#7f8c8d")
    
    # === MAIN NOTEBOOK (y=40, h=830) ===
    main_notebook = ui_tabs(win, 0, 40, 1400, 830)
    
    dashboard_tab = ui_tab_add(main_notebook, "📊 Dashboard")
    create_dashboard(dashboard_tab)
    
    patient_tab = ui_tab_add(main_notebook, " Patients")
    create_patient_management(patient_tab)
    
    appointment_tab = ui_tab_add(main_notebook, " Appointments")
    create_appointment_management(appointment_tab)
    
    notes_tab = ui_tab_add(main_notebook, "📝 Clinical Notes")
    create_clinical_notes(notes_tab)
    
    assess_tab = ui_tab_add(main_notebook, "📈 Assessments")
    create_assessment_tools(assess_tab)
    
    meds_tab = ui_tab_add(main_notebook, "💊 Medications")
    create_medication_management(meds_tab)
    
    plans_tab = ui_tab_add(main_notebook, "📋 Treatment Plans")
    create_treatment_plans(plans_tab)
    
    # === STATUS BAR (y=870, h=30) ===
    statusbar_bg = ui_panel(win, 0, 870, 1400, 30)
    ui_color(statusbar_bg, "white", "#34495e")
    
    ui_color(ui_label(statusbar_bg, "  Psychiatry EMR  ", 0, 0, 180, 30), "white", "#34495e")
    sb_message = ui_label(statusbar_bg, "  Ready  ", 180, 0, 900, 30)
    ui_color(sb_message, "#ecf0f1", "#34495e")
    ui_color(ui_label(statusbar_bg, "  v1.1  ", 1300, 0, 100, 30), "white", "#34495e")
    
    ui_mainloop(win)
}

