    ui_color(ui_button(parent, "🔄 Refresh", "refresh_medications", 810, 10, 120, 30), "white", "#3498db")
    
    # Medication list
    medication_list = ui_listview(parent, ["Medication", "Dosage", "Frequency", "Start Date", "Prescriber", "Status"], 10, 50, 1370, 740)
    
    refresh_medications()
}

def refresh_medications() {
    ui_listview_clear(medication_list)
    patient_name = ui_get(med_patient_combo)
    
    if len(patient_name) == 0 {
        # Show all active medications
        meds = db_query(db, "SELECT m.medication_name, m.dosage, m.frequency, m.start_date, m.prescriber, m.status, p.first_name || ' ' || p.last_name as patient FROM medications m JOIN patients p ON m.patient_id = p.id WHERE m.status = 'Active' ORDER BY m.created_date DESC")
        for m in meds {
            ui_listview_insert(medication_list, [m["medication_name"], m["dosage"], m["frequency"], m["start_date"], m["prescriber"], m["status"]])
        }
    } else {
        patient_id = find_patient_id_by_name(patient_name)
        if patient_id != null {
            meds = db_query(db, rejoin("SELECT medication_name, dosage, frequency, start_date, prescriber, status FROM medications WHERE patient_id = ", patient_id, " ORDER BY start_date DESC"))
            for m in meds {
                ui_listview_insert(medication_list, [m["medication_name"], m["dosage"], m["frequency"], m["start_date"], m["prescriber"], m["status"]])
            }
        }
    }
}

def add_medication_dialog() {
    patient_name = ui_get(med_patient_combo)
    if len(patient_name) == 0 {
        ui_alert_err("Please select a patient first")
        return
    }
    
    if med_popup != null {
        ui_close(med_popup)
    }
    
    popup = ui_popup(rejoin("Add Medication - ", patient_name), 550, 550)
    
    y = 15
    ui_color(ui_label(popup, "Medication Name:", 15, y, 250, 22), "#2c3e50", "")
    med_name_entry = ui_entry(popup, "", 15, y + 25, 515, 28)
    
    y = 75
    ui_color(ui_label(popup, "Dosage:", 15, y, 250, 22), "#2c3e50", "")
    dosage_entry = ui_entry(popup, "e.g., 50mg", 15, y + 25, 250, 28)
    
    ui_color(ui_label(popup, "Frequency:", 280, y, 250, 22), "#2c3e50", "")
    freq_combo = ui_combobox(popup, ["Once daily", "Twice daily", "Three times daily", "Four times daily", "As needed (PRN)", "Weekly", "Monthly", "At bedtime"], 280, y + 25, 250, 28)
    
    y = 135
    ui_color(ui_label(popup, "Start Date:", 15, y, 250, 22), "#2c3e50", "")
    start_date = ui_datepicker(popup, 15, y + 25, 250, 28)
    
    ui_color(ui_label(popup, "Prescriber:", 280, y, 250, 22), "#2c3e50", "")
    prescriber_entry = ui_entry(popup, "", 280, y + 25, 250, 28)
    
    y = 195
    ui_color(ui_label(popup, "Indication:", 15, y, 515, 22), "#2c3e50", "")
    indication_entry = ui_entry(popup, "", 15, y + 25, 515, 28)
    
    y = 255
    ui_color(ui_label(popup, "Side Effects / Notes:", 15, y, 515, 22), "#2c3e50", "")
    side_effects_text = ui_text(popup, "", 15, y + 25, 515, 150)
    
    y = 445
    ui_color(ui_button(popup, "💾 Save", "save_medication", 15, y, 250, 40), "white", "#27ae60")
    ui_color(ui_button(popup, "Cancel", "close_popup", 280, y, 250, 40), "white", "#95a5a6")
    
    med_popup = popup
    med_data = {
        "patient_name": patient_name,
        "name": med_name_entry,
        "dosage": dosage_entry,
        "frequency": freq_combo,
        "start_date": start_date,
        "prescriber": prescriber_entry,
        "indication": indication_entry,
        "side_effects": side_effects_text
    }
}

def save_medication() {
    patient_name = med_data["patient_name"]
    med_name = trim(ui_get(med_data["name"]))
    dosage = ui_get(med_data["dosage"])
    frequency = ui_get(med_data["frequency"])
    start_date = ui_get(med_data["start_date"])
    prescriber = ui_get(med_data["prescriber"])
    indication = ui_get(med_data["indication"])
    side_effects = ui_text_get(med_data["side_effects"])
    
    if len(med_name) == 0 {
        ui_alert_err("Please enter medication name")
        return
    }
    
    patient_id = find_patient_id_by_name(patient_name)
    if patient_id == null {
        ui_alert_err("Patient not found")
        return
    }
    
    sql = rejoin(
        "INSERT INTO medications (patient_id, medication_name, dosage, frequency, start_date, prescriber, indication, side_effects) VALUES (",
        patient_id, ", '", escape_sql(med_name), "', '", escape_sql(dosage), "', '", escape_sql(frequency),
        "', '", escape_sql(start_date), "', '", escape_sql(prescriber), "', '", escape_sql(indication),
        "', '", escape_sql(side_effects), "')"
    )
    
    try {
        db_execute(db, sql)
        ui_close(med_popup)
        med_popup = null
        refresh_medications()
        refresh_dashboard()
        sb_set_success(rejoin("Medication added: ", med_name))
    } catch err {
        ui_alert_err(rejoin("Failed to save medication: ", err))
    }
}

# ==============================================================================
# MODULE: TREATMENT PLANS TAB
# ==============================================================================

def create_treatment_plans(parent) {
    # Patient selector
    ui_color(ui_label(parent, "Patient:", 10, 15, 80, 25), "#2c3e50", "")
    plan_patient_combo = ui_combobox(parent, get_patient_names(), 100, 12, 500, 28)
    ui_color(ui_button(parent, " New Plan", "add_plan_dialog", 620, 10, 150, 30), "white", "#34495e")
    ui_color(ui_button(parent, " Refresh", "refresh_plans", 780, 10, 120, 30), "white", "#3498db")
    
    # Plans list
    plan_list = ui_listview(parent, ["Date", "Goals", "Interventions", "Frequency", "Status"], 10, 50, 1370, 300)
    
    # Current plan details
    ui_color(ui_label(parent, "  Current Plan Details", 10, 360, 400, 25), "#2c3e50", "")
    ui_font(ui_label(parent, "  Current Plan Details", 10, 360, 400, 25), 11, "Segoe UI", true)
    
    plan_details_text = ui_text(parent, "Select a treatment plan to view details.", 10, 390, 1370, 400)
    
    refresh_plans()
}

def refresh_plans() {
    ui_listview_clear(plan_list)
    patient_name = ui_get(plan_patient_combo)
    
    if len(patient_name) == 0 {
        plans = db_query(db, "SELECT tp.plan_date, tp.goals, tp.interventions, tp.frequency, tp.status, p.first_name || ' ' || p.last_name as patient FROM treatment_plans tp JOIN patients p ON tp.patient_id = p.id ORDER BY tp.plan_date DESC LIMIT 50")
        for p in plans {
            goals_short = left(p["goals"], 60)
            ui_listview_insert(plan_list, [p["plan_date"], goals_short, left(p["interventions"], 40), p["frequency"], p["status"]])
        }
    } else {
        patient_id = find_patient_id_by_name(patient_name)
        if patient_id != null {
            plans = db_query(db, rejoin("SELECT plan_date, goals, interventions, frequency, status FROM treatment_plans WHERE patient_id = ", patient_id, " ORDER BY plan_date DESC"))
            for p in plans {
                goals_short = left(p["goals"], 60)
                ui_listview_insert(plan_list, [p["plan_date"], goals_short, left(p["interventions"], 40), p["frequency"], p["status"]])
            }
        }
    }
}

def add_plan_dialog() {
    patient_name = ui_get(plan_patient_combo)
    if len(patient_name) == 0 {
        ui_alert_err("Please select a patient first")
        return
    }
    
    if plan_popup != null {
        ui_close(plan_popup)
    }
    
    popup = ui_popup(rejoin("New Treatment Plan - ", patient_name), 600, 600)
    
    y = 15
    ui_color(ui_label(popup, "Treatment Goals:", 15, y, 570, 22), "#2c3e50", "")
    goals_text = ui_text(popup, "", 15, y + 25, 570, 100)
    
    y = 150
    ui_color(ui_label(popup, "Interventions:", 15, y, 570, 22), "#2c3e50", "")
    interventions_text = ui_text(popup, "", 15, y + 25, 570, 100)
    
    y = 285
    ui_color(ui_label(popup, "Frequency:", 15, y, 280, 22), "#2c3e50", "")
    freq_combo = ui_combobox(popup, ["Weekly", "Bi-weekly", "Monthly", "As needed"], 15, y + 25, 280, 28)
    
    ui_color(ui_label(popup, "Duration:", 305, y, 280, 22), "#2c3e50", "")
    duration_entry = ui_entry(popup, "e.g., 12 weeks", 305, y + 25, 280, 28)
    
    y = 345
    ui_color(ui_label(popup, "Progress Notes:", 15, y, 570, 22), "#2c3e50", "")
    progress_text = ui_text(popup, "", 15, y + 25, 570, 130)
    
    y = 510
    ui_color(ui_button(popup, "💾 Save Plan", "save_plan", 15, y, 280, 40), "white", "#27ae60")
    ui_color(ui_button(popup, "Cancel", "close_popup", 305, y, 280, 40), "white", "#95a5a6")
    
    plan_popup = popup
    plan_data = {
        "patient_name": patient_name,
        "goals": goals_text,
        "interventions": interventions_text,
        "frequency": freq_combo,
        "duration": duration_entry,
        "progress": progress_text
    }
}

def save_plan() {
    patient_name = plan_data["patient_name"]
    goals = ui_text_get(plan_data["goals"])
    interventions = ui_text_get(plan_data["interventions"])
    frequency = ui_get(plan_data["frequency"])
    duration = ui_get(plan_data["duration"])
    progress = ui_text_get(plan_data["progress"])
    
    if len(goals) == 0 {
        ui_alert_err("Please enter treatment goals")
        return
    }
    
    patient_id = find_patient_id_by_name(patient_name)
    if patient_id == null {
        ui_alert_err("Patient not found")
        return
    }
    
    sql = rejoin(
        "INSERT INTO treatment_plans (patient_id, goals, interventions, frequency, duration, progress_notes) VALUES (",
        patient_id, ", '", escape_sql(goals), "', '", escape_sql(interventions), "', '", escape_sql(frequency),
        "', '", escape_sql(duration), "', '", escape_sql(progress), "')"
    )
    
    try {
        db_execute(db, sql)
        ui_close(plan_popup)
        plan_popup = null
        refresh_plans()
        sb_set_success(rejoin("Treatment plan saved for ", patient_name))
    } catch err {
        ui_alert_err(rejoin("Failed to save plan: ", err))
    }
}

