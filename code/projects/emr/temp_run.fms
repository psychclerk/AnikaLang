# ==============================================================================
# MODULE: DATABASE
# ==============================================================================

def init_database() {
    db = db_connect("psychiatry_emr.db")
    
    db_execute(db, "CREATE TABLE IF NOT EXISTS patients (id INTEGER PRIMARY KEY AUTOINCREMENT, mrn TEXT UNIQUE NOT NULL, first_name TEXT NOT NULL, last_name TEXT NOT NULL, dob TEXT NOT NULL, gender TEXT, phone TEXT, email TEXT, address TEXT, emergency_contact TEXT, emergency_phone TEXT, insurance_info TEXT, primary_diagnosis TEXT, created_date TEXT DEFAULT (datetime('now')), last_visit TEXT, status TEXT DEFAULT 'Active')")
    
    db_execute(db, "CREATE TABLE IF NOT EXISTS appointments (id INTEGER PRIMARY KEY AUTOINCREMENT, patient_id INTEGER NOT NULL, appointment_date TEXT NOT NULL, appointment_time TEXT NOT NULL, duration_minutes INTEGER DEFAULT 50, appointment_type TEXT, status TEXT DEFAULT 'Scheduled', notes TEXT, created_date TEXT DEFAULT (datetime('now')), FOREIGN KEY (patient_id) REFERENCES patients(id))")
    
    db_execute(db, "CREATE TABLE IF NOT EXISTS clinical_notes (id INTEGER PRIMARY KEY AUTOINCREMENT, patient_id INTEGER NOT NULL, appointment_id INTEGER, note_date TEXT DEFAULT (datetime('now')), note_type TEXT DEFAULT 'Progress', subjective TEXT, objective TEXT, assessment TEXT, plan TEXT, risk_assessment TEXT, provider_signature TEXT, created_date TEXT DEFAULT (datetime('now')), FOREIGN KEY (patient_id) REFERENCES patients(id))")
    
    db_execute(db, "CREATE TABLE IF NOT EXISTS assessments (id INTEGER PRIMARY KEY AUTOINCREMENT, patient_id INTEGER NOT NULL, appointment_id INTEGER, assessment_date TEXT DEFAULT (datetime('now')), assessment_type TEXT NOT NULL, score INTEGER, interpretation TEXT, details TEXT, FOREIGN KEY (patient_id) REFERENCES patients(id))")
    
    db_execute(db, "CREATE TABLE IF NOT EXISTS medications (id INTEGER PRIMARY KEY AUTOINCREMENT, patient_id INTEGER NOT NULL, medication_name TEXT NOT NULL, dosage TEXT, frequency TEXT, start_date TEXT, end_date TEXT, prescriber TEXT, indication TEXT, side_effects TEXT, status TEXT DEFAULT 'Active', created_date TEXT DEFAULT (datetime('now')), FOREIGN KEY (patient_id) REFERENCES patients(id))")
    
    db_execute(db, "CREATE TABLE IF NOT EXISTS diagnoses (id INTEGER PRIMARY KEY AUTOINCREMENT, patient_id INTEGER NOT NULL, icd_code TEXT NOT NULL, diagnosis_name TEXT NOT NULL, diagnosis_date TEXT DEFAULT (datetime('now')), status TEXT DEFAULT 'Active', notes TEXT, FOREIGN KEY (patient_id) REFERENCES patients(id))")
    
    db_execute(db, "CREATE TABLE IF NOT EXISTS treatment_plans (id INTEGER PRIMARY KEY AUTOINCREMENT, patient_id INTEGER NOT NULL, plan_date TEXT DEFAULT (datetime('now')), goals TEXT, interventions TEXT, frequency TEXT, duration TEXT, progress_notes TEXT, status TEXT DEFAULT 'Active', FOREIGN KEY (patient_id) REFERENCES patients(id))")
}

# ==============================================================================
# MODULE: STATUS BAR HELPERS
# ==============================================================================

def sb_set_message(msg) {
    ui_set(sb_message, rejoin("  ", msg))
    ui_color(sb_message, "#ecf0f1", "#2d2d2d")
}

def sb_set_error(msg) {
    ui_set(sb_message, rejoin("  ⚠ ", msg))
    ui_color(sb_message, "white", "#c0392b")
}

def sb_set_success(msg) {
    ui_set(sb_message, rejoin("  ✓ ", msg))
    ui_color(sb_message, "white", "#16a085")
}

def sb_set_info(msg) {
    ui_set(sb_message, rejoin("   ", msg))
    ui_color(sb_message, "white", "#2980b9")
}

# ==============================================================================
# MODULE: UTILITY FUNCTIONS
# ==============================================================================

def escape_sql(text) {
    return replace(str(text), "'", "''")
}

def get_patient_names() {
    patients = db_query(db, "SELECT first_name || ' ' || last_name as name FROM patients ORDER BY last_name")
    names = []
    for p in patients {
        list_append(names, p["name"])
    }
    return names
}

def find_patient_id_by_name(full_name) {
    parts = split(full_name, " ")
    if len(parts) < 2 { return null }
    
    first = parts[0]
    last = parts[len(parts) - 1]
    
    result = db_query(db, rejoin("SELECT id FROM patients WHERE first_name = '", escape_sql(first), "' AND last_name = '", escape_sql(last), "'"))
    if len(result) == 0 { return null }
    return result[0]["id"]
}

def close_popup() {
    if new_patient_popup != null {
        ui_close(new_patient_popup)
        new_patient_popup = null
    }
    if schedule_popup != null {
        ui_close(schedule_popup)
        schedule_popup = null
    }
    if med_popup != null {
        ui_close(med_popup)
        med_popup = null
    }
    if plan_popup != null {
        ui_close(plan_popup)
        plan_popup = null
    }
}

def backup_database() {
    backup_path = ui_file_save(null)
    if backup_path == "" { return }
    try {
        content = file_read("psychiatry_emr.db")
        result = file_write(backup_path, content)
        if result == "SUCCESS" {
            sb_set_success(rejoin("Database backed up to ", path_file(backup_path)))
        } else {
            sb_set_error("Backup failed")
        }
    } catch err {
        sb_set_error(rejoin("Backup failed: ", err))
    }
}

def exit_app() {
    ui_close(win)
}

def show_about() {
    ui_alert(rejoin(
        "Psychiatry EMR - Professional Edition\n\n",
        "Version 1.1 (Index-Based Tabs)\n\n",
        "Comprehensive EMR for psychiatric practice.\n\n",
        "Features:\n",
        "• Patient management\n",
        "• Appointment scheduling\n",
        "• SOAP clinical notes\n",
        "• PHQ-9, GAD-7 assessments\n",
        "• Medication tracking\n",
        "• Treatment planning\n",
        "• Reporting"
    ))
}

