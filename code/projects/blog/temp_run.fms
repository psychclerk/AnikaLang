# ==============================================================================
# My Personal Blog - AnikaWx Edition (Absolute Positioning)
# A beautiful blog app with HTML rendering
# Run: python anika.py blog.fms
# ==============================================================================

# --- Global State ---
db = null
win = null
postsList = null
htmlViewer = null
currentPostId = null
searchEntry = null
statusFilter = null
statsLabel = null
btnEdit = null
btnDelete = null
btnPublish = null
btnExport = null
editPopup = null
editTitleEntry = null
editContentText = null
editTagsEntry = null
editStatusCombo = null

# ==============================================================================
# Database Initialization
# ==============================================================================

def initDatabase() {
    db = db_connect("my_blog.db")
    
    db_execute(db, "CREATE TABLE IF NOT EXISTS posts (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        title TEXT NOT NULL,
        content TEXT NOT NULL,
        author TEXT DEFAULT 'Admin',
        tags TEXT DEFAULT '',
        status TEXT DEFAULT 'draft',
        created_date TEXT DEFAULT (datetime('now','localtime')),
        updated_date TEXT DEFAULT (datetime('now','localtime')),
        views INTEGER DEFAULT 0
    )")
    
    # Seed with welcome post if empty
    count = db_query(db, "SELECT COUNT(*) as c FROM posts")
    if count[0]["c"] == 0 {
        welcome = '<h2>Welcome to My Blog!</h2>

<p>This is your <strong>personal blog</strong> powered by AnikaLang. Start writing your thoughts, stories, and ideas.</p>

<h2>Getting Started</h2>

<p>Click the <strong>New Post</strong> button to create your first blog post. You can write in simple HTML:</p>

<ul>
    <li>Use <code>&lt;h2&gt;</code> for headings</li>
    <li>Use <code>&lt;p&gt;</code> for paragraphs</li>
    <li>Use <code>&lt;strong&gt;</code> for <strong>bold</strong> text</li>
    <li>Use <code>&lt;em&gt;</code> for <em>italic</em> text</li>
    <li>Use <code>&lt;blockquote&gt;</code> for quotes</li>
    <li>Use <code>&lt;code&gt;</code> for code snippets</li>
</ul>

<blockquote>
The scariest moment is always just before you start. - Stephen King
</blockquote>

<h2>Features</h2>

<p>Your blog supports:</p>

<ol>
    <li>Rich HTML content rendering</li>
    <li>Tags and categories</li>
    <li>Draft and published states</li>
    <li>Search and filter</li>
    <li>Export posts as HTML files</li>
    <li>View counter</li>
</ol>

<p>Happy writing!</p>'
        
        db_execute(db, "INSERT INTO posts (title, content, tags, status) VALUES ('Welcome to My Blog', '" + escapeSql(welcome) + "', 'welcome,intro', 'published')")
    }
}

# ==============================================================================
# Helper Functions
# ==============================================================================

def escapeSql(text) {
    return replace(str(text), "'", "''")
}

def escapeHtml(text) {
    t = str(text)
    t = replace(t, "&", "&amp;")
    t = replace(t, "<", "&lt;")
    t = replace(t, ">", "&gt;")
    return t
}

def formatDateDisplay(isoDate) {
    if isoDate == null { return "" }
    if len(str(isoDate)) < 10 { return str(isoDate) }
    parts = split(str(isoDate), "-")
    if len(parts) >= 3 {
        dayPart = parts[2]
        if len(dayPart) > 2 {
            dayPart = left(dayPart, 2)
        }
        return dayPart + "-" + parts[1] + "-" + parts[0]
    }
    return str(isoDate)
}

def estimateReadingTime(text) {
    wordCount = len(split(text, " "))
    minutes = int(wordCount / 200)
    if minutes < 1 { return "1 min read" }
    return str(minutes) + " min read"
}

def buildPostHtml(post) {
    title = escapeHtml(post["title"])
    content = post["content"]
    author = escapeHtml(post["author"])
    tags = post["tags"]
    created = formatDateDisplay(post["created_date"])
    views = post["views"]
    readTime = estimateReadingTime(content)
    
    tagsHtml = ""
    if len(str(tags)) > 0 {
        tagList = split(str(tags), ",")
        i = 0
        while i < len(tagList) {
            tag = trim(tagList[i])
            if len(tag) > 0 {
                tagsHtml = tagsHtml + "<span class='tag'>" + escapeHtml(tag) + "</span>"
            }
            i = i + 1
        }
    }
    
    statusBadge = ""
    if post["status"] == "published" {
        statusBadge = "<span class='status published'>Published</span>"
    } else {
        statusBadge = "<span class='status draft'>Draft</span>"
    }
    
    html = '<!DOCTYPE html>
<html>
<head>
<style>
* { box-sizing: border-box; }
body { 
    font-family: Georgia, "Times New Roman", serif; 
    color: #2c3e50; 
    line-height: 1.8; 
    margin: 0; 
    padding: 30px 40px;
    background: #fafafa;
}
.post-header {
    border-bottom: 3px solid #3498db;
    padding-bottom: 20px;
    margin-bottom: 30px;
}
.post-title {
    color: #2c3e50;
    font-size: 2.4em;
    margin: 0 0 15px 0;
    font-weight: bold;
    line-height: 1.2;
}
.post-meta {
    color: #7f8c8d;
    font-size: 0.95em;
    font-family: Arial, sans-serif;
}
.post-meta .author {
    color: #3498db;
    font-weight: bold;
}
.post-meta .separator {
    margin: 0 8px;
    color: #bdc3c7;
}
.status {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 12px;
    font-size: 0.8em;
    font-weight: bold;
    margin-left: 10px;
    font-family: Arial, sans-serif;
}
.status.published {
    background: #27ae60;
    color: white;
}
.status.draft {
    background: #95a5a6;
    color: white;
}
.post-content {
    font-size: 1.1em;
    color: #34495e;
}
.post-content h1 {
    color: #2c3e50;
    font-size: 2em;
    margin-top: 35px;
    margin-bottom: 15px;
    border-bottom: 2px solid #ecf0f1;
    padding-bottom: 8px;
}
.post-content h2 {
    color: #2c3e50;
    font-size: 1.6em;
    margin-top: 30px;
    margin-bottom: 12px;
}
.post-content h3 {
    color: #34495e;
    font-size: 1.3em;
    margin-top: 25px;
    margin-bottom: 10px;
}
.post-content p {
    margin-bottom: 18px;
    text-align: justify;
}
.post-content ul, .post-content ol {
    margin: 15px 0;
    padding-left: 30px;
}
.post-content li {
    margin-bottom: 8px;
}
.post-content blockquote {
    border-left: 4px solid #3498db;
    padding: 12px 20px;
    margin: 20px 0;
    background: #f8f9fa;
    color: #555;
    font-style: italic;
    border-radius: 0 6px 6px 0;
}
.post-content code {
    background: #f4f4f4;
    padding: 2px 7px;
    border-radius: 3px;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 0.9em;
    color: #c7254e;
}
.post-content pre {
    background: #2c3e50;
    color: #ecf0f1;
    padding: 15px;
    border-radius: 6px;
    overflow-x: auto;
    font-family: "Consolas", monospace;
}
.post-content a {
    color: #3498db;
    text-decoration: none;
    border-bottom: 1px dotted #3498db;
}
.post-content a:hover {
    color: #2980b9;
    border-bottom-style: solid;
}
.post-content img {
    max-width: 100%;
    border-radius: 6px;
    margin: 15px 0;
}
.post-content hr {
    border: none;
    border-top: 2px solid #ecf0f1;
    margin: 30px 0;
}
.post-tags {
    margin-top: 35px;
    padding-top: 20px;
    border-top: 1px solid #ecf0f1;
}
.tag {
    display: inline-block;
    background: #3498db;
    color: white;
    padding: 4px 12px;
    border-radius: 15px;
    font-size: 0.8em;
    margin-right: 6px;
    margin-bottom: 6px;
    font-family: Arial, sans-serif;
}
.post-footer {
    margin-top: 30px;
    padding-top: 20px;
    border-top: 2px solid #ecf0f1;
    color: #95a5a6;
    font-size: 0.9em;
    font-family: Arial, sans-serif;
    text-align: center;
}
.empty-state {
    text-align: center;
    padding: 80px 40px;
    color: #95a5a6;
}
.empty-state h2 {
    color: #7f8c8d;
    font-size: 1.8em;
}
.empty-state p {
    font-size: 1.1em;
    font-family: Arial, sans-serif;
}
</style>
</head>
<body>
<div class="post-header">
    <h1 class="post-title">' + title + '</h1>
    <div class="post-meta">
        <span class="author">By ' + author + '</span>
        <span class="separator">|</span>
        <span>' + created + '</span>
        <span class="separator">|</span>
        <span>' + readTime + '</span>
        <span class="separator">|</span>
        <span>' + views + ' views</span>
        ' + statusBadge + '
    </div>
</div>
<div class="post-content">
' + content + '
</div>
<div class="post-tags">
' + tagsHtml + '
</div>
<div class="post-footer">
    Written with love using AnikaLang Blog
</div>
</body>
</html>'
    
    return html
}

def buildEmptyHtml() {
    return '<!DOCTYPE html>
<html>
<head>
<style>
body { 
    font-family: Arial, sans-serif; 
    background: #fafafa;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100vh;
    margin: 0;
    color: #95a5a6;
}
.empty-state {
    text-align: center;
    padding: 40px;
}
.empty-state h2 {
    color: #7f8c8d;
    font-size: 2em;
    margin-bottom: 15px;
}
.empty-state p {
    font-size: 1.1em;
    line-height: 1.6;
}
</style>
</head>
<body>
<div class="empty-state">
    <h2>Select a Post to Read</h2>
    <p>Choose a post from the sidebar, or click<br><strong>New Post</strong> to start writing.</p>
</div>
</body>
</html>'
}

# ==============================================================================
# Post Operations
# ==============================================================================

def loadPosts() {
    ui_listview_clear(postsList)
    
    searchTerm = ""
    if searchEntry != null {
        searchTerm = trim(ui_get(searchEntry))
    }
    
    statusVal = "all"
    if statusFilter != null {
        statusVal = ui_get(statusFilter)
    }
    
    sql = "SELECT id, title, status, created_date, tags FROM posts WHERE 1=1"
    
    if len(searchTerm) > 0 {
        escaped = "%" + escapeSql(searchTerm) + "%"
        sql = sql + " AND (title LIKE '" + escaped + "' OR content LIKE '" + escaped + "' OR tags LIKE '" + escaped + "')"
    }
    
    if statusVal == "published" {
        sql = sql + " AND status = 'published'"
    }
    if statusVal == "draft" {
        sql = sql + " AND status = 'draft'"
    }
    
    sql = sql + " ORDER BY updated_date DESC"
    
    posts = db_query(db, sql)
    for post in posts {
        statusIcon = "[D]"
        if post["status"] == "published" {
            statusIcon = "[P]"
        }
        displayDate = formatDateDisplay(post["created_date"])
        # Column 0 = hidden ID, Column 1 = Title with status icon, Column 2 = Date, Column 3 = Status
        ui_listview_insert(postsList, [str(post["id"]), statusIcon + " " + post["title"], displayDate, post["status"]])
    }
    
    updateStats()
}

def updateStats() {
    total = db_query(db, "SELECT COUNT(*) as c FROM posts")
    published = db_query(db, "SELECT COUNT(*) as c FROM posts WHERE status = 'published'")
    drafts = db_query(db, "SELECT COUNT(*) as c FROM posts WHERE status = 'draft'")
    views = db_query(db, "SELECT SUM(views) as v FROM posts")
    
    viewsVal = 0
    if views[0]["v"] != null {
        viewsVal = views[0]["v"]
    }
    
    ui_set(statsLabel, "  Posts: " + total[0]["c"] + " | Published: " + published[0]["c"] + " | Drafts: " + drafts[0]["c"] + " | Views: " + viewsVal + "  ")
}

def selectPost() {
    selected = ui_listview_get_selected(postsList)
    if selected == null {
        currentPostId = null
        ui_html_set(htmlViewer, buildEmptyHtml())
        updateButtonStates()
        return
    }
    
    # Column 0 contains the ID as string - convert to integer
    currentPostId = int(selected[0])
    
    postData = db_query(db, "SELECT * FROM posts WHERE id = " + currentPostId)
    if len(postData) == 0 { return }
    
    post = postData[0]
    
    # Increment view counter
    db_execute(db, "UPDATE posts SET views = views + 1 WHERE id = " + currentPostId)
    
    html = buildPostHtml(post)
    ui_html_set(htmlViewer, html)
    
    updateButtonStates()
    updateStats()
}

def updateButtonStates() {
    if currentPostId == null {
        ui_button_set_state(btnEdit, "disabled")
        ui_button_set_state(btnDelete, "disabled")
        ui_button_set_state(btnPublish, "disabled")
        ui_button_set_state(btnExport, "disabled")
        return
    }
    
    ui_button_set_state(btnEdit, "normal")
    ui_button_set_state(btnDelete, "normal")
    ui_button_set_state(btnPublish, "normal")
    ui_button_set_state(btnExport, "normal")
    
    postData = db_query(db, "SELECT status FROM posts WHERE id = " + currentPostId)
    if len(postData) > 0 {
        if postData[0]["status"] == "published" {
            ui_set(btnPublish, "Unpublish")
        } else {
            ui_set(btnPublish, "Publish")
        }
    }
}

def newPost() {
    editTitleEntry = null
    editContentText = null
    editTagsEntry = null
    editStatusCombo = null
    
    editPopup = ui_popup("New Blog Post", 830, 700)
    
    # Header
    header = ui_label(editPopup, "  Write a New Post", 0, 0, 800, 35)
    ui_color(header, "#FFFFFF", "#3498DB")
    ui_font(header, 13, "", true)
    
    # Title row
    ui_label(editPopup, "Title:", 20, 50, 60, 25)
    editTitleEntry = ui_entry(editPopup, "My New Post", 90, 50, 690, 28)
    
    # Tags row
    ui_label(editPopup, "Tags:", 20, 90, 60, 25)
    editTagsEntry = ui_entry(editPopup, "tag1, tag2, tag3", 90, 90, 690, 28)
    
    # Status row
    ui_label(editPopup, "Status:", 20, 130, 60, 25)
    editStatusCombo = ui_combobox(editPopup, ["draft", "published"], 90, 130, 150, 28)
    ui_set(editStatusCombo, "draft")
    
    # Content label
    ui_label(editPopup, "Content (HTML supported):", 20, 175, 300, 25)
    ui_font(ui_label(editPopup, "Content (HTML supported):", 20, 175, 300, 25), 10, "", true)
    
    # Content text area
    editContentText = ui_text(editPopup, "", 20, 205, 760, 380)
    
    template = '<h2>My Awesome Post</h2>

<p>Start writing your content here. You can use HTML tags to format your text:</p>

<ul>
    <li>Use <strong>&lt;strong&gt;</strong> for <strong>bold</strong> text</li>
    <li>Use <em>&lt;em&gt;</em> for <em>italic</em> text</li>
    <li>Use &lt;h2&gt; for headings</li>
    <li>Use &lt;blockquote&gt; for quotes</li>
</ul>

<blockquote>
Your inspiring quote goes here.
</blockquote>

<p>Happy writing!</p>'
    ui_text_set(editContentText, template)
    
    # Buttons
    btnSave = ui_button(editPopup, "Save Post", "saveNewPost", 20, 595, 370, 40)
    ui_color(btnSave, "#FFFFFF", "#27AE60")
    btnCancel = ui_button(editPopup, "Cancel", "closeEditPopup", 410, 595, 370, 40)
    ui_color(btnCancel, "#FFFFFF", "#95A5A6")
}

def saveNewPost() {
    title = trim(ui_get(editTitleEntry))
    if len(title) == 0 {
        ui_alert_err("Title cannot be empty")
        return
    }
    
    content = ui_text_get(editContentText)
    tags = trim(ui_get(editTagsEntry))
    status = ui_get(editStatusCombo)
    
    sql = "INSERT INTO posts (title, content, tags, status) VALUES ('"
    sql = sql + escapeSql(title) + "', '"
    sql = sql + escapeSql(content) + "', '"
    sql = sql + escapeSql(tags) + "', '"
    sql = sql + escapeSql(status) + "')"
    
    db_execute(db, sql)
    
    ui_close(editPopup)
    editPopup = null
    loadPosts()
    ui_alert("Post saved successfully!")
}

def editCurrentPost() {
    if currentPostId == null {
        ui_alert_err("Please select a post first")
        return
    }
    
    postData = db_query(db, "SELECT * FROM posts WHERE id = " + currentPostId)
    if len(postData) == 0 { return }
    post = postData[0]
    
    editTitleEntry = null
    editContentText = null
    editTagsEntry = null
    editStatusCombo = null
    
    editPopup = ui_popup("Edit Post", 820, 700)
    
    # Header
    header = ui_label(editPopup, "  Edit Post: " + post["title"], 0, 0, 800, 35)
    ui_color(header, "#FFFFFF", "#F39C12")
    ui_font(header, 13, "", true)
    
    # Title row
    ui_label(editPopup, "Title:", 20, 50, 60, 25)
    editTitleEntry = ui_entry(editPopup, post["title"], 90, 50, 690, 28)
    
    # Tags row
    ui_label(editPopup, "Tags:", 20, 90, 60, 25)
    editTagsEntry = ui_entry(editPopup, post["tags"], 90, 90, 690, 28)
    
    # Status row
    ui_label(editPopup, "Status:", 20, 130, 60, 25)
    editStatusCombo = ui_combobox(editPopup, ["draft", "published"], 90, 130, 150, 28)
    ui_set(editStatusCombo, post["status"])
    
    # Content label
    ui_label(editPopup, "Content (HTML supported):", 20, 175, 300, 25)
    
    # Content text area
    editContentText = ui_text(editPopup, post["content"], 20, 205, 760, 380)
    
    # Buttons
    btnSave = ui_button(editPopup, "Update Post", "saveEditedPost", 20, 595, 370, 40)
    ui_color(btnSave, "#FFFFFF", "#27AE60")
    btnCancel = ui_button(editPopup, "Cancel", "closeEditPopup", 410, 595, 370, 40)
    ui_color(btnCancel, "#FFFFFF", "#95A5A6")
}

def saveEditedPost() {
    title = trim(ui_get(editTitleEntry))
    if len(title) == 0 {
        ui_alert_err("Title cannot be empty")
        return
    }
    
    content = ui_text_get(editContentText)
    tags = trim(ui_get(editTagsEntry))
    status = ui_get(editStatusCombo)
    
    sql = "UPDATE posts SET title = '" + escapeSql(title)
    sql = sql + "', content = '" + escapeSql(content)
    sql = sql + "', tags = '" + escapeSql(tags)
    sql = sql + "', status = '" + escapeSql(status)
    sql = sql + "', updated_date = datetime('now','localtime') WHERE id = " + currentPostId
    
    db_execute(db, sql)
    
    ui_close(editPopup)
    editPopup = null
    loadPosts()
    selectPost()
    ui_alert("Post updated successfully!")
}

def closeEditPopup() {
    if editPopup != null {
        ui_close(editPopup)
        editPopup = null
    }
}

def deleteCurrentPost() {
    if currentPostId == null {
        ui_alert_err("Please select a post first")
        return
    }
    
    postData = db_query(db, "SELECT title FROM posts WHERE id = " + currentPostId)
    if len(postData) == 0 { return }
    
    ui_alert("Delete post: " + postData[0]["title"] + "?\n\nThis action cannot be undone.")
    
    db_execute(db, "DELETE FROM posts WHERE id = " + currentPostId)
    currentPostId = null
    ui_html_set(htmlViewer, buildEmptyHtml())
    loadPosts()
    updateButtonStates()
}

def togglePublishStatus() {
    if currentPostId == null {
        ui_alert_err("Please select a post first")
        return
    }
    
    postData = db_query(db, "SELECT status FROM posts WHERE id = " + currentPostId)
    if len(postData) == 0 { return }
    
    newStatus = "published"
    if postData[0]["status"] == "published" {
        newStatus = "draft"
    }
    
    db_execute(db, "UPDATE posts SET status = '" + newStatus + "', updated_date = datetime('now','localtime') WHERE id = " + currentPostId)
    
    loadPosts()
    selectPost()
}

def exportCurrentPost() {
    if currentPostId == null {
        ui_alert_err("Please select a post first")
        return
    }
    
    postData = db_query(db, "SELECT * FROM posts WHERE id = " + currentPostId)
    if len(postData) == 0 { return }
    
    html = buildPostHtml(postData[0])
    
    path = ui_file_save(null)
    if path == "" { return }
    if path_ext(path) != ".html" {
        path = path + ".html"
    }
    
    result = file_write(path, html)
    if result == "SUCCESS" {
        ui_alert("Post exported to:\n" + path)
    } else {
        ui_alert_err("Export failed: " + result)
    }
}

def doSearch() {
    loadPosts()
}

def doFilter() {
    loadPosts()
}

def onPostSelect(widget) {
    selectPost()
}

def showAbout() {
    ui_alert("My Personal Blog v1.0\n\nA beautiful blog application built with AnikaLang.\n\nFeatures:\n- Rich HTML content rendering\n- Post management (create, edit, delete)\n- Draft and published states\n- Tags and search\n- Export posts as HTML\n- View counter\n\nBuilt with love using AnikaLang")
}

# ==============================================================================
# UI Layout - Absolute Positioning (1500 x 850)
# ==============================================================================

win = ui_window("My Personal Blog", 1500, 900)

# --- Top Toolbar (y=0, h=50, w=1500) ---
toolbarBg = ui_panel(win, 0, 0, 1500, 50)
ui_color(toolbarBg, null, "#2C3E50")

titleLbl = ui_label(toolbarBg, "  My Personal Blog", 10, 10, 220, 30)
ui_color(titleLbl, "#FFFFFF", null)
ui_font(titleLbl, 13, "", true)

searchEntry = ui_entry(toolbarBg, "", 250, 10, 200, 30)

btnSearch = ui_button(toolbarBg, "Search", "doSearch", 480, 10, 80, 30)
ui_color(btnSearch, "#FFFFFF", "#3498DB")

ui_label(toolbarBg, "Filter:", 580, 15, 50, 20)
ui_color(ui_label(toolbarBg, "Filter:", 580, 15, 50, 20), "#FFFFFF", null)

statusFilter = ui_combobox(toolbarBg, ["all", "published", "draft"], 635, 10, 100, 30)
ui_set(statusFilter, "all")

btnApply = ui_button(toolbarBg, "Apply", "doFilter", 745, 10, 70, 30)
ui_color(btnApply, "#FFFFFF", "#9B59B6")

# Moved right-side buttons to utilize the extra 200px width
btnNew = ui_button(toolbarBg, "New Post", "newPost", 1250, 10, 110, 30)
ui_color(btnNew, "#FFFFFF", "#27AE60")

btnAbout = ui_button(toolbarBg, "About", "showAbout", 1370, 10, 110, 30)
ui_color(btnAbout, "#FFFFFF", "#34495E")

# --- Left Sidebar (x=0, y=50, w=390, h=760) ---
sidebarBg = ui_panel(win, 0, 50, 390, 760)
ui_color(sidebarBg, null, "#ECF0F1")

sidebarHeader = ui_label(sidebarBg, "  POSTS", 0, 0, 390, 30)
ui_color(sidebarHeader, "#FFFFFF", "#34495E")
ui_font(sidebarHeader, 12, "", true)

postsList = ui_listview(sidebarBg, ["ID", "Title", "Date", "Status"], 10, 40, 370, 610)
ui_listview_set_column_width(postsList, 0, 1)     # Hidden ID column
ui_listview_set_column_width(postsList, 1, 220)    # Title
ui_listview_set_column_width(postsList, 2, 80)     # Date
ui_listview_set_column_width(postsList, 3, 60)     # Status
ui_bind(postsList, "SELECT", "onPostSelect")

# Action buttons row 1
btnEdit = ui_button(sidebarBg, "Edit", "editCurrentPost", 10, 660, 180, 38)
ui_color(btnEdit, "#FFFFFF", "#F39C12")
btnDelete = ui_button(sidebarBg, "Delete", "deleteCurrentPost", 200, 660, 180, 38)
ui_color(btnDelete, "#FFFFFF", "#E74C3C")

# Action buttons row 2
btnPublish = ui_button(sidebarBg, "Publish", "togglePublishStatus", 10, 708, 180, 38)
ui_color(btnPublish, "#FFFFFF", "#27AE60")
btnExport = ui_button(sidebarBg, "Export", "exportCurrentPost", 200, 708, 180, 38)
ui_color(btnExport, "#FFFFFF", "#3498DB")

# --- Right Main Area: HTML Viewer (x=390, y=50, w=1110, h=760) ---
htmlViewer = ui_htmlview(win, 390, 50, 1110, 760)

# --- Bottom Status Bar (y=810, h=40, w=1500) ---
statusbarBg = ui_panel(win, 0, 810, 1500, 40)
ui_color(statusbarBg, null, "#34495E")

statsLabel = ui_label(statusbarBg, "  Loading...  ", 0, 0, 1200, 40)
ui_color(statsLabel, "#FFFFFF", null)

versionLabel = ui_label(statusbarBg, "  AnikaLang Blog v1.0  ", 1200, 0, 300, 40)
ui_color(versionLabel, "#BDC3C7", null)

# ==============================================================================
# Initialization
# ==============================================================================

initDatabase()
loadPosts()
ui_html_set(htmlViewer, buildEmptyHtml())
updateButtonStates()

ui_mainloop(win)