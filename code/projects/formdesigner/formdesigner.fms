ui_button(toolbar, "+Cmb", "add_combobox_btn", 368, 10, 56, 30)
ui_button(toolbar, "+Lst", "add_listview_btn", 428, 10, 56, 30)
ui_button(toolbar, "+Txt", "add_text_btn", 488, 10, 56, 30)

ui_button(toolbar, "Up", "move_up_btn", 560, 10, 40, 30)
ui_button(toolbar, "Dn", "move_down_btn", 604, 10, 40, 30)
