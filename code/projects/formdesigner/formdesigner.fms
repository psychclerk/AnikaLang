# ---- right pane: generated code ----
right_pane = ui_panel(designer_win, 640, 78, 860, 794)
ui_color(right_pane, null, "#ffffff")
lbl_code = ui_label(right_pane, "Generated Code  (live preview — save with .fms, run with Preview)", 10, 10, 840, 24)
ui_font(lbl_code, 12, "Segoe UI", true)
code_editor = ui_code_editor(right_pane, 10, 40, 840, 744)

# ---- responsive ----
ui_bind(designer_win, "RESIZE", "on_resize")

# ==============================================================================
# BOOT
# ==============================================================================

elements = [make_initial_window()]
next_id = 2
rebuild_list()
generate_code()
layout()

ui_mainloop(designer_win)