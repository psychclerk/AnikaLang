ui_color(status_label, "#ecf0f1", "#34495e")

# ---- left pane: outline ----
left_pane = ui_panel(designer_win, 0, 78, 280, 794)
ui_color(left_pane, null, "#ecf0f1")
lbl_elem = ui_label(left_pane, "Element Outline", 10, 10, 260, 24)
ui_font(lbl_elem, 12, "Segoe UI", true)
