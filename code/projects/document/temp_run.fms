# ==============================================================================
# STATUS BAR HELPERS
# ==============================================================================

def sbSetSuccess(msg) {
    ui_set(sbMessage, rejoin("  ✓ ", msg))
    ui_color(sbMessage, "white", "#27ae60")
}

def sbSetError(msg) {
    ui_set(sbMessage, rejoin("  ⚠ ", msg))
    ui_color(sbMessage, "white", "#c0392b")
}

def sbSetInfo(msg) {
    ui_set(sbMessage, rejoin("  ℹ ", msg))
    ui_color(sbMessage, "white", "#2980b9")
}

