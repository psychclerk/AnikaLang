# ==============================================================================
# ANIKAWRITE v2.2 - AbiWord-like Word Processor (AnikaLang 1.2)
# Uses explicit color handlers for 100% parser compatibility
# ==============================================================================

# --- Global State ---
win = null
currentFile = null
isDirty = false
editor = null
statusWords = null
statusChars = null
statusPages = null
statusModified = null
sbMessage = null
fontCombo = null
sizeCombo = null
findEntry = null
replaceEntry = null
findReplacePopup = null
tablePopupData = null
linkPopupData = null
activePopup = null

# Available fonts
fontList = [
    "Calibri", "Arial", "Times New Roman", "Courier New", "Verdana",
    "Georgia", "Tahoma", "Trebuchet MS", "Comic Sans MS", "Impact",
    "Lucida Console", "Palatino Linotype", "Book Antiqua", "Garamond"
]

# Available sizes
sizeList = [
    "8", "9", "10", "11", "12", "14", "16", "18", "20", "22",
    "24", "26", "28", "32", "36", "40", "48", "56", "64", "72"
]

# ==============================================================================
# STATUS BAR UPDATES
# ==============================================================================

def updateStatus() {
    words = ui_richtext_word_count(editor)
    chars = ui_richtext_char_count(editor)
    ui_set(statusWords, rejoin("  Words: ", words, "  "))
    ui_set(statusChars, rejoin("  Characters: ", chars, "  "))
    
    pages = 1
    if chars > 3000 {
        pages = int(chars / 3000) + 1
    }
    ui_set(statusPages, rejoin("  Pages: ~", pages, "  "))
    
    if isDirty {
        ui_set(statusModified, "  ● Modified  ")
        ui_color(statusModified, "#e74c3c", "#2c3e50")
    } else {
        ui_set(statusModified, "  ✓ Saved  ")
        ui_color(statusModified, "#2ecc71", "#2c3e50")
    }
}

def markDirty() {
    if isDirty == false {
        isDirty = true
        ui_set(statusModified, "  ● Modified  ")
        ui_color(statusModified, "#e74c3c", "#2c3e50")
    }
}

def markSaved() {
    isDirty = false
    ui_set(statusModified, "  ✓ Saved  ")
    ui_color(statusModified, "#2ecc71", "#2c3e50")
}

def onEditorChange() {
    markDirty()
    updateStatus()
}

# ==============================================================================
# FILE OPERATIONS
# ==============================================================================

def doNew() {
    ui_richtext_clear(editor)
    currentFile = null
    markSaved()
    ui_richtext_set_font(editor, "Calibri", 11)
    updateStatus()
}

def doOpen() {
    path = ui_file_open(null)
    if path == "" { return }
    
    ext = lower(path_ext(path))
    result = ui_richtext_load(editor, path, "txt")
    
    # Sequential if statements to avoid 'else if' parser issues
    if ext == ".rtf" { result = ui_richtext_load(editor, path, "rtf") }
    if ext == ".html" { result = ui_richtext_load(editor, path, "html") }
    
    if starts_with(result, "SUCCESS") {
        currentFile = path
        markSaved()
        sbSetSuccess(rejoin("Opened: ", path_file(path)))
    } else {
        ui_alert_err(rejoin("Failed to open: ", result))
    }
    updateStatus()
}

def doSave() {
    if currentFile == null {
        doSaveAs()
        return
    }
    
    ext = lower(path_ext(currentFile))
    fmt = "txt"
    if ext == ".rtf" { fmt = "rtf" }
    if ext == ".html" { fmt = "html" }
    
    result = ui_richtext_save(editor, currentFile, fmt)
    if starts_with(result, "SUCCESS") {
        markSaved()
        sbSetSuccess(rejoin("Saved: ", path_file(currentFile)))
    } else {
        ui_alert_err(rejoin("Failed to save: ", result))
    }
}

def doSaveAs() {
    path = ui_file_save(null)
    if path == "" { return }
    
    ext = lower(path_ext(path))
    if ext != ".rtf" and ext != ".html" and ext != ".htm" and ext != ".txt" {
        path = rejoin(path, ".rtf")
    }
    
    ext = lower(path_ext(path))
    fmt = "txt"
    if ext == ".rtf" { fmt = "rtf" }
    if ext == ".html" { fmt = "html" }
    
    result = ui_richtext_save(editor, path, fmt)
    if starts_with(result, "SUCCESS") {
        currentFile = path
        markSaved()
        sbSetSuccess(rejoin("Saved: ", path_file(path)))
    } else {
        ui_alert_err(rejoin("Failed to save: ", result))
    }
}

def doExportHtml() {
    path = ui_file_save(null)
    if path == "" { return }
    
    if lower(path_ext(path)) != ".html" {
        path = rejoin(path, ".html")
    }
    
    result = ui_richtext_save(editor, path, "html")
    if starts_with(result, "SUCCESS") {
        ui_alert(rejoin("Exported to HTML: ", path_file(path)))
    } else {
        ui_alert_err(rejoin("Export failed: ", result))
    }
}

def doExportTxt() {
    path = ui_file_save(null)
    if path == "" { return }
    
    if lower(path_ext(path)) != ".txt" {
        path = rejoin(path, ".txt")
    }
    
    result = ui_richtext_save(editor, path, "txt")
    if starts_with(result, "SUCCESS") {
        ui_alert(rejoin("Exported to TXT: ", path_file(path)))
    } else {
        ui_alert_err(rejoin("Export failed: ", result))
    }
}

