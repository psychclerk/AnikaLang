def doTextColor() {
    activePopup = ui_popup("Text Color", 350, 200)
    
    colors = [
        ["#000000", "Black"], ["#808080", "Gray"], ["#C0C0C0", "Silver"],
        ["#FFFFFF", "White"], ["#800000", "Maroon"], ["#FF0000", "Red"],
        ["#800080", "Purple"], ["#FF00FF", "Fuchsia"], ["#008000", "Green"],
        ["#00FF00", "Lime"], ["#808000", "Olive"], ["#FFFF00", "Yellow"],
        ["#000080", "Navy"], ["#0000FF", "Blue"], ["#008080", "Teal"],
        ["#00FFFF", "Aqua"]
    ]
    
    col = 0
    row = 0
    i = 0
    while i < len(colors) {
        c = colors[i]
        x = 10 + col * 82
        y = 10 + row * 42
        
        # Generate exact function name: "apply_text_color_FF0000"
        callback = rejoin("apply_text_color_", replace(c[0], "#", ""))
        
        btn = ui_button(activePopup, c[1], callback, x, y, 75, 35)
        ui_color(btn, c[0], "#ecf0f1")
        
        col = col + 1
        if col >= 4 {
            col = 0
            row = row + 1
        }
        i = i + 1
    }
    
    ui_color(ui_button(activePopup, "Cancel", "closeActivePopup", 10, 160, 330, 30), "white", "#95a5a6")
}

def doBgColor() {
    activePopup = ui_popup("Highlight Color", 350, 200)
    
    bgColors = [
        ["#FFFFFF", "None"], ["#FFFF00", "Yellow"], ["#00FF00", "Green"],
        ["#00FFFF", "Cyan"], ["#FFC0CB", "Pink"], ["#FFA500", "Orange"],
        ["#ADD8E6", "Light Blue"], ["#DDA0DD", "Plum"], ["#F5DEB3", "Wheat"],
        ["#D3D3D3", "Light Gray"], ["#98FB98", "Pale Green"], ["#FFD700", "Gold"]
    ]
    
    col = 0
    row = 0
    i = 0
    while i < len(bgColors) {
        c = bgColors[i]
        x = 10 + col * 82
        y = 10 + row * 42
        
        # Generate exact function name: "apply_bg_FFFF00"
        callback = rejoin("apply_bg_", replace(c[0], "#", ""))
        
        btn = ui_button(activePopup, c[1], callback, x, y, 75, 35)
        ui_color(btn, "#000000", c[0])
        
        col = col + 1
        if col >= 4 {
            col = 0
            row = row + 1
        }
        i = i + 1
    }

    ui_color(ui_button(activePopup, "Cancel", "closeActivePopup", 10, 160, 330, 30), "white", "#95a5a6")
}

# ==============================================================================
# INSERT OPERATIONS
# ==============================================================================

def doInsertImage() {
    path = ui_file_open(null)
    if path == "" { return }
    
    result = ui_richtext_insert_image(editor, path, 400, 0)
    if starts_with(result, "SUCCESS") {
        markDirty()
        sbSetSuccess("Image inserted")
    } else {
        ui_alert_err(rejoin("Failed to insert image: ", result))
    }
}

def doInsertTable() {
    activePopup = ui_popup("Insert Table", 300, 200)
    
    ui_color(ui_label(activePopup, "Rows:", 10, 15, 80, 25), "#2c3e50", "")
    rowsEntry = ui_entry(activePopup, "3", 100, 12, 80, 28)
    
    ui_color(ui_label(activePopup, "Columns:", 10, 55, 80, 25), "#2c3e50", "")
    colsEntry = ui_entry(activePopup, "3", 100, 52, 80, 28)
    
    ui_color(ui_button(activePopup, "Insert", "doInsertTableExecute", 10, 100, 130, 35), "white", "#27ae60")
    ui_color(ui_button(activePopup, "Cancel", "closeActivePopup", 150, 100, 130, 35), "white", "#95a5a6")
    
    tablePopupData = {"rows": rowsEntry, "cols": colsEntry, "popup": activePopup}
}

def doInsertTableExecute() {
    rows = int(ui_get(tablePopupData["rows"]))
    cols = int(ui_get(tablePopupData["cols"]))
    ui_close(tablePopupData["popup"])
    
    if rows < 1 or cols < 1 {
        ui_alert_err("Rows and columns must be at least 1")
        return
    }
    
    # Fixed: Removed 4th argument to match corrected Python backend
    result = ui_richtext_insert_table(editor, rows, cols)
    if starts_with(result, "SUCCESS") {
        markDirty()
        sbSetSuccess(rejoin("Table inserted: ", rows, " x ", cols))
    } else {
        ui_alert_err(rejoin("Failed to insert table: ", result))
    }
}

def doInsertDate() {
    ui_richtext_insert_field(editor, "date")
    markDirty()
}

def doInsertTime() {
    ui_richtext_insert_field(editor, "time")
    markDirty()
}

def doInsertHr() {
    ui_richtext_hr(editor)
    markDirty()
}

def doInsertHyperlink() {
    activePopup = ui_popup("Insert Hyperlink", 400, 200)
    
    ui_color(ui_label(activePopup, "URL:", 10, 15, 80, 25), "#2c3e50", "")
    urlEntry = ui_entry(activePopup, "https://", 100, 12, 280, 28)
    
    ui_color(ui_label(activePopup, "Text:", 10, 55, 80, 25), "#2c3e50", "")
    textEntry = ui_entry(activePopup, "", 100, 52, 280, 28)
    
    ui_color(ui_button(activePopup, "Insert", "doInsertHyperlinkExecute", 10, 100, 180, 35), "white", "#27ae60")
    ui_color(ui_button(activePopup, "Cancel", "closeActivePopup", 200, 100, 180, 35), "white", "#95a5a6")
    
    linkPopupData = {"url": urlEntry, "text": textEntry, "popup": activePopup}
}

def doInsertHyperlinkExecute() {
    url = ui_get(linkPopupData["url"])
    text = ui_get(linkPopupData["text"])
    ui_close(linkPopupData["popup"])
    
    if len(trim(url)) == 0 {
        ui_alert_err("Please enter a URL")
        return
    }
    
    if len(trim(text)) == 0 {
        text = url
    }
    
    result = ui_richtext_insert_hyperlink(editor, url, text)
    if starts_with(result, "SUCCESS") {
        markDirty()
        sbSetSuccess("Hyperlink inserted")
    } else {
        ui_alert_err(rejoin("Failed: ", result))
    }
}

def doInsertBullet() {
    ui_richtext_set_bullet(editor, "bullet")
    ui_focus(editor)
}

def doInsertNumbered() {
    ui_richtext_set_bullet(editor, "numbered")
    ui_focus(editor)
}

# ==============================================================================
# FIND & REPLACE
# ==============================================================================

def doFindReplace() {
    if findReplacePopup != null {
        ui_close(findReplacePopup)
    }
    
    findReplacePopup = ui_popup("Find & Replace", 450, 250)
    
    ui_color(ui_label(findReplacePopup, "Find:", 10, 15, 80, 25), "#2c3e50", "")
    findEntry = ui_entry(findReplacePopup, "", 100, 12, 330, 28)
    
    ui_color(ui_label(findReplacePopup, "Replace:", 10, 55, 80, 25), "#2c3e50", "")
    replaceEntry = ui_entry(findReplacePopup, "", 100, 52, 330, 28)
    
    ui_color(ui_button(findReplacePopup, "Find Next", "doFindNext", 10, 100, 130, 35), "white", "#3498db")
    ui_color(ui_button(findReplacePopup, "Replace", "doReplaceOne", 150, 100, 130, 35), "white", "#f39c12")
    ui_color(ui_button(findReplacePopup, "Replace All", "doReplaceAll", 290, 100, 140, 35), "white", "#e74c3c")
    
    findStatus = ui_label(findReplacePopup, "Ready", 10, 150, 420, 25)
    ui_color(findStatus, "#7f8c8d", "")
    
    ui_color(ui_button(findReplacePopup, "Close", "closeFindReplace", 10, 190, 420, 30), "white", "#95a5a6")
}

def closeFindReplace() {
    if findReplacePopup != null {
        ui_close(findReplacePopup)
        findReplacePopup = null
    }
}

def doFindNext() {
    if findEntry == null { return }
    search = ui_get(findEntry)
    if len(trim(search)) == 0 {
        ui_alert_err("Please enter text to find")
        return
    }
    
    pos = ui_richtext_find(editor, search, true)
    if pos >= 0 {
        sbSetSuccess(rejoin("Found at position ", pos))
    } else {
        sbSetError(rejoin("Not found: '", search, "'"))
    }
}

def doReplaceOne() {
    if findEntry == null { return }
    if replaceEntry == null { return }
    
    search = ui_get(findEntry)
    replace = ui_get(replaceEntry)
    
    if len(trim(search)) == 0 {
        ui_alert_err("Please enter text to find")
        return
    }
    
    count = ui_richtext_replace(editor, search, replace, false)
    if count > 0 {
        markDirty()
        sbSetSuccess("Replaced 1 occurrence")
        updateStatus()
    } else {
        sbSetError(rejoin("Not found: '", search, "'"))
    }
}

def doReplaceAll() {
    if findEntry == null { return }
    if replaceEntry == null { return }
    
    search = ui_get(findEntry)
    replace = ui_get(replaceEntry)
    
    if len(trim(search)) == 0 {
        ui_alert_err("Please enter text to find")
        return
    }
    
    count = ui_richtext_replace(editor, search, replace, true)
    if count > 0 {
        markDirty()
        sbSetSuccess(rejoin("Replaced ", count, " occurrences"))
        updateStatus()
    } else {
        sbSetError("No occurrences found")
    }
}

