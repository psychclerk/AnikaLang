statusFilter = ui_label(statusBg, "", 700, 0, 500, 50)
ui_color(statusFilter, "#ECF0F1", null)

# ==============================================================================
# Initialization
# ==============================================================================

# Start with empty sheet
csvHeaders = ["Column1", "Column2", "Column3", "Column4", "Column5"]
ui_sheet_headers(mainSheet, csvHeaders)
ui_sheet_autosize(mainSheet)

updateStatus()

ui_mainloop(win)