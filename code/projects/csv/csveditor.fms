btnSortAsc = ui_button(toolbarBg, "Sort A-Z", "doSortAsc", 680, 8, 80, 28)
btnSortDesc = ui_button(toolbarBg, "Sort Z-A", "doSortDesc", 770, 8, 80, 28)

btnStats = ui_button(toolbarBg, "Stats", "doShowStats", 870, 8, 70, 28)
ui_color(btnStats, "#FFFFFF", "#8E44AD")

btnClear = ui_button(toolbarBg, "Clear", "doClearAll", 950, 8, 70, 28)
