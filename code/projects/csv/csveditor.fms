btnClearFilter = ui_button(filterBg, "Clear", "doClearFilter", 465, 5, 70, 25)
ui_color(btnClearFilter, "#FFFFFF", "#7F8C8D")

filterHint = ui_label(filterBg, "(Select a cell in the column to filter, then click Apply)", 550, 8, 500, 20)
ui_color(filterHint, "#7F8C8D", null)

# --- Main Sheet (y=125, h=675) ---
# ui_sheet(parent, rows, cols, x, y, w, h)
mainSheet = ui_sheet(win, 50, 10, 10, 125, 1200, 675)

# Bind events using enhanced event system
ui_sheet_bind(mainSheet, "cell_select", "onCellSelect")
ui_sheet_bind(mainSheet, "edit", "onCellEdit")

# --- Status Bar (y=800, h=50) ---
statusBg = ui_panel(win, 0, 800, 1200, 50)
ui_color(statusBg, null, "#34495E")

statusFile = ui_label(statusBg, "  Untitled.csv", 0, 0, 250, 50)
ui_color(statusFile, "#ECF0F1", null)

