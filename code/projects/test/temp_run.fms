    log_result(rejoin("Radio State: '", ui_radio_get("test_radio_group"), "'"))
    log_result(rejoin("Text Area Value: '", ui_text_get(test_text), "'"))
    selected = ui_listview_get_selected(test_listview)
    if selected == null {
        log_result("Listview Selection: None")
    } else {
        log_result(rejoin("Listview Selection: ", selected[0], " | ", selected[1]))
    }
    # FIXED: Use ui_tab_get_title to retrieve the string name
    log_result(rejoin("Current Tab: '", ui_tab_get_title(main_tabs), "'"))
    update_status()
}

def export_results() {
    content = ui_text_get(test_log)
    if len(trim(content)) == 0 {
        ui_alert_err("No test results to export.")
        return
    }
    path = ui_file_save(null)
    if path == "" { return }
    if path_ext(path) != ".txt" {
        path = rejoin(path, ".txt")
    }
    result = file_write(path, content)
    if result == "SUCCESS" {
        ui_alert(rejoin("Results exported to:\n", path))
    } else {
        ui_alert_err(rejoin("Export failed: ", result))
    }
}

