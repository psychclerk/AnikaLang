    ui_tab_select_by_name(main_tabs, "Automated Tests")
    
    ui_button_set_state(btn_run, "disabled")
    assert_test("UI_BUTTON_SET_STATE Disabled No Crash", true)
    ui_button_set_state(btn_run, "normal")
    assert_test("UI_BUTTON_SET_STATE Normal No Crash", true)
    
    if test_sheet != null {
        ui_sheet_cell_set(test_sheet, 0, 0, "A1")
        ui_sheet_cell_set(test_sheet, 0, 1, "B1")
        ui_sheet_cell_set(test_sheet, 1, 0, "A2")
        assert_equals(ui_sheet_cell_get(test_sheet, 0, 0), "A1", "UI_SHEET_CELL_SET/GET A1")
        assert_equals(ui_sheet_cell_get(test_sheet, 1, 0), "A2", "UI_SHEET_CELL_SET/GET A2")
    }
}

# ==============================================================================
# TEST GROUP 16: EDGE CASES & SAFETY
# ==============================================================================

def test_edge_cases() {
    log_result("\n=== [16] Edge Cases & Safety ===")
    assert_equals(sqrt(-1), "Error", "SQRT Negative Safe")
    assert_equals(ln(0), "Error", "LN Zero Safe")
    div_zero_caught = false
    try {
        bad_div = 1 / 0
    } catch err {
        div_zero_caught = true
    }
    assert_equals(div_zero_caught, true, "Division by Zero Caught")
    empty_list = []
    assert_equals(len(empty_list), 0, "Empty List LEN")
    assert_equals(sum(empty_list), 0, "Empty List SUM")
    assert_equals(avg(empty_list), 0, "Empty List AVG")
    assert_equals(not null, true, "NULL is falsy")
    assert_equals(not "", true, "Empty string is falsy")
    assert_equals(not 0, true, "Zero is falsy")
    assert_equals(iif("hello", "yes", "no"), "yes", "Non-empty string is truthy")
    assert_equals(eval_fms("x = 42"), "OK", "EVAL_FMS basic")
    assert_equals(eval_fms("return 10 + 20"), 30, "EVAL_FMS with RETURN")
    assert_equals(is_error("ERROR: something"), true, "IS_ERROR true")
    assert_equals(is_error("normal string"), false, "IS_ERROR false")
    assert_equals(error_message("ERROR: test message"), "test message", "ERROR_MESSAGE extract")
}

