def run_all_tests() {
    pass_count = 0
    fail_count = 0
    total_tests = 0
    ui_text_set(test_log, "Starting AnikaLang wxPython Test Suite v4.0...\n========================================\n")
    
    test_basic_math()
    test_type_casting()
    test_string_functions()
    test_logic()
    test_scientific_math()
    test_trigonometry()
    test_aggregation()
    test_collections()
    test_control_flow()
    test_functions()
    test_datetime()
    test_data_utilities()
    test_file_io()
    test_path_utils()
    test_gui_widgets()
    test_edge_cases()
    test_csv_operations()
    test_database()
    test_markdown_html()
    test_system()
    test_statistics()
    test_introspection()
    test_mathutils()
    test_stringutils()
    test_advanced_ui()
    test_office_plugins()
    test_core_edge_cases()
    
    log_result("\n========================================")
    log_result("TEST SUITE COMPLETED")
    log_result(rejoin("Total Tests:  ", total_tests))
    log_result(rejoin("Passed:       ", pass_count))
    log_result(rejoin("Failed:       ", fail_count))
    if fail_count == 0 {
        log_result("ALL TESTS PASSED!")
    } else {
        log_result("SOME TESTS FAILED - Review above")
    }
    log_result("========================================")
    update_status()
}

