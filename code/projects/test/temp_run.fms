# ==============================================================================
# ANIKALANG COMPREHENSIVE TEST SUITE v4.0 (wxPython Edition)
# Tests all language features with absolute positioning layout
# Run: python main.py projects/test/test_all_wx.fms
# ==============================================================================

# --- INCLUDE UTILITY LIBRARIES ---
INCLUDE "../../includes/mathutils.fms"
INCLUDE "../../includes/stringutils.fms"

# --- CUSTOM FUNCTIONS FOR TESTING ---
def test_custom_add(x, y) {
    return x + y
}

def test_recursive_countdown(n) {
    if n <= 0 { return 0 }
    return n + test_recursive_countdown(n - 1)
}

def test_fibonacci(n) {
    if n <= 0 { return 0 }
    if n == 1 { return 1 }
    return test_fibonacci(n - 1) + test_fibonacci(n - 2)
}

# --- GLOBAL VARIABLES ---
test_log = null
pass_count = 0
fail_count = 0
total_tests = 0
status_lbl = null
btn_run = null

# Widget references for GUI tests
test_entry = null
test_text = null
test_checkbox = null
test_combo = null
test_listview = null
main_tabs = null
test_sheet = null
tab_inter = null
win = null

# ==============================================================================
# HELPER FUNCTIONS
# ==============================================================================

def log_result(msg) {
    current = ui_text_get(test_log)
    ui_text_set(test_log, rejoin(current, msg, "\n"))
}

def assert_test(name, condition) {
    total_tests = total_tests + 1
    if condition == true {
        pass_count = pass_count + 1
        log_result(rejoin("  PASS: ", name))
    } else {
        fail_count = fail_count + 1
        log_result(rejoin("  FAIL: ", name))
    }
}

def assert_equals(actual, expected, name) {
    total_tests = total_tests + 1
    actual_str = str(actual)
    expected_str = str(expected)
    
    is_match = false
    try {
        diff = float(actual) - float(expected)
        if diff < 0 { diff = -diff }
        if diff < 0.0001 { is_match = true }
    } catch err {
        if actual_str == expected_str { is_match = true }
    }
    
    if is_match {
        pass_count = pass_count + 1
        log_result(rejoin("  PASS: ", name, " = ", actual_str))
    } else {
        fail_count = fail_count + 1
        log_result(rejoin("  FAIL: ", name, " (expected: ", expected_str, ", got: ", actual_str, ")"))
    }
}

def update_status() {
    msg = rejoin("Tests: ", total_tests, " | Passed: ", pass_count, " | Failed: ", fail_count)
    if fail_count == 0 and total_tests > 0 {
        msg = rejoin(msg, " | ALL PASSED")
    }
    ui_set(status_lbl, rejoin("  ", msg))
}

# ==============================================================================
# TEST GROUP 1: VARIABLES & BASIC MATH
# ==============================================================================

def test_basic_math() {
    log_result("\n=== [1] Variables & Basic Math ===")
    a = 10
    b = 3
    assert_equals(a + b, 13, "Addition")
    assert_equals(a - b, 7, "Subtraction")
    assert_equals(a * b, 30, "Multiplication")
    assert_equals(a / b, 3.3333333, "Division")
    assert_equals(-5, -5, "Negative Number")
    assert_equals(rejoin("Hello", " ", "World"), "Hello World", "String Concat with rejoin")
    assert_equals(rejoin("Value: ", 42), "Value: 42", "Number to String Concat")
    assert_equals(abs(-5), 5, "ABS Negative")
    assert_equals(abs(5), 5, "ABS Positive")
    assert_equals(round(3.14159, 2), 3.14, "ROUND to 2 decimals")
    assert_equals(round(3.7, 0), 4.0, "ROUND to 0 decimals")
    assert_equals(sqrt(16), 4.0, "SQRT Perfect Square")
    assert_equals(sqrt(2), 1.4142135, "SQRT Non-Perfect")
    rand_val = rand()
    assert_test("RAND Range 0-1", rand_val >= 0.0 and rand_val < 1.0)
    rand_int = randint(1, 100)
    assert_test("RANDINT Range", rand_int >= 1 and rand_int <= 100)
}

# ==============================================================================
# TEST GROUP 2: TYPE CASTING
# ==============================================================================

def test_type_casting() {
    log_result("\n=== [2] Type Casting ===")
    assert_equals(int(3.99), 3, "INT from float")
    assert_equals(int("42"), 42, "INT from string")
    assert_equals(int("3.14"), 3, "INT from string float")
    assert_equals(float("3.14"), 3.14, "FLOAT from string")
    assert_equals(float(5), 5.0, "FLOAT from int")
    assert_equals(str(42), "42", "STR from int")
    assert_equals(str(3.14), "3.14", "STR from float")
    assert_equals(str(true), "true", "STR from bool")
    assert_equals(type_of(42), "INTEGER", "TYPE_OF integer")
    assert_equals(type_of(3.14), "FLOAT", "TYPE_OF float")
    assert_equals(type_of("hello"), "STRING", "TYPE_OF string")
    assert_equals(type_of(true), "BOOLEAN", "TYPE_OF boolean")
    assert_equals(type_of(null), "NULL", "TYPE_OF null")
    assert_equals(type_of([1, 2]), "LIST", "TYPE_OF list")
    assert_equals(type_of({"a": 1}), "DICT", "TYPE_OF dict")
}

# ==============================================================================
# TEST GROUP 3: STRING FUNCTIONS
# ==============================================================================

def test_string_functions() {
    log_result("\n=== [3] String Functions ===")
    s = "  FMS Logos  "
    assert_equals(trim(s), "FMS Logos", "TRIM")
    assert_equals(upper(trim(s)), "FMS LOGOS", "UPPER")
    assert_equals(lower(trim(s)), "fms logos", "LOWER")
    assert_equals(len(trim(s)), 9, "LEN String")
    assert_equals(replace("Hello World", "World", "AnikaLang"), "Hello AnikaLang", "REPLACE Basic")
    assert_equals(replace("aaa", "a", "b"), "bbb", "REPLACE Multiple")
    assert_equals(replace("Hello", "xyz", "abc"), "Hello", "REPLACE No Match")
    assert_equals(iif(1 == 1, "Yes", "No"), "Yes", "IIF True")
    assert_equals(iif(1 == 2, "Yes", "No"), "No", "IIF False")
    assert_equals(left("Hello World", 5), "Hello", "LEFT")
    assert_equals(right("Hello World", 5), "World", "RIGHT")
    assert_equals(mid("Hello World", 6, 5), "World", "MID")
    parts = split("a,b,c", ",")
    assert_equals(len(parts), 3, "SPLIT length")
    assert_equals(parts[0], "a", "SPLIT element 0")
    assert_equals(parts[2], "c", "SPLIT element 2")
    assert_equals(starts_with("Hello World", "Hello"), true, "STARTS_WITH true")
    assert_equals(starts_with("Hello World", "World"), false, "STARTS_WITH false")
    assert_equals(ends_with("Hello World", "World"), true, "ENDS_WITH true")
    assert_equals(contains("Hello World", "lo Wo"), true, "CONTAINS true")
    assert_equals(contains("Hello World", "xyz"), false, "CONTAINS false")
    assert_equals(index_of("Hello World", "World"), 6, "INDEX_OF found")
    assert_equals(index_of("Hello World", "xyz"), -1, "INDEX_OF not found")
}

# ==============================================================================
# TEST GROUP 4: LOGIC & COMPARISON
# ==============================================================================

def test_logic() {
    log_result("\n=== [4] Logic & Comparison ===")
    assert_equals(true and true, true, "AND True")
    assert_equals(true and false, false, "AND False")
    assert_equals(false or true, true, "OR True")
    assert_equals(false or false, false, "OR False")
    assert_equals(not true, false, "NOT True")
    assert_equals(not false, true, "NOT False")
    assert_equals(5 == 5, true, "Equality")
    assert_equals(5 != 3, true, "Inequality")
    assert_equals(10 > 5, true, "Greater Than")
    assert_equals(3 < 7, true, "Less Than")
    assert_equals(5 >= 5, true, "Greater Or Equal")
    assert_equals(5 <= 5, true, "Less Or Equal")
    assert_equals("abc" == "abc", true, "String Equality")
    assert_equals(null == null, true, "NULL Check")
}

# ==============================================================================
# TEST GROUP 5: SCIENTIFIC MATH
# ==============================================================================

def test_scientific_math() {
    log_result("\n=== [5] Scientific Math ===")
    assert_equals(pow(2, 10), 1024.0, "POW 2^10")
    assert_equals(pow(5, 2), 25.0, "POW Square")
    assert_equals(floor(3.7), 3, "FLOOR")
    assert_equals(floor(-2.3), -3, "FLOOR Negative")
    assert_equals(ceil(3.2), 4, "CEIL")
    assert_equals(ceil(-2.7), -2, "CEIL Negative")
    assert_equals(pi(), 3.14159265358979, "PI")
    assert_equals(e(), 2.71828182845904, "E")
    assert_equals(exp(0), 1.0, "EXP 0")
    assert_equals(round(ln(e()), 5), 1.0, "LN of E")
    assert_equals(log10(100), 2.0, "LOG10")
    assert_equals(pow(9, 0.5), 3.0, "SQRT via POW")
}

# ==============================================================================
# TEST GROUP 6: TRIGONOMETRY
# ==============================================================================

def test_trigonometry() {
    log_result("\n=== [6] Trigonometry ===")
    half_pi = pi() / 2
    assert_equals(round(sin(0), 5), 0.0, "SIN 0")
    assert_equals(round(cos(0), 5), 1.0, "COS 0")
    assert_equals(round(tan(0), 5), 0.0, "TAN 0")
    assert_equals(round(sin(half_pi), 5), 1.0, "SIN 90deg")
    assert_equals(round(cos(half_pi), 5), 0.0, "COS 90deg")
    assert_equals(round(deg_to_rad(180), 5), round(pi(), 5), "DEG_TO_RAD 180")
    assert_equals(round(rad_to_deg(pi()), 5), 180.0, "RAD_TO_DEG PI")
    assert_equals(round(asin(1), 5), round(half_pi, 5), "ASIN 1")
    assert_equals(round(acos(1), 5), 0.0, "ACOS 1")
    assert_equals(round(atan(0), 5), 0.0, "ATAN 0")
}

# ==============================================================================
# TEST GROUP 7: AGGREGATION & COMBINATORICS
# ==============================================================================

def test_aggregation() {
    log_result("\n=== [7] Aggregation & Combinatorics ===")
    nums = [10, 20, 30, 40, 50]
    assert_equals(sum(nums), 150, "SUM List")
    assert_equals(avg(nums), 30.0, "AVG List")
    assert_equals(min(5, 10), 5, "MIN Two Args")
    assert_equals(max(5, 10), 10, "MAX Two Args")
    assert_equals(fact(5), 120, "FACT 5")
    assert_equals(fact(0), 1, "FACT 0")
    assert_equals(comb(5, 2), 10, "COMB 5 choose 2")
    assert_equals(perm(5, 2), 20, "PERM 5 pick 2")
}

# ==============================================================================
# TEST GROUP 8: LISTS & DICTIONARIES
# ==============================================================================

def test_collections() {
    log_result("\n=== [8] Lists & Dictionaries ===")
    my_list = [10, 20, 30, 40]
    assert_equals(len(my_list), 4, "List Length")
    assert_equals(my_list[0], 10, "List Index 0")
    assert_equals(my_list[3], 40, "List Index 3")
    list_a = [1, 2]
    list_b = [3, 4]
    list_combined = list_a + list_b
    assert_equals(len(list_combined), 4, "List Concat length")
    assert_equals(list_combined[2], 3, "List Concat value")
    mod_list = [1, 2, 3]
    list_append(mod_list, 4)
    assert_equals(len(mod_list), 4, "LIST_APPEND")
    list_set(mod_list, 0, 99)
    assert_equals(mod_list[0], 99, "LIST_SET")
    my_dict = {"name": "Jagdish", "role": "Developer", "count": 42}
    assert_equals(my_dict["name"], "Jagdish", "Dict Access")
    assert_equals(my_dict["count"], 42, "Dict Numeric Value")
    assert_equals(len(my_dict), 3, "Dict Length")
    nested = {"user": {"id": 1, "active": true}}
    assert_equals(nested["user"]["id"], 1, "Nested Dict Access")
    assert_equals(nested["user"]["active"], true, "Nested Dict Bool")
    keys = dict_keys(my_dict)
    assert_equals(len(keys), 3, "DICT_KEYS length")
    vals = dict_values(my_dict)
    assert_equals(len(vals), 3, "DICT_VALUES length")
    mod_dict = {"a": 1}
    dict_set(mod_dict, "b", 2)
    assert_equals(mod_dict["b"], 2, "DICT_SET")
    assert_equals(dict_has_key(mod_dict, "b"), true, "DICT_HAS_KEY true")
    assert_equals(dict_has_key(mod_dict, "z"), false, "DICT_HAS_KEY false")
}

# ==============================================================================
# TEST GROUP 9: CONTROL FLOW
# ==============================================================================

def test_control_flow() {
    log_result("\n=== [9] Control Flow ===")
    loop_sum = 0
    for i in [1, 2, 3, 4, 5] {
        loop_sum = loop_sum + i
    }
    assert_equals(loop_sum, 15, "FOR Loop Sum (List)")
    
    range_sum = 0
    for i in [1..5] step 1 {
        range_sum = range_sum + i
    }
    assert_equals(range_sum, 15, "FOR Range [1..5] STEP 1")
    
    range_back = 0
    for x in [10..6] step -2 {
        range_back = range_back + x
    }
    assert_equals(range_back, 24, "FOR Range Backward [10..6] STEP -2")
    
    range_to_sum = 0
    for n in 1..3 step 1 {
        range_to_sum = range_to_sum + n
    }
    assert_equals(range_to_sum, 6, "FOR Range 1 TO 3 STEP 1")
    
    while_count = 0
    while while_count < 5 {
        while_count = while_count + 1
    }
    assert_equals(while_count, 5, "WHILE Loop")
    
    break_test = 0
    for i in [1, 2, 3, 4, 5] {
        if i == 3 {
            break
        }
        break_test = break_test + i
    }
    assert_equals(break_test, 3, "BREAK Statement")
    
    continue_test = 0
    for i in [1, 2, 3] {
        if i == 2 {
            continue
        }
        continue_test = continue_test + i
    }
    assert_equals(continue_test, 4, "CONTINUE Statement")
    
    if_result = ""
    if 10 > 5 {
        if_result = "greater"
    } else {
        if_result = "lesser"
    }
    assert_equals(if_result, "greater", "IF/ELSE True Branch")
    
    try_success = false
    try {
        x = 10 / 2
        try_success = true
    } catch err {
        try_success = false
    }
    assert_equals(try_success, true, "TRY/CATCH Success")
    
    catch_success = false
    try {
        y = 10 / 0
    } catch err {
        catch_success = true
    }
    assert_equals(catch_success, true, "TRY/CATCH Division by Zero")
}

