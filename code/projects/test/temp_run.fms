# ==============================================================================
# TEST GROUP 18: DATABASE OPERATIONS
# ==============================================================================

def test_database() {
    log_result("\n=== [18] Database Operations ===")
    test_db = db_connect("./test_db_temp.db")
    create_res = db_execute(test_db, "CREATE TABLE IF NOT EXISTS test_table (id INTEGER PRIMARY KEY, name TEXT, value REAL)")
    assert_test("DB_CREATE TABLE", create_res == -1 or create_res >= 0)
    assert_equals(db_execute(test_db, "INSERT INTO test_table (name, value) VALUES ('test1', 3.14)"), 1, "DB_INSERT rowcount")
    db_execute(test_db, "INSERT INTO test_table (name, value) VALUES ('test2', 2.71)")
    db_execute(test_db, "INSERT INTO test_table (name, value) VALUES ('test3', 1.41)")
    query_res = db_query(test_db, "SELECT * FROM test_table ORDER BY id")
    assert_equals(len(query_res), 3, "DB_QUERY row count")
    assert_equals(query_res[0]["name"], "test1", "DB_QUERY first row name")
    assert_equals(query_res[2]["value"], 1.41, "DB_QUERY last row value")
    db_execute(test_db, "UPDATE test_table SET value = 9.99 WHERE name = 'test1'")
    updated = db_query(test_db, "SELECT value FROM test_table WHERE name = 'test1'")
    assert_equals(updated[0]["value"], 9.99, "DB_UPDATE")
    db_execute(test_db, "DELETE FROM test_table WHERE name = 'test3'")
    after_delete = db_query(test_db, "SELECT * FROM test_table")
    assert_equals(len(after_delete), 2, "DB_DELETE")
    db_execute(test_db, "DROP TABLE test_table")
}

# ==============================================================================
# TEST GROUP 19: MARKDOWN & HTML CONVERSION
# ==============================================================================

def test_markdown_html() {
    log_result("\n=== [19] Markdown & HTML Conversion ===")
    html_result = md_to_html("# Hello World")
    assert_test("MD_TO_HTML contains h1", contains(html_result, "h1") and contains(html_result, "Hello World"))
    html_result2 = md_to_html("## Section\n\nThis is **bold**.")
    assert_test("MD_TO_HTML contains strong", contains(html_result2, "<strong>") or contains(html_result2, "bold"))
    md_result = html_to_md("<h1>Title</h1><p>This is <strong>bold</strong> text.</p>")
    assert_test("HTML_TO_MD contains heading", contains(md_result, "#") or contains(md_result, "Title"))
    assert_test("HTML_TO_MD contains bold", contains(md_result, "**") or contains(md_result, "bold"))
    assert_equals(html_to_text("<p>Hello <b>World</b></p>"), "Hello World", "HTML_TO_TEXT strips tags")
}

# ==============================================================================
# TEST GROUP 20: SYSTEM & EXEC
# ==============================================================================

def test_system() {
    log_result("\n=== [20] System & EXEC ===")
    assert_test("INTERPRETER_PATH Not Empty", len(interpreter_path()) > 0)
    assert_equals(exec("echo test"), "SUCCESS", "EXEC basic command")
    capture_res = exec_capture("echo hello_world")
    assert_test("EXEC_CAPTURE returns list", type_of(capture_res) == "LIST")
    if len(capture_res) >= 2 {
        assert_equals(capture_res[0], true, "EXEC_CAPTURE success flag")
        assert_test("EXEC_CAPTURE contains output", contains(str(capture_res[1]), "hello_world"))
    }
    has_python = cmd_exists("python")
    assert_test("CMD_EXISTS python", has_python == true or has_python == false)
}

# ==============================================================================
# TEST GROUP 21: STATISTICS (Basic)
# ==============================================================================

def test_statistics() {
    log_result("\n=== [21] Statistics ===")
    data = [10, 20, 30, 40, 50]
    assert_equals(stats_mean(data), 30.0, "STATS_MEAN")
    assert_equals(stats_median(data), 30, "STATS_MEDIAN")
    variance = stats_variance(data)
    assert_test("STATS_VARIANCE positive", variance > 0)
    stdev = stats_stdev(data)
    assert_test("STATS_STDEV positive", stdev > 0)
    desc = stats_describe(data)
    assert_equals(desc["n"], 5, "STATS_DESCRIBE n")
    assert_equals(desc["mean"], 30.0, "STATS_DESCRIBE mean")
    assert_equals(desc["min"], 10, "STATS_DESCRIBE min")
    assert_equals(desc["max"], 50, "STATS_DESCRIBE max")
}

# ==============================================================================
# TEST GROUP 22: LIST VARIABLES & INTROSPECTION
# ==============================================================================

def test_introspection() {
    log_result("\n=== [22] Introspection ===")
    vars = list_variables()
    assert_test("LIST_VARIABLES returns dict", type_of(vars) == "DICT")
    assert_test("LIST_VARIABLES has entries", len(vars) > 0)
    assert_equals(dict_has_key(vars, "pass_count"), true, "LIST_VARIABLES contains pass_count")
}

# ==============================================================================
# TEST GROUP 23: MATHUTILS LIBRARY
# ==============================================================================

def test_mathutils() {
    log_result("\n=== [23] MathUtils Library ===")
    assert_equals(mod(10, 3), 1, "MATH mod")
    assert_equals(clamp(15, 0, 10), 10, "MATH clamp")
    assert_equals(lerp(0, 10, 0.5), 5.0, "MATH lerp")
    assert_equals(remap(5, 0, 10, 0, 100), 50.0, "MATH remap")
    assert_equals(gcd(12, 8), 4, "MATH gcd")
    assert_equals(lcm(4, 6), 12, "MATH lcm")
    assert_equals(isPrime(17), true, "MATH isPrime true")
    assert_equals(isPrime(15), false, "MATH isPrime false")
    assert_equals(fibonacci(10), 55, "MATH fibonacci")
    assert_equals(nextPrime(10), 11, "MATH nextPrime")
    assert_equals(distance2d(0, 0, 3, 4), 5.0, "MATH distance2d")
    assert_equals(circleArea(1), 3.14159265358979, "MATH circleArea")
    assert_equals(triangleArea(10, 5), 25.0, "MATH triangleArea")
    assert_equals(celsiusToFahrenheit(100), 212.0, "MATH celsiusToFahrenheit")
    assert_equals(decToBin(10), "1010", "MATH decToBin")
    assert_equals(hexToDec("FF"), 255, "MATH hexToDec")
    assert_equals(formatPercent(0.85, 0), "85%", "MATH formatPercent")
    assert_equals(formatBytes(1500), "1.46 KB", "MATH formatBytes")
}

# ==============================================================================
# TEST GROUP 24: STRINGUTILS LIBRARY
# ==============================================================================

def test_stringutils() {
    log_result("\n=== [24] StringUtils Library ===")
    assert_equals(capitalize("hello"), "Hello", "STR capitalize")
    assert_equals(camelCase("hello world"), "helloWorld", "STR camelCase")
    assert_equals(snakeCase("HelloWorld"), "hello_world", "STR snakeCase")
    assert_equals(kebabCase("Hello World"), "hello-world", "STR kebabCase")
    assert_equals(padLeft("5", 3, "0"), "005", "STR padLeft")
    assert_equals(center("hi", 5, "*"), "*hi**", "STR center")
    assert_equals(repeatStr("ab", 3), "ababab", "STR repeatStr")
    assert_equals(lastIndexOf("hello", "l"), 3, "STR lastIndexOf")
    assert_equals(countOccurrences("banana", "a"), 3, "STR countOccurrences")
    assert_equals(extractBetween("<tag>content</tag>", "<tag>", "</tag>"), "content", "STR extractBetween")
    assert_equals(isEmail("test@example.com"), true, "STR isEmail true")
    assert_equals(isUrl("https://google.com"), true, "STR isUrl true")
    assert_equals(isNumeric("12345"), true, "STR isNumeric true")
    assert_equals(isPalindrome("racecar"), true, "STR isPalindrome")
    assert_equals(slugify("Hello World!"), "hello-world", "STR slugify")
    assert_equals(rot13("hello"), "uryyb", "STR rot13")
    assert_equals(truncate("Hello World", 8), "Hello...", "STR truncate")
    assert_equals(reverse("abcd"), "dcba", "STR reverse")
    assert_equals(levenshtein("kitten", "sitting"), 3, "STR levenshtein")
    assert_equals(template("Hello {name}", {"name": "World"}), "Hello World", "STR template")
    assert_equals(mask("123456789", 4, "*"), "*****6789", "STR mask")
}

