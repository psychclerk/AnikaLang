def test_office_plugins() {
    log_result("\n=== [26] Office & Data Plugins ===")
    excel_data = [{"Name": "Alice", "Score": 90}, {"Name": "Bob", "Score": 85}]
    assert_equals(excel_write("./test_excel_temp.xlsx", excel_data), "SUCCESS", "EXCEL_WRITE")
    assert_equals(len(excel_read("./test_excel_temp.xlsx")), 2, "EXCEL_READ row count")
    doc_handle = docx_create()
    docx_add_heading(doc_handle, "Test Document", 1)
    docx_add_paragraph(doc_handle, "This is a test paragraph.")
    assert_equals(docx_save(doc_handle, "./test_docx_temp.docx"), "SUCCESS", "DOCX_SAVE")
    docx_close(doc_handle)
    graph_line([1, 2, 3], [10, 20, 15], "Test Graph", "X", "Y")
    assert_equals(graph_save("./test_graph_temp.png"), "SUCCESS", "GRAPH_SAVE")
    graph_close()
}

# ==============================================================================
# TEST GROUP 27: CORE LANGUAGE EDGE CASES
# ==============================================================================

def test_core_edge_cases() {
    log_result("\n=== [27] Core Language Edge Cases ===")
    my_dict = {"key": "value"}
    assert_equals(my_dict.key, "value", "CORE Dict Dot Notation")
    text = "Hello"
    assert_equals(text[0], "H", "CORE String Index 0")
    assert_equals(text[4], "o", "CORE String Index 4")
    list1 = [1, 2]
    list2 = [3, 4]
    assert_equals(len(list1 + list2), 4, "CORE List Concatenation")
    nested = {"a": {"b": {"c": 42}}}
    assert_equals(nested.a.b.c, 42, "CORE Nested Dict Dot Notation")
}

