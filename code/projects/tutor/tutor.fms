            '    evens = rejoin(evens, str(i), " ")\n',
            '}\n',
            'say(rejoin("Evens: ", evens))'
        )
    }

    if idx == 10 {
        return rejoin(
            'def greet(name) {\n',
            '    return rejoin("Hello, ", name, "!")\n',
            '}\n',
            '\n',
            'def add(a, b) {\n',
            '    return a + b\n',
            '}\n',
            '\n',
            'def factorial(n) {\n',
            '    if n <= 1 { return 1 }\n',
            '    return n * factorial(n - 1)\n',
            '}\n',
            '\n',
            'def fibonacci(n) {\n',
            '    if n <= 1 { return n }\n',
            '    return fibonacci(n - 1) + fibonacci(n - 2)\n',
            '}\n',
            '\n',
            'say(greet("Alice"))\n',
