            '}\n',
            'if age < 13 or age > 65 {\n',
            '    say("Discount!")\n',
            '} else {\n',
            '    say("Standard price")\n',
            '}'
        )
    }

    if idx == 8 {
        return rejoin(
            '# Sum 1 to 10\n',
            'count = 1\n',
            'total = 0\n',
            'while count <= 10 {\n',
            '    total = total + count\n',
            '    count = count + 1\n',
            '}\n',
            'say(rejoin("Sum 1..10 = ", str(total)))\n',
            '\n',
            '# break example\n',
            'i = 0\n',
            'while true {\n',
            '    i = i + 1\n',
            '    if i > 5 { break }\n',
            '}\n',
            'say(rejoin("Broke at: ", str(i)))\n',
            '\n',
            '# continue example\n',
            'result = ""\n',
            'n = 0\n',
            'while n < 10 {\n',
            '    n = n + 1\n',
            '    if n == 5 { continue }\n',
            '    result = rejoin(result, str(n), " ")\n',
            '}\n',
            'say(rejoin("Skip 5: ", result))'
        )
    }

    if idx == 9 {
        return rejoin(
            '# Iterate a list\n',
            'fruits = ["apple", "banana", "cherry"]\n',
            'for fruit in fruits {\n',
            '    say(rejoin("Fruit: ", fruit))\n',
