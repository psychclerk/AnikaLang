}

# ==============================================================================
# UI FUNCTIONS
# ==============================================================================

def load_lesson(idx) {
    tut_lesson = idx
    titles = get_lesson_titles()

    # update html viewer
    content = get_lesson_content(idx)
    ui_html_set(tut_viewer, content)

    # update code editor
    code = get_lesson_code(idx)
    ui_text_set(tut_code, code)
    ui_highlight(tut_code)

    # clear output
    ui_text_set(tut_output, "")

    # update counter & progress
    ui_set(tut_counter, rejoin("Lesson ", str(idx + 1), " / ", str(tut_total)))
    pct = int((idx + 1) * 100 / tut_total)
    ui_set(tut_progress, rejoin("Progress: ", str(pct), "%"))

    # select in listbox
    ui_listbox_select(tut_list, idx)
}

def run_current_lesson() {
    try {
        code = ui_text_get(tut_code)
        if len(trim(code)) == 0 {
            ui_text_set(tut_output, "No code to run.")
            return
        }
        clear_output()
        say("▶ Running...")
        result = eval_fms(code)
        if is_error(result) {
            say(rejoin("✗ ERROR: ", error_message(result)))
        } else {
            say("✓ Done!")
        }
    } catch err {
        # Window closed during execution — ignore
    }
}

def next_lesson() {
    if tut_lesson < tut_total - 1 {
        load_lesson(tut_lesson + 1)
    }
}

def prev_lesson() {
    if tut_lesson > 0 {
        load_lesson(tut_lesson - 1)
    }
}

def on_lesson_select() {
    sel = ui_listbox_get(tut_list)
    if sel == null { return }
    titles = get_lesson_titles()
    i = 0
    for t in titles {
        if t == sel {
            load_lesson(i)
            return
        }
        i = i + 1
    }
}

def copy_code() {
    code = ui_text_get(tut_code)
    clipboard_set(code)
    clear_output()
    say("📋 Code copied to clipboard!")
}

def reset_code() {
    code = get_lesson_code(tut_lesson)
    ui_text_set(tut_code, code)
    ui_highlight(tut_code)
    clear_output()
    say("Code reset to original example.")
}

# ==============================================================================
# RESPONSIVE LAYOUT ENGINE
# ==============================================================================

def layout() {
    cs = ui_get_client_size(tut_win)
    cw = cs[0]
    ch = cs[1]

    # --- header (full width, fixed height) ---
    ui_pos(header, 0, 0, cw, HEADER_H)
    ui_pos(h_title, 10, 12, 450, 28)
    ui_pos(tut_counter, 500, 15, 130, 22)
    ui_pos(tut_progress, 650, 15, 130, 22)
    ui_pos(h_ver, cw - 380, 15, 360, 22)

    # --- left panel (fixed width, full remaining height) ---
    left_h = ch - HEADER_H
    ui_pos(left, 0, HEADER_H, LEFT_W, left_h)
    ui_pos(l_lbl, 10, 8, LEFT_W - 20, 24)
    ui_pos(tut_list, 8, 38, LEFT_W - 16, left_h - 48)

    # --- right panel (fills remaining width) ---
    right_x = LEFT_W
    right_w = cw - LEFT_W
    ui_pos(right, right_x, HEADER_H, right_w, left_h)

    # --- right panel internal layout (proportional) ---
    inner_w = right_w - PAD * 2
    inner_h = left_h - PAD * 2

    # viewer: top 35%
    viewer_h = int(inner_h * 0.35)
    if viewer_h < 120 { viewer_h = 120 }
    ui_pos(tut_viewer, PAD, PAD, inner_w, viewer_h)

    # code label
    code_lbl_y = PAD + viewer_h + GAP
    ui_pos(c_lbl, PAD, code_lbl_y, inner_w, LBL_H)

    # code editor: 28%
    code_y = code_lbl_y + LBL_H + 2
    code_h = int(inner_h * 0.28)
    if code_h < 80 { code_h = 80 }
    ui_pos(tut_code, PAD, code_y, inner_w, code_h)

    # buttons row
    btn_y = code_y + code_h + GAP
    btn_w = 90
    btn_gap = 10
    ui_pos(b_prev, PAD, btn_y, btn_w, BTN_H)
    ui_pos(b_run, PAD + (btn_w + btn_gap) * 1, btn_y, btn_w + 20, BTN_H)
    ui_pos(b_next, PAD + (btn_w + btn_gap) * 2 + 20, btn_y, btn_w, BTN_H)
    ui_pos(b_copy, PAD + (btn_w + btn_gap) * 3 + 20, btn_y, btn_w, BTN_H)
    ui_pos(b_reset, PAD + (btn_w + btn_gap) * 4 + 20, btn_y, btn_w, BTN_H)

    # output label
    out_lbl_y = btn_y + BTN_H + GAP
    ui_pos(o_lbl, PAD, out_lbl_y, inner_w, LBL_H)

    # output: fills remaining space
    out_y = out_lbl_y + LBL_H + 2
    out_h = inner_h - (out_y - PAD) - 4
    if out_h < 60 { out_h = 60 }
    ui_pos(tut_output, PAD, out_y, inner_w, out_h)

    ui_refresh(tut_win)
}

def on_resize(w, nw, nh) {
    layout()
}

