            '}\n',
            '\n',
            'def toggle_todo() {\n',
            '    sel = ui_listview_get_selected(todo_lv)\n',
            '    if sel == null { return }\n',
            '    target = sel[1]\n',
            '    for t in todos {\n',
            '        if t["text"] == target {\n',
            '            if t["done"] == true {\n',
            '                dict_set(t, "done", false)\n',
            '            } else {\n',
            '                dict_set(t, "done", true)\n',
            '            }\n',
            '            break\n',
            '        }\n',
            '    }\n',
            '    refresh_todos()\n',
            '}\n',
            '\n',
            'win = ui_window("Todo App", 450, 380)\n',
            '\n',
            'hdr = ui_label(win, "My Tasks", 20, 12, 200, 28)\n',
            'ui_font(hdr, 16, "Segoe UI", true)\n',
            '\n',
            'todo_entry = ui_entry(win, "Type a task...", 20, 50, 310, 28)\n',
            'ab = ui_button(win, "Add", "add_todo", 340, 48, 90, 30)\n',
            'ui_color(ab, "white", "#27ae60")\n',
            '\n',
            'tb = ui_button(win, "Toggle Done", "toggle_todo", 20, 90, 120, 30)\n',
            'ui_color(tb, "white", "#3498db")\n',
