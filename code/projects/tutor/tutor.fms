# ==============================================================================
# ANIKALANG 1.2 INTERACTIVE TUTORIAL (Resizable)
# 18 lessons · live code execution · syntax-highlighted editor · GUI projects
# Run: python main.py tutor.fms
# ==============================================================================

# ---- global state ----
tut_lesson = 0
tut_total = 18
tut_output = null
tut_viewer = null
tut_list = null
tut_code = null
tut_counter = null
tut_progress = null

# ---- widget handles for resize ----
tut_win = null
header = null
h_title = null
h_ver = null
left = null
l_lbl = null
right = null
c_lbl = null
b_prev = null
b_run = null
b_next = null
b_copy = null
b_reset = null
o_lbl = null

# ---- layout constants ----
HEADER_H = 50
LEFT_W = 270
BTN_H = 34
LBL_H = 22
PAD = 10
GAP = 6

# ==============================================================================
# OUTPUT HELPERS
# ==============================================================================

def say(msg) {
    try {
        cur = ui_text_get(tut_output)
        if len(trim(cur)) == 0 {
            ui_text_set(tut_output, str(msg))
        } else {
            ui_text_set(tut_output, rejoin(cur, "\n", str(msg)))
        }
    } catch err {
        # Window is closing — widget already destroyed, ignore silently
    }
}

def clear_output() {
    try {
        ui_text_set(tut_output, "")
    } catch err {
        # Window is closing — widget already destroyed, ignore silently
    }
}

def html_wrap(body) {
    return rejoin(
        '<html><head><style>',
        'body{font-family:"Segoe UI",sans-serif;padding:18px 22px;background:#fff;color:#2c3e50;line-height:1.65;font-size:14px}',
        'h1{color:#1a1a2e;border-bottom:2px solid #3498db;padding-bottom:6px;font-size:22px}',
        'h2{color:#2980b9;margin-top:18px;font-size:16px}',
        'pre{background:#f4f6f8;border:1px solid #dce1e6;border-radius:6px;padding:12px 14px;font-family:Consolas,monospace;font-size:13px;overflow-x:auto;line-height:1.5}',
        'code{background:#eef1f4;padding:1px 5px;border-radius:3px;font-family:Consolas,monospace;font-size:13px}',
        'pre code{background:none;padding:0}',
        '.tip{background:#e8f5e9;border-left:4px solid #27ae60;padding:10px 14px;margin:10px 0;border-radius:0 6px 6px 0}',
        '.warn{background:#fff3e0;border-left:4px solid #e67e22;padding:10px 14px;margin:10px 0;border-radius:0 6px 6px 0}',
        '.info{background:#e3f2fd;border-left:4px solid #3498db;padding:10px 14px;margin:10px 0;border-radius:0 6px 6px 0}',
        '.try{background:#f3e5f5;border-left:4px solid #9b59b6;padding:10px 14px;margin:10px 0;border-radius:0 6px 6px 0}',
        'table{border-collapse:collapse;width:100%;margin:10px 0}',
        'th,td{border:1px solid #ddd;padding:7px 10px;text-align:left;font-size:13px}',
        'th{background:#f0f2f5}',
        'ul{margin:6px 0 6px 20px}li{margin:3px 0}',
        '</style></head><body>', body, '</body></html>'
    )
}

