def get_lesson_titles() {
    return [
        "01 · Welcome to AnikaLang 1.2",
        "02 · Your First Program",
        "03 · Variables & Assignment",
        "04 · Data Types & Conversion",
        "05 · Numbers & Math",
        "06 · Strings & Text",
        "07 · Building Strings (rejoin)",
        "08 · IF / ELSE Decisions",
        "09 · WHILE Loops",
        "10 · FOR Loops",
        "11 · Functions (def)",
        "12 · Lists",
        "13 · Dictionaries",
        "14 · Error Handling (try/catch)",
        "15 · Your First GUI Window",
        "16 · Buttons & Event Handlers",
        "17 · Project: Calculator",
        "18 · Project: Todo App"
    ]
}

# ==============================================================================
# LESSON CONTENT (HTML)
# ==============================================================================

def get_lesson_content(idx) {

    if idx == 0 {
        return html_wrap(rejoin(
            '<h1>Welcome to AnikaLang 1.2!</h1>',
            '<p>AnikaLang is a beginner-friendly language for building <b>desktop GUI apps</b> with wxPython. Version 1.2 brings modern syntax.</p>',
            '<h2>What You Will Learn</h2>',
            '<ul><li>Variables, types, operators</li>',
            '<li>Control flow: <code>if</code>, <code>while</code>, <code>for</code></li>',
            '<li>Functions with <code>def</code></li>',
            '<li>Lists &amp; dictionaries</li>',
            '<li>Error handling with <code>try / catch</code></li>',
            '<li>Building GUI apps (windows, buttons, forms)</li>',
            '<li>Two complete projects</li></ul>',
            '<h2>Key Syntax in 1.2</h2>',
            '<table><tr><th>Concept</th><th>Syntax</th></tr>',
            '<tr><td>Assignment</td><td><code>x = 10</code></td></tr>',
            '<tr><td>Function</td><td><code>def name() { }</code></td></tr>',
            '<tr><td>If / Else</td><td><code>if cond { } else { }</code></td></tr>',
            '<tr><td>Loop</td><td><code>for x in list { }</code></td></tr>',
            '<tr><td>Strings</td><td><code>rejoin("a", "b")</code></td></tr>',
            '<tr><td>Booleans</td><td><code>true</code> / <code>false</code> / <code>null</code></td></tr></table>',
            '<div class="info">💡 In this tutorial, <code>say()</code> writes to the output box below. In real programs, use <code>ui_alert()</code> for popup messages.</div>',
            '<p>Click <b>Next →</b> to begin!</p>'
        ))
    }

    if idx == 1 {
        return html_wrap(rejoin(
            '<h1>Your First Program</h1>',
            '<p>The simplest way to show output is <code>say()</code> (tutorial helper) or <code>ui_alert()</code> (real programs).</p>',
            '<h2>Syntax</h2>',
            '<pre>say("Hello!")          <span style="color:#888"># writes to output box</span>\nui_alert("Hello!")     <span style="color:#888"># shows a popup dialog</span></pre>',
            '<h2>Comments</h2>',
            '<p>Use <code>#</code> for single-line comments. The interpreter ignores them.</p>',
            '<pre># This is a comment\nx = 10   # inline comment</pre>',
            '<div class="tip">✅ Click <b>▶ Run It!</b> to execute the code and see output below.</div>'
        ))
    }

    if idx == 2 {
        return html_wrap(rejoin(
            '<h1>Variables &amp; Assignment</h1>',
            '<p>Use <code>=</code> to assign values. No <code>SET...TO</code> in 1.2.</p>',
            '<pre>name = "Alice"\nage = 30\npi = 3.14159\nactive = true\nnothing = null</pre>',
            '<h2>Rules</h2>',
            '<ul><li>Names start with a letter or underscore</li>',
            '<li>Case-sensitive: <code>Age</code> ≠ <code>age</code></li>',
            '<li>Reassign anytime: <code>age = 31</code></li></ul>',
            '<div class="warn">⚠️ Variables must be assigned <b>before</b> use.</div>'
        ))
    }

    if idx == 3 {
        return html_wrap(rejoin(
            '<h1>Data Types &amp; Conversion</h1>',
            '<table><tr><th>Type</th><th>Example</th><th>Check</th></tr>',
            '<tr><td>String</td><td><code>"hello"</code></td><td><code>type_of(x)</code> → "STRING"</td></tr>',
            '<tr><td>Integer</td><td><code>42</code></td><td>→ "INTEGER"</td></tr>',
            '<tr><td>Float</td><td><code>3.14</code></td><td>→ "FLOAT"</td></tr>',
            '<tr><td>Boolean</td><td><code>true / false</code></td><td>→ "BOOLEAN"</td></tr>',
            '<tr><td>Null</td><td><code>null</code></td><td>→ "NULL"</td></tr></table>',
            '<h2>Conversion Functions</h2>',
            '<pre>str(42)       # "42"\nint("99")     # 99\nfloat("3.14") # 3.14</pre>'
        ))
    }

    if idx == 4 {
        return html_wrap(rejoin(
            '<h1>Numbers &amp; Math</h1>',
            '<table><tr><th>Operation</th><th>Syntax</th><th>Result</th></tr>',
            '<tr><td>Add</td><td><code>10 + 3</code></td><td>13</td></tr>',
            '<tr><td>Subtract</td><td><code>10 - 3</code></td><td>7</td></tr>',
            '<tr><td>Multiply</td><td><code>10 * 3</code></td><td>30</td></tr>',
            '<tr><td>Divide</td><td><code>10 / 3</code></td><td>3.333…</td></tr>',
            '<tr><td>Power</td><td><code>pow(2, 10)</code></td><td>1024</td></tr>',
            '<tr><td>Sqrt</td><td><code>sqrt(144)</code></td><td>12</td></tr>',
            '<tr><td>Pi</td><td><code>pi()</code></td><td>3.14159…</td></tr></table>',
            '<div class="warn">⚠️ No <code>%</code> (modulo) or <code>^</code> (power) operators. Use <code>pow()</code>.</div>'
        ))
    }

    if idx == 5 {
        return html_wrap(rejoin(
            '<h1>Strings &amp; Text</h1>',
            '<p>Strings are wrapped in <code>"double"</code> or <code>\'single\'</code> quotes.</p>',
            '<h2>Useful Functions</h2>',
            '<table><tr><th>Function</th><th>Example</th><th>Result</th></tr>',
            '<tr><td><code>len(s)</code></td><td><code>len("hello")</code></td><td>5</td></tr>',
            '<tr><td><code>upper(s)</code></td><td><code>upper("hi")</code></td><td>"HI"</td></tr>',
            '<tr><td><code>lower(s)</code></td><td><code>lower("HI")</code></td><td>"hi"</td></tr>',
            '<tr><td><code>trim(s)</code></td><td><code>trim("  hi  ")</code></td><td>"hi"</td></tr>',
            '<tr><td><code>left(s, n)</code></td><td><code>left("hello", 3)</code></td><td>"hel"</td></tr>',
            '<tr><td><code>right(s, n)</code></td><td><code>right("hello", 3)</code></td><td>"llo"</td></tr>',
            '<tr><td><code>mid(s, start, len)</code></td><td><code>mid("hello", 1, 3)</code></td><td>"ell"</td></tr>',
            '<tr><td><code>replace(s, old, new)</code></td><td><code>replace("hi", "i", "ello")</code></td><td>"hello"</td></tr></table>'
        ))
    }

    if idx == 6 {
        return html_wrap(rejoin(
            '<h1>Building Strings with rejoin()</h1>',
            '<p><code>rejoin()</code> concatenates multiple values into one string. It accepts any number of arguments.</p>',
            '<pre>greeting = rejoin("Hello, ", name, "!")\nmsg = rejoin("Score: ", str(score), " / 100")</pre>',
            '<h2>The + Operator Also Works</h2>',
            '<pre>msg = "Hello, " + name + "!"   # also valid in 1.2</pre>',
            '<div class="info">💡 <code>rejoin()</code> is preferred for multi-part strings. <code>+</code> works for simple two-part joins.</div>',
            '<div class="warn">⚠️ The old <code>&amp;</code> operator was <b>removed</b> in 1.2. Use <code>rejoin()</code> or <code>+</code>.</div>'
        ))
    }

    if idx == 7 {
        return html_wrap(rejoin(
            '<h1>IF / ELSE Decisions</h1>',
            '<pre>if score >= 90 {\n    say("Grade: A")\n} else {\n    say("Keep trying!")\n}</pre>',
            '<h2>Comparison Operators</h2>',
            '<table><tr><th>Op</th><th>Meaning</th></tr>',
            '<tr><td><code>==</code></td><td>Equal</td></tr>',
            '<tr><td><code>!=</code></td><td>Not equal</td></tr>',
            '<tr><td><code>&lt; &gt; &lt;= &gt;=</code></td><td>Comparisons</td></tr>',
            '<tr><td><code>and</code></td><td>Both true</td></tr>',
            '<tr><td><code>or</code></td><td>At least one true</td></tr>',
            '<tr><td><code>not</code></td><td>Negate</td></tr></table>',
            '<div class="warn">⚠️ No <code>else if</code>. Nest <code>if</code> inside <code>else { }</code> instead.</div>'
        ))
    }

    if idx == 8 {
        return html_wrap(rejoin(
            '<h1>WHILE Loops</h1>',
            '<pre>count = 1\nwhile count <= 5 {\n    say(rejoin("Count: ", str(count)))\n    count = count + 1\n}</pre>',
            '<h2>Loop Control</h2>',
            '<ul><li><code>break</code> — exit the loop immediately</li>',
            '<li><code>continue</code> — skip to the next iteration</li></ul>',
            '<div class="warn">⚠️ Always ensure the condition becomes <code>false</code>, or you create an infinite loop!</div>'
        ))
    }

    if idx == 9 {
        return html_wrap(rejoin(
            '<h1>FOR Loops</h1>',
            '<h2>Iterate a List</h2>',
            '<pre>fruits = ["apple", "banana", "cherry"]\nfor fruit in fruits {\n    say(fruit)\n}</pre>',
            '<h2>Range Loop (inclusive)</h2>',
            '<pre>for i in 1..5 {\n    say(str(i))    # 1, 2, 3, 4, 5\n}</pre>',
            '<h2>Range with Step</h2>',
            '<pre>for i in 0..20 step 5 {\n    say(str(i))    # 0, 5, 10, 15, 20\n}</pre>'
        ))
    }

    if idx == 10 {
        return html_wrap(rejoin(
            '<h1>Functions (def)</h1>',
            '<pre>def greet(name) {\n    return rejoin("Hello, ", name, "!")\n}\n\nsay(greet("Alice"))   # Hello, Alice!</pre>',
            '<h2>Multiple Parameters</h2>',
            '<pre>def add(a, b) {\n    return a + b\n}</pre>',
            '<h2>Recursion</h2>',
            '<pre>def factorial(n) {\n    if n <= 1 { return 1 }\n    return n * factorial(n - 1)\n}</pre>',
            '<div class="info">💡 Functions use <code>def name(params) { }</code> — no <code>FUNCTION...END FUNCTION</code>.</div>'
        ))
    }

    if idx == 11 {
        return html_wrap(rejoin(
            '<h1>Lists</h1>',
            '<pre>nums = [10, 20, 30, 40, 50]\nsay(str(nums[0]))       # 10  (0-based index)\nsay(str(len(nums)))     # 5</pre>',
            '<h2>Modifying Lists</h2>',
            '<pre>list_append(nums, 60)   # add to end\nlist_set(nums, 0, 100)  # replace index 0</pre>',
            '<h2>Iterate</h2>',
            '<pre>for n in nums {\n    say(str(n))\n}</pre>',
            '<div class="warn">⚠️ Cannot use <code>nums[0] = 100</code>. Use <code>list_set()</code>.</div>'
        ))
    }

    if idx == 12 {
        return html_wrap(rejoin(
            '<h1>Dictionaries</h1>',
            '<pre>person = {\n    "name": "Alice",\n    "age": 30,\n    "city": "NYC"\n}</pre>',
            '<h2>Access Values</h2>',
            '<pre>say(person["name"])   # Alice\nsay(person.city)      # NYC  (dot access)</pre>',
            '<h2>Modify</h2>',
            '<pre>dict_set(person, "email", "a@b.com")\nsay(str(dict_has_key(person, "phone")))  # false</pre>',
            '<h2>Iterate Keys</h2>',
            '<pre>for key in dict_keys(person) {\n    say(rejoin(key, " = ", str(person[key])))\n}</pre>'
        ))
    }

    if idx == 13 {
        return html_wrap(rejoin(
            '<h1>Error Handling (try / catch)</h1>',
            '<pre>try {\n    result = 10 / 0\n} catch err {\n    say(rejoin("Caught: ", err))\n}</pre>',
            '<p>The <code>err</code> variable holds the error message as a string.</p>',
            '<h2>Common Uses</h2>',
            '<ul><li>Division by zero</li><li>File not found</li><li>Invalid input</li></ul>',
            '<div class="info">💡 Syntax: <code>try { } catch err { }</code> — no <code>THEN</code> or <code>END TRY</code>.</div>'
        ))
    }

    if idx == 14 {
        return html_wrap(rejoin(
            '<h1>Your First GUI Window</h1>',
            '<pre>win = ui_window("My App", 400, 300)\nui_label(win, "Hello GUI!", 140, 120, 120, 30)\nui_mainloop(win)</pre>',
            '<h2>Widget Coordinates</h2>',
            '<p>All widgets use <b>absolute positioning</b>: <code>(x, y, width, height)</code></p>',
            '<ul><li><b>x, y</b> — pixels from top-left</li>',
            '<li><b>w, h</b> — size in pixels</li></ul>',
            '<h2>Common Widgets</h2>',
            '<table><tr><th>Widget</th><th>Function</th></tr>',
            '<tr><td>Label</td><td><code>ui_label(parent, text, x, y, w, h)</code></td></tr>',
            '<tr><td>Panel</td><td><code>ui_panel(parent, x, y, w, h)</code></td></tr>',
            '<tr><td>Button</td><td><code>ui_button(parent, text, "cb", x, y, w, h)</code></td></tr>',
            '<tr><td>Entry</td><td><code>ui_entry(parent, text, x, y, w, h)</code></td></tr></table>',
            '<div class="try">🚀 Click <b>▶ Run It!</b> — a real window will appear! Close it to return.</div>'
        ))
    }

    if idx == 15 {
        return html_wrap(rejoin(
            '<h1>Buttons &amp; Event Handlers</h1>',
            '<p>Buttons call a function by <b>name (as a string)</b> when clicked.</p>',
            '<pre>def on_click() {\n    ui_alert("Clicked!")\n}\n\nwin = ui_window("Events", 300, 150)\nui_button(win, "Click Me", "on_click", 90, 50, 120, 35)\nui_mainloop(win)</pre>',
            '<h2>Other Events with ui_bind()</h2>',
            '<pre>ui_bind(entry, "CHANGE", "on_change")\nui_bind(list, "SELECT", "on_select")</pre>',
            '<table><tr><th>Event</th><th>Fires When</th></tr>',
            '<tr><td>CLICK</td><td>Widget clicked</td></tr>',
            '<tr><td>CHANGE</td><td>Text changed</td></tr>',
            '<tr><td>SELECT</td><td>Item selected</td></tr>',
            '<tr><td>DOUBLE_CLICK</td><td>Double-clicked</td></tr></table>'
        ))
    }

    if idx == 16 {
        return html_wrap(rejoin(
            '<h1>Project: Build a Calculator</h1>',
            '<p>Combines everything: variables, functions, GUI, events, error handling.</p>',
            '<h2>Features</h2>',
            '<ul><li>Two number inputs</li>',
            '<li>Four operation buttons (+, −, ×, ÷)</li>',
            '<li>Result display with color feedback</li>',
            '<li>Division-by-zero protection</li></ul>',
            '<div class="try">🚀 Click <b>▶ Run It!</b> to launch the calculator. Enter numbers and click operations!</div>'
        ))
    }

    if idx == 17 {
        return html_wrap(rejoin(
            '<h1>Project: Build a Todo App</h1>',
            '<p>A complete task manager with a ListView.</p>',
            '<h2>Features</h2>',
            '<ul><li>Add tasks from a text entry</li>',
            '<li>Toggle done / not done</li>',
            '<li>Task counter</li>',
            '<li>Color-coded status</li></ul>',
            '<h2>Concepts Used</h2>',
            '<ul><li>Lists &amp; dictionaries for data</li>',
            '<li>ListView widget</li>',
            '<li>Event-driven architecture</li>',
            '<li>Dynamic UI updates</li></ul>',
            '<div class="try">🚀 Click <b>▶ Run It!</b> to launch the Todo App!</div>',
            '<div class="info">🎓 <b>Congratulations!</b> You have completed all 18 lessons. You can now build real desktop apps with AnikaLang 1.2!</div>'
        ))
    }

    return html_wrap('<h1>Lesson not found</h1>')
}

# ==============================================================================
# LESSON CODE (runnable AnikaLang 1.2)
# ==============================================================================

def get_lesson_code(idx) {

    if idx == 0 { return '# Welcome! Click "Next →" to start learning.' }

    if idx == 1 {
        return rejoin(
            '# Your first AnikaLang 1.2 program!\n',
            'say("Hello, World!")\n',
            'say("Welcome to AnikaLang 1.2!")\n',
            'say("Let us learn programming together!")\n',
            '\n',
            '# In real programs, use ui_alert() for popups:\n',
            '# ui_alert("Hello!")'
        )
    }

    if idx == 2 {
        return rejoin(
            'name = "Alice"\n',
            'age = 30\n',
            'height = 5.7\n',
            'active = true\n',
            '\n',
            'say(rejoin("Name: ", name))\n',
            'say(rejoin("Age: ", str(age)))\n',
            'say(rejoin("Height: ", str(height)))\n',
            'say(rejoin("Active: ", str(active)))\n',
            '\n',
            '# Reassignment\n',
            'age = 31\n',
            'say(rejoin("Next year age: ", str(age)))'
        )
    }

    if idx == 3 {
        return rejoin(
            'x = 42\n',
            'y = 3.14\n',
            's = "hello"\n',
            'b = true\n',
            'n = null\n',
            '\n',
            'say(rejoin("x is: ", type_of(x)))\n',
            'say(rejoin("y is: ", type_of(y)))\n',
            'say(rejoin("s is: ", type_of(s)))\n',
            'say(rejoin("b is: ", type_of(b)))\n',
            'say(rejoin("n is: ", type_of(n)))\n',
            '\n',
            '# Conversion\n',
            'say(rejoin("str(42) = ", str(42)))\n',
            'say(rejoin("int(3.9) = ", str(int(3.9))))\n',
            'say(rejoin("float(7) = ", str(float(7))))'
        )
    }

    if idx == 4 {
        return rejoin(
            'a = 10\n',
            'b = 3\n',
            '\n',
            'say(rejoin("Add:      ", str(a + b)))\n',
            'say(rejoin("Subtract: ", str(a - b)))\n',
            'say(rejoin("Multiply: ", str(a * b)))\n',
            'say(rejoin("Divide:   ", str(a / b)))\n',
            'say(rejoin("Power:    ", str(pow(2, 10))))\n',
            'say(rejoin("Sqrt:     ", str(sqrt(144))))\n',
            'say(rejoin("Pi:       ", str(pi())))\n',
            'say(rejoin("Abs:      ", str(abs(-7))))\n',
            'say(rejoin("Round:    ", str(round(3.14159, 2))))'
        )
    }

    if idx == 5 {
        return rejoin(
            'msg = "Hello, World!"\n',
            '\n',
            'say(rejoin("Original:  ", msg))\n',
            'say(rejoin("Length:    ", str(len(msg))))\n',
            'say(rejoin("Upper:     ", upper(msg)))\n',
            'say(rejoin("Lower:     ", lower(msg)))\n',
            'say(rejoin("Left 5:    ", left(msg, 5)))\n',
            'say(rejoin("Right 6:   ", right(msg, 6)))\n',
            'say(rejoin("Mid 7,5:   ", mid(msg, 7, 5)))\n',
            'say(rejoin("Replace:   ", replace(msg, "World", "AnikaLang")))\n',
            'say(rejoin("Trim:      [", trim("  padded  "), "]"))'
        )
    }

    if idx == 6 {
        return rejoin(
            'first = "Anika"\n',
            'last = "Lang"\n',
            'ver = 1.2\n',
            '\n',
            '# rejoin() — multiple parts\n',
            'full = rejoin(first, last, " v", str(ver))\n',
            'say(rejoin("rejoin: ", full))\n',
            '\n',
            '# + also works for strings\n',
            'greeting = "Hello, " + first + "!"\n',
            'say(rejoin("plus:   ", greeting))\n',
            '\n',
            '# Build a sentence\n',
            'score = 95\n',
            'total = 100\n',
            'report = rejoin("Score: ", str(score), " / ", str(total), " (", str(round(score / total * 100, 1)), "%)")\n',
            'say(report)'
        )
    }

    if idx == 7 {
        return rejoin(
            'score = 85\n',
            '\n',
            'if score >= 90 {\n',
            '    say("Grade: A")\n',
            '} else {\n',
            '    if score >= 80 {\n',
            '        say("Grade: B")\n',
            '    } else {\n',
            '        if score >= 70 {\n',
            '            say("Grade: C")\n',
            '        } else {\n',
            '            say("Grade: F")\n',
            '        }\n',
