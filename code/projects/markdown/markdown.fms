ui_color(status_words, "white", "#34495e")

status_chars = ui_label(statusbar_bg, "  Chars: 0  ", 700, 0, 150, 30)
ui_color(status_chars, "white", "#34495e")

status_info = ui_label(statusbar_bg, "  Markdown  |  UTF-8  ", 1100, 0, 300, 30)
ui_color(status_info, "#bdc3c7", "#34495e")

# --- BIND RESIZE EVENT ---
ui_bind(win, "resize", "on_window_resize")

# --- INITIALIZATION ---
load_sample()
ui_mainloop(win)