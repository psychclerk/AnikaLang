# ==============================================================================
# MARKDOWN EDITOR WITH LIVE PREVIEW - AnikaLang 1.2 Edition
# WITH DYNAMIC CLIENT-AREA SIZING
# ==============================================================================

# --- GLOBAL STATE ---
current_file = null
editor = null
preview = null
status_lines = null
status_words = null
status_chars = null
status_file = null
status_info = null
is_dirty = false

# Widget references for resize
editor_panel = null
preview_panel = null
editor_label_bg = null
preview_label_bg = null
divider = null
statusbar_bg = null
toolbar_bg = null
win = null

# Layout constants
TOOLBAR_H = 40
LABEL_H = 25
STATUSBAR_H = 30
BUFFER = 3

# ==============================================================================
# SAFE STRING HELPERS
# ==============================================================================

def str_find(text, search) {
    tlen = len(text)
    slen = len(search)
    if slen == 0 { return 0 }
    if slen > tlen { return -1 }
    i = 0
    while i <= tlen - slen {
        sub = left(right(text, tlen - i), slen)
        if sub == search { return i }
        i = i + 1
    }
    return -1
}

def str_sub(text, start, length) {
    n = len(text)
    if start < 0 { start = 0 }
    if start >= n { return "" }
    if length <= 0 { return "" }
    if start + length > n { length = n - start }
    return left(right(text, n - start), length)
}

def str_split(text, delim) {
    result = []
    dlen = len(delim)
    if dlen == 0 {
        list_append(result, text)
        return result
    }
    remaining = text
    while true {
        idx = str_find(remaining, delim)
        if idx == -1 {
            list_append(result, remaining)
            return result
        }
        piece = str_sub(remaining, 0, idx)
        list_append(result, piece)
        remaining = str_sub(remaining, idx + dlen, len(remaining) - idx - dlen)
    }
    return result
}

# ==============================================================================
# RESIZE HANDLER
# ==============================================================================

def on_window_resize(widget, new_w, new_h) {
    client_size = ui_get_client_size(win)
    actual_w = client_size[0]
    actual_h = client_size[1]
    
    content_y = TOOLBAR_H + LABEL_H
    content_h = actual_h - content_y - STATUSBAR_H - BUFFER
    half_w = actual_w / 2
    
    ui_pos(toolbar_bg, 0, 0, actual_w, TOOLBAR_H)
    
    ui_pos(editor_label_bg, 0, TOOLBAR_H, half_w, LABEL_H)
    ui_pos(preview_label_bg, half_w, TOOLBAR_H, half_w, LABEL_H)
    
    ui_pos(editor_panel, 0, content_y, half_w, content_h)
    ui_pos(editor, 0, 0, half_w, content_h)
    
    ui_pos(preview_panel, half_w, content_y, half_w, content_h)
    ui_pos(preview, 0, 0, half_w, content_h)
    
    ui_pos(divider, half_w - 2, content_y, 4, content_h)
    
    ui_pos(statusbar_bg, 0, actual_h - STATUSBAR_H, actual_w, STATUSBAR_H)
    
    ui_bring_to_front(statusbar_bg)
    ui_bring_to_front(status_file)
    ui_bring_to_front(status_lines)
    ui_bring_to_front(status_words)
    ui_bring_to_front(status_chars)
    ui_bring_to_front(status_info)
    
    ui_refresh(statusbar_bg)
    ui_refresh(win)
}

# ==============================================================================
# PREVIEW UPDATE
# ==============================================================================

def update_preview() {
    md_text = ui_text_get(editor)
    
    try {
        html_content = markdown_to_html(md_text, "fenced_code,tables,toc,nl2br")
        
        styled_html = "<!DOCTYPE html><html><head><style>"
        styled_html = rejoin(styled_html, "body { font-family: 'Segoe UI', sans-serif; padding: 20px; background: #ffffff; color: #2c3e50; line-height: 1.6; }")
        styled_html = rejoin(styled_html, "h1 { color: #2c3e50; border-bottom: 2px solid #3498db; padding-bottom: 10px; }")
        styled_html = rejoin(styled_html, "h2 { color: #34495e; border-bottom: 1px solid #bdc3c7; padding-bottom: 5px; }")
        styled_html = rejoin(styled_html, "h3 { color: #34495e; }")
        styled_html = rejoin(styled_html, "code { background: #f4f6f7; padding: 2px 6px; border-radius: 3px; font-family: 'Consolas', monospace; color: #c0392b; }")
        styled_html = rejoin(styled_html, "pre { background: #2c3e50; color: #ecf0f1; padding: 15px; border-radius: 5px; overflow-x: auto; }")
        styled_html = rejoin(styled_html, "pre code { background: transparent; color: #ecf0f1; padding: 0; }")
        styled_html = rejoin(styled_html, "blockquote { border-left: 4px solid #3498db; margin: 15px 0; padding: 10px 20px; background: #f8f9fa; color: #555; }")
        styled_html = rejoin(styled_html, "table { border-collapse: collapse; width: 100%; margin: 15px 0; }")
        styled_html = rejoin(styled_html, "th, td { border: 1px solid #bdc3c7; padding: 8px 12px; text-align: left; }")
        styled_html = rejoin(styled_html, "th { background: #3498db; color: white; }")
        styled_html = rejoin(styled_html, "tr:nth-child(even) { background: #f8f9fa; }")
        styled_html = rejoin(styled_html, "a { color: #3498db; text-decoration: none; }")
        styled_html = rejoin(styled_html, "a:hover { text-decoration: underline; }")
        styled_html = rejoin(styled_html, "ul, ol { padding-left: 25px; }")
        styled_html = rejoin(styled_html, "li { margin: 5px 0; }")
        styled_html = rejoin(styled_html, "hr { border: none; border-top: 2px solid #bdc3c7; margin: 20px 0; }")
        styled_html = rejoin(styled_html, "img { max-width: 100%; height: auto; }")
        styled_html = rejoin(styled_html, "</style></head><body>")
        styled_html = rejoin(styled_html, html_content)
        styled_html = rejoin(styled_html, "</body></html>")
        
        ui_html_set(preview, styled_html)
    } catch err {
        err_html = rejoin("<html><body style='padding:20px;font-family:Segoe UI;'><h2 style='color:#c0392b;'>Preview Error</h2><p>", err, "</p></body></html>")
        ui_html_set(preview, err_html)
    }
    
    update_status()
}

def update_status() {
    text = ui_text_get(editor)
    lines = 1
    chars = len(text)
    words = 0
    
    i = 0
    while i < chars {
        ch = str_sub(text, i, 1)
        if ch == "\n" {
            lines = lines + 1
        }
        i = i + 1
    }
    
    trimmed = trim(text)
    if len(trimmed) > 0 {
        parts = str_split(trimmed, " ")
        words = len(parts)
    }
    
    ui_set(status_lines, rejoin("  Lines: ", str(lines)))
    ui_set(status_words, rejoin("  Words: ", str(words)))
    ui_set(status_chars, rejoin("  Chars: ", str(chars)))
}

# ==============================================================================
# FILE OPERATIONS
# ==============================================================================

def do_new() {
    sample = "# Welcome to Markdown Editor\n\n"
    sample = rejoin(sample, "Start writing your markdown here. The preview will update automatically.\n\n")
    sample = rejoin(sample, "## Features\n\n")
    sample = rejoin(sample, "- **Bold text** and *italic text*\n")
    sample = rejoin(sample, "- Lists (ordered and unordered)\n")
    sample = rejoin(sample, "- `Inline code`\n")
    sample = rejoin(sample, "- [Links](https://example.com)\n\n")
    
    ui_text_set(editor, sample)
    current_file = null
    is_dirty = false
    ui_set(status_file, "  New Document")
    update_preview()
}

def do_open() {
    # ui_file_open automatically reads and populates the editor if a widget is passed
    path = ui_file_open(editor)
    if path != "" {
        current_file = path
        is_dirty = false
        ui_set(status_file, rejoin("  ", path_file(path)))
        update_preview()
    }
}

def do_save() {
    if current_file == null {
        do_save_as()
        return
    }
    
    content = ui_text_get(editor)
    result = file_write(current_file, content)
    if result == "SUCCESS" {
        is_dirty = false
        ui_alert(rejoin("Saved: ", path_file(current_file)))
    } else {
        ui_alert_err(rejoin("Failed to save: ", result))
    }
}

def do_save_as() {
    path = ui_file_save(null)
    if path == "" { return }
    
    if lower(path_ext(path)) != ".md" {
        path = rejoin(path, ".md")
    }
    
    content = ui_text_get(editor)
    result = file_write(path, content)
    if result == "SUCCESS" {
        current_file = path
        is_dirty = false
        ui_set(status_file, rejoin("  ", path_file(path)))
        ui_alert(rejoin("Saved: ", path_file(path)))
    } else {
        ui_alert_err(rejoin("Failed to save: ", result))
    }
}

def do_export_html() {
    path = ui_file_save(null)
    if path == "" { return }
    
    if lower(path_ext(path)) != ".html" {
        path = rejoin(path, ".html")
    }
    
    md_text = ui_text_get(editor)
    try {
        html_content = markdown_to_html(md_text, "fenced_code,tables,toc,nl2br")
        full_html = "<!DOCTYPE html>\n<html>\n<head>\n"
        full_html = rejoin(full_html, "<meta charset='utf-8'>\n")
        full_html = rejoin(full_html, "<title>Markdown Export</title>\n")
        full_html = rejoin(full_html, "<style>\n")
        full_html = rejoin(full_html, "body { font-family: 'Segoe UI', sans-serif; max-width: 900px; margin: 40px auto; padding: 20px; line-height: 1.6; }\n")
        full_html = rejoin(full_html, "pre { background: #f4f4f4; padding: 15px; border-radius: 5px; }\n")
        full_html = rejoin(full_html, "code { background: #f4f4f4; padding: 2px 6px; }\n")
        full_html = rejoin(full_html, "table { border-collapse: collapse; width: 100%; }\n")
        full_html = rejoin(full_html, "th, td { border: 1px solid #ddd; padding: 8px; }\n")
        full_html = rejoin(full_html, "th { background: #4a90e2; color: white; }\n")
        full_html = rejoin(full_html, "</style>\n</head>\n<body>\n")
        full_html = rejoin(full_html, html_content)
        full_html = rejoin(full_html, "\n</body>\n</html>")
        
        result = file_write(path, full_html)
        if result == "SUCCESS" {
            ui_alert(rejoin("HTML exported to: ", path_file(path)))
        } else {
            ui_alert_err(rejoin("Failed to export: ", result))
        }
    } catch err {
        ui_alert_err(rejoin("Export failed: ", err))
    }
}

def do_export_pdf() {
    path = ui_file_save(null)
    if path == "" { return }
    
    if lower(path_ext(path)) != ".pdf" {
        path = rejoin(path, ".pdf")
    }
    
    md_text = ui_text_get(editor)
    try {
        html_content = markdown_to_html(md_text, "fenced_code,tables,toc,nl2br")
        styled_html = rejoin("<html><body style='font-family:Segoe UI;padding:20px;'>", html_content, "</body></html>")
        
        result = export_pdf(styled_html, path)
        ui_alert(rejoin("PDF export result: ", result))
    } catch err {
        ui_alert_err(rejoin("PDF export failed: ", err))
    }
}

def do_copy_html() {
    md_text = ui_text_get(editor)
    try {
        html_content = markdown_to_html(md_text, "fenced_code,tables,toc,nl2br")
        clipboard_set(html_content)
        ui_alert("HTML copied to clipboard")
    } catch err {
        ui_alert_err(rejoin("Failed: ", err))
    }
}

# ==============================================================================
# TOOLBAR ACTIONS
# ==============================================================================

def insert_bold() {
    sel = ui_text_get_selection(editor)
    if len(sel) > 0 {
        ui_text_replace_selected(editor, rejoin("**", sel, "**"))
    } else {
        ui_text_insert_at_cursor(editor, "****")
    }
    ui_focus(editor)
}

def insert_italic() {
    sel = ui_text_get_selection(editor)
    if len(sel) > 0 {
        ui_text_replace_selected(editor, rejoin("*", sel, "*"))
    } else {
        ui_text_insert_at_cursor(editor, "**")
    }
    ui_focus(editor)
}

def insert_code() {
    sel = ui_text_get_selection(editor)
    if len(sel) > 0 {
        ui_text_replace_selected(editor, rejoin("`", sel, "`"))
    } else {
        ui_text_insert_at_cursor(editor, "``")
    }
    ui_focus(editor)
}

def insert_strikethrough() {
    sel = ui_text_get_selection(editor)
    if len(sel) > 0 {
        ui_text_replace_selected(editor, rejoin("~~", sel, "~~"))
    } else {
        ui_text_insert_at_cursor(editor, "~~~~")
    }
    ui_focus(editor)
}

def insert_heading() {
    ui_text_insert_at_cursor(editor, "## ")
    ui_focus(editor)
}

def insert_link() {
    sel = ui_text_get_selection(editor)
    if len(sel) > 0 {
        ui_text_replace_selected(editor, rejoin("[", sel, "](url)"))
    } else {
        ui_text_insert_at_cursor(editor, "[text](url)")
    }
    ui_focus(editor)
}

def insert_list() {
    ui_text_insert_at_cursor(editor, "- ")
    ui_focus(editor)
}

def insert_hr() {
    ui_text_insert_at_cursor(editor, "\n---\n")
    ui_focus(editor)
}

def insert_table() {
    table = "| Column 1 | Column 2 | Column 3 |\n"
    table = rejoin(table, "|----------|----------|----------|\n")
    table = rejoin(table, "| Cell 1   | Cell 2   | Cell 3   |\n")
    table = rejoin(table, "| Cell 4   | Cell 5   | Cell 6   |\n")
    ui_text_insert_at_cursor(editor, table)
    ui_focus(editor)
}

