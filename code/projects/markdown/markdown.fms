def load_sample() {
    sample = "# Markdown Editor\n\n"
    sample = rejoin(sample, "Welcome to the **AnikaLang Markdown Editor** with *live preview*!\n\n")
    sample = rejoin(sample, "## Features\n\n")
    sample = rejoin(sample, "This editor supports all standard Markdown syntax:\n\n")
    sample = rejoin(sample, "### Text Formatting\n\n")
    sample = rejoin(sample, "- **Bold text** using double asterisks\n")
    sample = rejoin(sample, "- *Italic text* using single asterisks\n")
    sample = rejoin(sample, "- `Inline code` using backticks\n")
    sample = rejoin(sample, "- ~~Strikethrough~~ using double tildes\n\n")
    sample = rejoin(sample, "### Lists\n\n")
    sample = rejoin(sample, "**Unordered list:**\n")
    sample = rejoin(sample, "- First item\n")
    sample = rejoin(sample, "- Second item\n")
    sample = rejoin(sample, "  - Nested item\n")
    sample = rejoin(sample, "  - Another nested item\n")
    sample = rejoin(sample, "- Third item\n\n")
    sample = rejoin(sample, "**Ordered list:**\n")
    sample = rejoin(sample, "1. First step\n")
    sample = rejoin(sample, "2. Second step\n")
    sample = rejoin(sample, "3. Third step\n\n")
    sample = rejoin(sample, "### Code Blocks\n\n")
    sample = rejoin(sample, "```python\n")
    sample = rejoin(sample, "def hello():\n")
    sample = rejoin(sample, "    print('Hello, World!')\n")
    sample = rejoin(sample, "```\n\n")
    sample = rejoin(sample, "### Links & Images\n\n")
    sample = rejoin(sample, "[Visit Example](https://example.com)\n\n")
    sample = rejoin(sample, "### Blockquotes\n\n")
    sample = rejoin(sample, "> This is a blockquote.\n")
    sample = rejoin(sample, "> It can span multiple lines.\n\n")
    sample = rejoin(sample, "### Tables\n\n")
    sample = rejoin(sample, "| Feature | Status | Notes |\n")
    sample = rejoin(sample, "|---------|--------|-------|\n")
    sample = rejoin(sample, "| Headers | ✓ | H1-H6 supported |\n")
    sample = rejoin(sample, "| Lists | ✓ | Ordered & unordered |\n")
    sample = rejoin(sample, "| Code | ✓ | Inline & blocks |\n")
    sample = rejoin(sample, "| Tables | ✓ | With alignment |\n")
    sample = rejoin(sample, "| Links | ✓ | Auto-linked |\n\n")
    sample = rejoin(sample, "### Horizontal Rule\n\n")
    sample = rejoin(sample, "---\n\n")
    sample = rejoin(sample, "## Getting Started\n\n")
    sample = rejoin(sample, "1. Edit markdown in the **left pane**\n")
    sample = rejoin(sample, "2. See the rendered preview in the **right pane**\n")
    sample = rejoin(sample, "3. Use the toolbar for quick formatting\n")
    sample = rejoin(sample, "4. Save as `.md`, export as `.html` or `.pdf`\n\n")
    sample = rejoin(sample, "**Happy writing!** ✨\n")
    
    ui_text_set(editor, sample)
    update_preview()
}

