def show_about() {
    about_text = rejoin("Markdown Editor v1.0\n\nAnikaLang wxPython Edition\n\n",
        "Features:\n",
        "• Live preview with styled rendering\n",
        "• Full Markdown syntax support\n",
        "• Export to HTML and PDF\n",
        "• Formatting toolbar\n",
        "• Word/line/character count\n",
        "• Responsive resize support\n\n",
        "Built with AnikaLang")
    ui_alert(about_text)
}

def exit_app() {
    ui_close(win)
}

