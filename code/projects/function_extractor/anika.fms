# ==============================================================================
# Magic Happy Box for Anika ✨
# Run: python anika.py happy_anika.fms
# ==============================================================================

# --- Global State ---
win = null
bgPanel = null
messageLbl = null
msgIndex = 0
colorIndex = 0

# Sweet messages for Anika
messages = []
list_append(messages, "You are smarter than you know! 🌟")
list_append(messages, "Your smile lights up the whole world! ☀️")
list_append(messages, "You are kind, brave, and absolutely wonderful! 💖")
list_append(messages, "Today is going to be a great day because you are in it! 🌈")
list_append(messages, "You are a magic star, Anika! ✨")
list_append(messages, "I love you to the moon and back! 🌙")
list_append(messages, "You make everything more fun! 🎈")
list_append(messages, "Believe in yourself, you can do anything! 🦋")

# Pretty, soft colors
colors = []
list_append(colors, "#FFB6C1") # Light Pink
list_append(colors, "#E6E6FA") # Lavender
list_append(colors, "#FFFACD") # Lemon Chiffon
list_append(colors, "#98FB98") # Pale Green
list_append(colors, "#87CEFA") # Light Sky Blue
list_append(colors, "#FFDAB9") # Peach Puff

# ==============================================================================
# App Logic
# ==============================================================================

def showMagicMessage() {
    # Cycle to the next message
    msgIndex = msgIndex + 1
    if msgIndex >= len(messages) {
        msgIndex = 0
    }
    
    # Update the label
    ui_set(messageLbl, messages[msgIndex])
    
    # Also trigger a color change for extra magic!
    changeColor()
}

def changeColor() {
    # Cycle to the next color
    colorIndex = colorIndex + 1
    if colorIndex >= len(colors) {
        colorIndex = 0
    }
    
    # Apply the new background color
    ui_color(bgPanel, "", colors[colorIndex])
}

def showBigLove() {
    ui_set(messageLbl, "YOU ARE THE BEST, ANIKA! 👑💖✨")
    ui_color(bgPanel, "", "#FF69B4") # Hot Pink for maximum excitement!
}

# ==============================================================================
# UI Layout & Initialization
# ==============================================================================

# Create a nicely sized window
win = ui_window("Magic Happy Box for Anika ✨", 600, 500)

# Main background panel
bgPanel = ui_panel(win, 0, 0, 600, 500)
ui_color(bgPanel, "", colors[0]) # Start with Light Pink

# A nice title at the top
titleLbl = ui_label(bgPanel, "✨ Magic Happy Box ✨", 0, 30, 600, 50)
ui_color(titleLbl, "#FFFFFF", "") # White text
# ui_font(titleLbl, 24, "Comic Sans MS") # Playful font

# The main message label (large and centered-ish)
messageLbl = ui_label(bgPanel, messages[0], 40, 120, 520, 100)
ui_color(messageLbl, "#2C3E50", "") # Dark blue-gray text for readability
# ui_font(messageLbl, 20, "Arial")

# Big, friendly Magic Button
magicBtn = ui_button(bgPanel, "✨ Click for Magic! ✨", "showMagicMessage", 150, 260, 300, 60)
ui_color(magicBtn, "#FFFFFF", "#9B59B6") # White text, Purple button
#  ui_font(magicBtn, 18, "Arial")

# Secondary Color Button
colorBtn = ui_button(bgPanel, "🎨 Change Color", "changeColor", 150, 340, 300, 50)
ui_color(colorBtn, "#FFFFFF", "#3498DB") # White text, Blue button
# ui_font(colorBtn, 16, "Arial")

# A special "Big Love" button at the bottom
loveBtn = ui_button(bgPanel, "💖 Special Message from Dad 💖", "showBigLove", 120, 420, 360, 50)
ui_color(loveBtn, "#FFFFFF", "#E74C3C") # White text, Red button
# ui_font(loveBtn, 16, "Arial")

# Start the app!
ui_mainloop(win)