welcome_html = rejoin(welcome_html, "<h1 style='color:#2c3e50;'>Welcome to Axelrod's Tournament</h1>")
welcome_html = rejoin(welcome_html, "<p style='font-size:14px;color:#555;line-height:1.8;'>")
welcome_html = rejoin(welcome_html, "In the Prisoner's Dilemma, two players simultaneously choose to <b>Cooperate</b> or <b>Defect</b>.<br>")
welcome_html = rejoin(welcome_html, "The payoff matrix rewards mutual cooperation (3,3), punishes mutual defection (1,1),<br>")
welcome_html = rejoin(welcome_html, "and tempts defection against cooperation (5,0 vs 0,5).<br><br>")
welcome_html = rejoin(welcome_html, "Robert Axelrod's famous tournament (1980s) showed that <b>Tit-for-Tat</b> — a simple,<br>")
