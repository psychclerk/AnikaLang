ui_color(sbFile, "#ffffff", "#2c3e50")
sbSaved = ui_label(statusbarBg, "  ✓ Saved  ", 200, 0, 100, statusbarH)
ui_color(sbSaved, "#ffffff", "#2c3e50")
sbCursor = ui_label(statusbarBg, "  Ln 1:1  ", 300, 0, 100, statusbarH)
ui_color(sbCursor, "#ffffff", "#2c3e50")
sbLines = ui_label(statusbarBg, "  Lines: 0  ", 400, 0, 100, statusbarH)
ui_color(sbLines, "#ffffff", "#2c3e50")
sbEncoding = ui_label(statusbarBg, "  UTF-8  ", 500, 0, 80, statusbarH)
ui_color(sbEncoding, "#ffffff", "#2c3e50")
sbLanguage = ui_label(statusbarBg, "  AnikaLang  ", 580, 0, 100, statusbarH)
ui_color(sbLanguage, "#ffffff", "#2c3e50")
sbClock = ui_label(statusbarBg, "   --:--:--  ", 680, 0, 120, statusbarH)
ui_color(sbClock, "#ffffff", "#2c3e50")

msgW = cw - 800
if msgW < 100 { msgW = 100 }
sbMessage = ui_label(statusbarBg, "  Ready  ", 800, 0, msgW, statusbarH)
ui_color(sbMessage, "#ffffff", "#2c3e50")

ui_bind(win, "resize", "onWindowResize")

# Initialize with one empty file
newFile()
startClock()

ui_mainloop(win)