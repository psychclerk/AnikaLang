# ==============================================================================
# AnikaLang Professional Editor IDE v8.1 (Index-Based Tab Management)
# Run: python anika.py idetabs.fms
# ==============================================================================

# --- Global State ---
editorTabs = null
openEditors = []
openFilePaths = []
openDirty = []
activeEditor = null
activeTabIndex = 0
currentFilePath = null 

findReplacePopup = null
isDirty = false

# Find/Replace State
findEntry = null
replaceEntry = null
findStatusLbl = null

# --- Statusbar References ---
sbFile = null
sbSaved = null
sbCursor = null
sbLines = null
sbEncoding = null
sbLanguage = null
sbMessage = null
sbClock = null

# --- Layout Widget References ---
toolbarBg = null
navLabel = null
funcSearchEntry = null
funcList = null
statusbarBg = null
clockTimerId = null
ctxMenu = null

# ==============================================================================
# Resize Handler
# ==============================================================================

def onWindowResize(widget, newW, newH) {
    clientSize = ui_get_client_size(win)
    cw = clientSize[0]
    ch = clientSize[1]
    
    toolbarH = 40
    statusbarH = 30
    navW = 350
    gap = 20
    searchH = 25
    
    contentY = toolbarH
    contentH = ch - toolbarH - statusbarH
    editorW = cw - navW - gap
    navX = cw - navW
    sbY = ch - statusbarH
    
    if contentH < 100 { contentH = 100 }
    if editorW < 200 { editorW = 200 }
    
    ui_pos(toolbarBg, 0, 0, cw, toolbarH)
    ui_pos(editorTabs, 0, contentY, editorW, contentH)
    
    # Resize all open editors to fit the new tab size
    i = 0
    while i < len(openEditors) {
        ui_pos(openEditors[i], 0, 0, editorW, contentH)
        i = i + 1
    }
    
    ui_pos(navLabel, navX, contentY + 5, navW, 25)
    ui_pos(funcSearchEntry, navX, contentY + 35, navW, searchH)
    ui_pos(funcList, navX, contentY + 35 + searchH + 5, navW, contentH - 35 - searchH - 5)
    
    ui_pos(statusbarBg, 0, sbY, cw, statusbarH)
    
    msgW = cw - 800
    if msgW < 100 { msgW = 100 }
    ui_pos(sbMessage, 800, 0, msgW, statusbarH)
    
    ui_refresh(win)
}

# ==============================================================================
# Clock & Statusbar Helpers
# ==============================================================================

def updateClock() {
    nowStr = now()
    timePart = right(nowStr, 8)
    ui_set(sbClock, "   " + timePart + "  ")
    clockTimerId = ui_after(1000, "updateClock")
}

def startClock() { updateClock() }

def sbUpdateFile() {
    if currentFilePath == null {
        # ✅ FIX: Use index-based title retrieval
        tabName = ui_tab_get_title(editorTabs, activeTabIndex)
        ui_set(sbFile, rejoin("  📄 ", tabName, ".fms"))
    } else {
        fname = path_file(currentFilePath)
        ui_set(sbFile, rejoin("   ", fname))
    }
}

def sbUpdateSaved() {
    if isDirty == true {
        ui_set(sbSaved, "  ● Modified ")
    } else {
        ui_set(sbSaved, "  ✓ Saved ")
    }
}

def sbUpdateCursor() {
    if activeEditor == null { return }
    try {
        pos = ui_editor_get_cursor(activeEditor)
        ui_set(sbCursor, rejoin("  Ln ", pos, "  "))
    } catch err {
        ui_set(sbCursor, "  Ln 1:1  ")
    }
}

def sbUpdateLines() {
    if activeEditor == null { return }
    count = ui_editor_get_line_count(activeEditor)
    ui_set(sbLines, rejoin("  Lines: ", count))
}

def sbSetMessage(msg) { ui_set(sbMessage, rejoin("  ", msg)) }
def sbSetError(msg) { ui_set(sbMessage, rejoin("   ", msg)) }
def sbSetSuccess(msg) { ui_set(sbMessage, rejoin("  ✓ ", msg)) }
def sbSetInfo(msg) { ui_set(sbMessage, rejoin("  ℹ ", msg)) }

def markDirty() {
    if activeTabIndex >= 0 {
        list_set(openDirty, activeTabIndex, true)
        isDirty = true
        
        # ✅ FIX: Update tab title with dirty indicator using index
        currentTitle = ui_tab_get_title(editorTabs, activeTabIndex)
        if ends_with(currentTitle, "*") == false {
            ui_tab_set_title(editorTabs, rejoin(currentTitle, "*"), activeTabIndex)
        }
        
        sbUpdateSaved()
    }
}

def markSaved() {
    if activeTabIndex >= 0 {
        list_set(openDirty, activeTabIndex, false)
        isDirty = false
        
        # ✅ FIX: Remove dirty indicator from tab title using index
        currentTitle = ui_tab_get_title(editorTabs, activeTabIndex)
        cleanTitle = replace(currentTitle, "*", "")
        ui_tab_set_title(editorTabs, cleanTitle, activeTabIndex)
        
        sbUpdateSaved()
    }
}

def onEditorChange() {
    markDirty()
    sbUpdateCursor()
    sbUpdateLines()
    refreshFunctions()
}

def onCursorMove() { sbUpdateCursor() }

# ==============================================================================
# Tab Management (INDEX-BASED)
# ==============================================================================

def onTabChange() {
    # ✅ FIX: Get index directly instead of searching by name
    idx = ui_tab_get_index(editorTabs)
    
    if idx >= 0 and idx < len(openEditors) {
        activeTabIndex = idx
        activeEditor = openEditors[idx]
        currentFilePath = openFilePaths[idx]
        isDirty = openDirty[idx]
        
        sbUpdateFile()
        sbUpdateSaved()
        sbUpdateCursor()
        sbUpdateLines()
        
        # Force clear the list view before refreshing to prevent ghost entries
        ui_listview_clear(funcList)
        refreshFunctions()
    }
}

# ==============================================================================
# File Operations
# ==============================================================================

def newFile() {
    # Generate a unique "UntitledX" name
    counter = 1
    tabName = rejoin("Untitled", counter)
    isTaken = true
    
    while isTaken == true {
        isTaken = false
        i = 0
        while i < len(openEditors) {
            # Check against actual tab titles for uniqueness
            if ui_tab_get_title(editorTabs, i) == tabName {
                isTaken = true
            }
            i = i + 1
        }
        if isTaken == true {
            counter = counter + 1
            tabName = rejoin("Untitled", counter)
        }
    }
    
    tabHandle = ui_tab_add(editorTabs, tabName)
    
    editor = ui_code_editor(tabHandle, 0, 0, editorW, contentH)
    list_append(openEditors, editor)
    list_append(openFilePaths, null)
    list_append(openDirty, false)
    
    activeTabIndex = len(openEditors) - 1
    activeEditor = editor
    currentFilePath = null
    
    # ✅ FIX: Select by index
    ui_tab_select(editorTabs, activeTabIndex)
    
    ui_text_set(activeEditor, "# New AnikaLang Script\n\ndef main() {\n    win = ui_window('My App')\n    ui_mainloop(win)\n}\nmain() \n")
    
    ui_bind_popup(activeEditor, ctxMenu)
    ui_bind(activeEditor, "change", "onEditorChange")
    ui_bind(activeEditor, "cursor_move", "onCursorMove")
    
    sbUpdateFile()
    sbUpdateCursor()
    sbUpdateLines()
    sbSetInfo(rejoin("New file created: ", tabName))
    refreshFunctions()
}

def openFile() {
    path = ui_file_open(null)
    if path != "" {
        tabName = path_file(path)
        
        # ✅ FIX: Check if file is already open using index iteration
        isAlreadyOpen = false
        existingIdx = -1
        i = 0
        while i < len(openEditors) {
            if ui_tab_get_title(editorTabs, i) == tabName {
                isAlreadyOpen = true
                existingIdx = i
            }
            i = i + 1
        }
        
        if isAlreadyOpen == true {
            sbSetError(rejoin("File is already open: ", tabName))
            # ✅ FIX: Switch to existing tab by index
            ui_tab_select(editorTabs, existingIdx) 
            return
        }
        
        content = file_read(path)
        if starts_with(content, "ERROR") {
            sbSetError("Failed to read file")
            return
        }
        
        tabHandle = ui_tab_add(editorTabs, tabName)
                
        editor = ui_code_editor(tabHandle, 0, 0, editorW, contentH)
        list_append(openEditors, editor)
        list_append(openFilePaths, path)
        list_append(openDirty, false)
        
        activeTabIndex = len(openEditors) - 1
        activeEditor = editor
        currentFilePath = path
        
        # ✅ FIX: Select by index
        ui_tab_select(editorTabs, activeTabIndex)
        ui_text_set(activeEditor, content)
        ui_highlight(activeEditor)
        
        ui_bind_popup(activeEditor, ctxMenu)
        ui_bind(activeEditor, "change", "onEditorChange")
        ui_bind(activeEditor, "cursor_move", "onCursorMove")
        
        markSaved()
        sbUpdateFile()
        sbUpdateCursor()
        sbUpdateLines()
        refreshFunctions()
        sbSetSuccess(rejoin("Opened: ", tabName))
    }
}

def saveFile() {
    if activeEditor == null { return }
    
    if currentFilePath == null {
        path = ui_file_save(null)
        if path != "" {
            currentFilePath = path
            list_set(openFilePaths, activeTabIndex, path)
            content = ui_text_get(activeEditor)
            file_write(currentFilePath, content)
            
            # ✅ FIX: Update tab title dynamically using index
            ui_tab_set_title(editorTabs, path_file(path), activeTabIndex)
            
            markSaved()
            sbUpdateFile()
            sbSetSuccess(rejoin("Saved: ", path_file(path)))
        }
    } else {
        content = ui_text_get(activeEditor)
        file_write(currentFilePath, content)
        
        # ✅ FIX: Update tab title even when overwriting existing file
        ui_tab_set_title(editorTabs, path_file(currentFilePath), activeTabIndex)
        
        markSaved()
        sbSetSuccess(rejoin("Saved: ", path_file(currentFilePath)))
    }
}

def closeFile() {
    if activeEditor == null { return }
    
    # ✅ FIX: Get tab name safely by index before removal
    tabName = ui_tab_get_title(editorTabs, activeTabIndex)
    
    # Handle unsaved changes
    if isDirty == true {
        choice = ui_alert_yes_no(rejoin("Save changes to ", tabName, " before closing?"))
        if choice == "cancel" { return }
        if choice == "yes" {
            saveFile()
            if isDirty == true { return }
        }
    }
    
    # Remove from tracking lists FIRST
    list_remove(openEditors, activeTabIndex)
    list_remove(openFilePaths, activeTabIndex)
    list_remove(openDirty, activeTabIndex)
    
    # Remove the tab from the UI widget
    ui_tab_remove(editorTabs, activeTabIndex)
    
    # If no tabs are left, create a new blank one
    if len(openEditors) == 0 {
        newFile()
        return
    }
    
    # Adjust the active index if we closed the last tab in the list
    if activeTabIndex >= len(openEditors) {
        activeTabIndex = len(openEditors) - 1
    }
    
    # Update global state to the new active tab
    activeEditor = openEditors[activeTabIndex]
    currentFilePath = openFilePaths[activeTabIndex]
    isDirty = openDirty[activeTabIndex]
    
    # ✅ FIX: Visually select the new active tab by index
    ui_tab_select(editorTabs, activeTabIndex)
    
    # Refresh UI
    sbUpdateFile()
    sbUpdateSaved()
    sbUpdateCursor()
    sbUpdateLines()
    refreshFunctions()
    sbSetInfo(rejoin("Closed: ", tabName))
}

def runCode() {
    if activeEditor == null { return }
    
    if isDirty == true {
        if currentFilePath != null {
            content = ui_text_get(activeEditor)
            file_write(currentFilePath, content)
            markSaved()
        }
    }
    
    codeText = ui_text_get(activeEditor)
    projectDir = ""
    
    if currentFilePath != null {
        projectDir = path_dir(currentFilePath)
    } else {
        projectDir = path_cwd()
    }
    
    tempPath = path_join(projectDir, "temp_run.fms")
    file_write(tempPath, codeText)
    
    interp = interpreter_path()
    isExe = false
    ext = path_ext(interp)
    
    if lower(ext) == ".exe" { isExe = true }
    
    sbSetInfo("Running...")
    
    if isExe == true {
        exec(rejoin(interp, " ", tempPath))
    } else {
        exePath = replace(interp, ".py", ".exe")
        if file_exists(exePath) {
            exec(rejoin(exePath, " ", tempPath))
        } else {
            exec(rejoin("python ", interp, " ", tempPath))
        }
    }
    
    sbSetSuccess(rejoin("Run completed: ", path_file(tempPath)))
}

def exitApp() { ui_close(win) }

def applyHighlight() {
    if activeEditor == null { return }
    ui_highlight(activeEditor)
    refreshFunctions()
    sbSetInfo("Syntax highlighted")
}

def refreshFunctions() {
    if activeEditor == null { return }
    
    searchText = ""
    if funcSearchEntry != null {
        searchText = lower(ui_get(funcSearchEntry))
    }
    
    ui_listview_clear(funcList)
    funcs = ui_editor_get_functions(activeEditor)
    
    for f in funcs {
        funcName = lower(f[1])
        if searchText == "" or contains(funcName, searchText) {
            ui_listview_insert(funcList, [f[0], f[1]])
        }
    }
    sbUpdateLines()
    
    # Force the list view to repaint immediately
    ui_refresh(funcList)
}

def onFuncSearchChange() { refreshFunctions() }

def onFunctionClick(widget) {
    if activeEditor == null { return }
    selected = ui_listview_get_selected(funcList)
    if selected != null {
        lineNum = selected[0]
        ui_editor_goto_line(activeEditor, lineNum)
        sbUpdateCursor()
        sbSetInfo(rejoin("Jumped to line ", lineNum))
    }
}

# ==============================================================================
# Edit Operations
# ==============================================================================

def doCut() {
    if activeEditor == null { return }
    selected = ui_text_get_selection(activeEditor)
    if len(selected) == 0 { 
        sbSetError("Nothing selected to cut")
        return 
    }
    clipboard_set(selected)
    ui_text_delete_selection(activeEditor)
    markDirty()
    sbUpdateCursor()
    sbSetMessage(rejoin("Cut ", len(selected), " characters"))
}

def doCopy() {
    if activeEditor == null { return }
    selected = ui_text_get_selection(activeEditor)
    if len(selected) == 0 { 
        sbSetError("Nothing selected to copy")
        return 
    }
    clipboard_set(selected)
    sbSetMessage(rejoin("Copied ", len(selected), " characters"))
}

def doPaste() {
    if activeEditor == null { return }
    clip = clipboard_get()
    if len(clip) == 0 { 
        sbSetError("Clipboard is empty")
        return 
    }
    ui_text_insert_at_cursor(activeEditor, clip)
    ui_highlight(activeEditor)
    markDirty()
    sbUpdateCursor()
    sbUpdateLines()
    sbSetMessage(rejoin("Pasted ", len(clip), " characters"))
}

def doSelectAll() {
    if activeEditor == null { return }
    ui_text_select_all(activeEditor)
    sbSetMessage("Selected all text")
}

# ==============================================================================
# Find & Replace
# ==============================================================================

def openFindReplace() {
    if findReplacePopup != null { ui_close(findReplacePopup) }
    findReplacePopup = ui_popup("Find & Replace", 540, 400)
    
    frHeader = ui_panel(findReplacePopup, 0, 0, 520, 40)
    ui_color(frHeader, "", "#2c3e50")
    frTitle = ui_label(frHeader, "   Find & Replace", 0, 8, 300, 25)
    ui_color(frTitle, "#ffffff", "")
    
    findLbl = ui_label(findReplacePopup, "Find what:", 20, 55, 90, 25)
    ui_color(findLbl, "#2c3e50", "")
    findEntry = ui_entry(findReplacePopup, "", 115, 53, 385, 28)
    
    replaceLbl = ui_label(findReplacePopup, "Replace with:", 20, 95, 90, 25)
    ui_color(replaceLbl, "#2c3e50", "")
    replaceEntry = ui_entry(findReplacePopup, "", 115, 93, 385, 28)
    
    findCaseCb = ui_checkbox(findReplacePopup, "Match case", 20, 135, 130, 25)
    findWordCb = ui_checkbox(findReplacePopup, "Whole word", 160, 135, 130, 25)
    findWrapCb = ui_checkbox(findReplacePopup, "Wrap around", 300, 135, 130, 25)
    ui_checkbox_set(findWrapCb, true)
    
    frSep = ui_panel(findReplacePopup, 20, 170, 480, 2)
    ui_color(frSep, "", "#dcdde1")
    
    btnFind = ui_button(findReplacePopup, "Find Next", "doFindNext", 20, 185, 145, 32)
    ui_color(btnFind, "#ffffff", "#3498db")
    btnReplace = ui_button(findReplacePopup, "Replace", "doReplace", 175, 185, 145, 32)
    ui_color(btnReplace, "#ffffff", "#16a085")
    btnReplaceAll = ui_button(findReplacePopup, "Replace All", "doReplaceAll", 330, 185, 170, 32)
    ui_color(btnReplaceAll, "#ffffff", "#8e44ad")
    
    findStatusLbl = ui_label(findReplacePopup, "  Ready", 20, 230, 480, 25)
    ui_color(findStatusLbl, "#7f8c8d", "")
    
    btnCloseFr = ui_button(findReplacePopup, "Close", "closeFindReplace", 400, 270, 100, 30)
    ui_color(btnCloseFr, "#ffffff", "#95a5a6")
    
    ui_set(findEntry, "")
    ui_focus(findEntry)
}

def closeFindReplace() {
    if findReplacePopup != null {
        ui_close(findReplacePopup)
        findReplacePopup = null
        findEntry = null
        replaceEntry = null
        findStatusLbl = null
    }
}

def doFindNext() {
    if activeEditor == null { return }
    if findEntry == null { return }
    searchText = ui_get(findEntry)
    if len(trim(searchText)) == 0 { 
        ui_set(findStatusLbl, "Please enter text to find")
        return 
    }
    result = ui_text_find(activeEditor, searchText)
    if result == "" { 
        ui_set(findStatusLbl, rejoin("Not found: '", searchText, "'")) 
    } else {  
        ui_set(findStatusLbl, rejoin("Found at position: ", result)) 
        sbUpdateCursor() 
    }
}

def doReplace() {
    if activeEditor == null { return }
    if findEntry == null { return }
    if replaceEntry == null { return }
    
    searchText = ui_get(findEntry)
    replaceText = ui_get(replaceEntry)
    if len(trim(searchText)) == 0 {
        ui_set(findStatusLbl, "Please enter text to find")
        return 
    }
    
    selected = ui_text_get_selection(activeEditor)
    if selected == searchText {
        ui_text_replace_selected(activeEditor, replaceText)
        ui_highlight(activeEditor)
        markDirty()
        refreshFunctions()
        ui_set(findStatusLbl, "Replaced 1 occurrence")
        doFindNext()
    } else { doFindNext() }
}

def doReplaceAll() {
    if activeEditor == null { return }
    if findEntry == null { return }
    if replaceEntry == null { return }
    
    searchText = ui_get(findEntry)
    replaceText = ui_get(replaceEntry)
    if len(trim(searchText)) == 0 { 
        ui_set(findStatusLbl, "Please enter text to find")
        return 
    }
    
    fullText = ui_text_get(activeEditor)
    replacedText = replace(fullText, searchText, replaceText)
    
    originalLen = len(fullText)
    newLen = len(replacedText)
    searchLen = len(searchText)
    replaceLen = len(replaceText)
    
    count = 0
    if searchLen != replaceLen { 
        count = (originalLen - newLen) / (searchLen - replaceLen) 
    } else { 
        count = -1 
    }
    
    ui_text_set(activeEditor, replacedText)
    ui_highlight(activeEditor)
    markDirty()
    refreshFunctions()
    
    if count > 0 { ui_set(findStatusLbl, rejoin("Replaced ", count, " occurrences")) } 
    else {
        if fullText == replacedText { ui_set(findStatusLbl, "No occurrences found") } 
        else { ui_set(findStatusLbl, "Replace all completed") }
    }
}

# ==============================================================================
# Help / Documentation 
# ==============================================================================

def openDocumentation() {
    docsPath = path_norm(path_join(path_cwd(), "..", "..", "docs", "index.html"))
    if file_exists(docsPath) == false {
        docsPath = path_norm(path_join(path_dir(interpreter_path()), "docs", "index.html"))
    }

    if file_exists(docsPath) {
        exec(rejoin("start \"\" \"", docsPath, "\""))
        sbSetSuccess("Opened documentation in default browser")
    } else {
        sbSetError("Documentation not found")
        ui_alert_err(rejoin("Could not find documentation file.\nExpected at: ", docsPath))
    }
}

def showAbout() {
    ui_alert("AnikaLang Professional Editor IDE v8.1\n\nIndex-based multi-tab support.\n\nBuilt with AnikaLang")
}

