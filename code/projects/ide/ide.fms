# ==============================================================================
# AnikaLang Professional Editor IDE v7.2 (wxPython - Resizable Layout)
# Features: Dynamic resizing, Client-area awareness, Blue Statusbar
#           HTML Documentation in default browser
# Run: python anika.py ide.fms
# ==============================================================================

# --- Global State ---
currentFilePath = null 
findReplacePopup = null
isDirty = false

# Find/Replace State
findEntry = null
replaceEntry = null
findStatusLbl = null

# --- Statusbar References ---
sbFile = null
sbSaved = null
sbCursor = null
sbLines = null
sbEncoding = null
sbLanguage = null
sbMessage = null
sbClock = null

# --- Layout Widget References (for resize handler) ---
toolbarBg = null
codeEditor = null
navLabel = null
funcSearchEntry = null
funcList = null
statusbarBg = null

# --- Clock State ---
clockTimerId = null

# ==============================================================================
# Resize Handler - Dynamically adjusts layout based on client area
# ==============================================================================

def onWindowResize(widget, newW, newH) {
    # Critical: Get actual drawable client area (excludes title bar and menu bar)
    clientSize = ui_get_client_size(win)
    cw = clientSize[0]
    ch = clientSize[1]
    
    # Layout constants
    toolbarH = 40
    statusbarH = 30
    navW = 350
    gap = 20
    searchH = 25
    
    # Calculate dynamic dimensions
    contentY = toolbarH
    contentH = ch - toolbarH - statusbarH
    editorW = cw - navW - gap
    navX = cw - navW
    sbY = ch - statusbarH
    
    # Prevent negative or extremely small dimensions during aggressive resizing
    if contentH < 100 { contentH = 100 }
    if editorW < 200 { editorW = 200 }
    
    # 1. Resize Toolbar (full width, fixed height at top)
    ui_pos(toolbarBg, 0, 0, cw, toolbarH)
    
    # 2. Resize Code Editor (left side, fills available height)
    ui_pos(codeEditor, 0, contentY, editorW, contentH)
    
    # 3. Resize Function Navigator (right side, fixed width)
    ui_pos(navLabel, navX, contentY + 5, navW, 25)
    ui_pos(funcSearchEntry, navX, contentY + 35, navW, searchH)
    ui_pos(funcList, navX, contentY + 35 + searchH + 5, navW, contentH - 35 - searchH - 5)
    
    # 4. Resize Statusbar (full width, fixed height anchored at bottom)
    ui_pos(statusbarBg, 0, sbY, cw, statusbarH)
    
    # 5. Stretch the message label to fill remaining statusbar space
    msgW = cw - 800
    if msgW < 100 { msgW = 100 }
    ui_pos(sbMessage, 800, 0, msgW, statusbarH)
    
    # Force UI refresh to ensure proper painting after resize
    ui_refresh(win)
}

# ==============================================================================
# Clock & Statusbar Helpers
# ==============================================================================

def updateClock() {
    nowStr = now()
    timePart = right(nowStr, 8)
    ui_set(sbClock, "   " + timePart + "  ")
    clockTimerId = ui_after(1000, "updateClock")
}

def startClock() {
    updateClock()
}

def sbUpdateFile() {
    if currentFilePath == null {
        ui_set(sbFile, "  📄 Untitled.fms")
    } else {
        fname = path_file(currentFilePath)
        ui_set(sbFile, "   " + fname)
    }
}

def sbUpdateSaved() {
    if isDirty == true {
        ui_set(sbSaved, "  ● Modified ")
    } else {
        ui_set(sbSaved, "  ✓ Saved ")
    }
}

def sbUpdateCursor() {
    try {
        pos = ui_editor_get_cursor(codeEditor)
        ui_set(sbCursor, "  Ln " + pos + "  ")
    } catch err {
        ui_set(sbCursor, "  Ln 1:1  ")
    }
}

def sbUpdateLines() {
    count = ui_editor_get_line_count(codeEditor)
    ui_set(sbLines, "  Lines: " + count)
}

def sbSetMessage(msg) { ui_set(sbMessage, "  " + msg) }
def sbSetError(msg) { ui_set(sbMessage, "   " + msg) }
def sbSetSuccess(msg) { ui_set(sbMessage, "  ✓ " + msg) }
def sbSetInfo(msg) { ui_set(sbMessage, "  ℹ " + msg) }

def markDirty() {
    if isDirty == false {
        isDirty = true
        sbUpdateSaved()
    }
}

def markSaved() {
    isDirty = false
    sbUpdateSaved()
}

def onEditorChange() {
    markDirty()
    sbUpdateCursor()
    sbUpdateLines()
    refreshFunctions()
}

def onCursorMove() {
    sbUpdateCursor()
}

# ==============================================================================
# File Operations
# ==============================================================================

def newFile() {
    ui_text_set(codeEditor, "# New AnikaLang Script\n\ndef main() {\n    win = ui_window('My App')\n    ui_mainloop(win)\n}\nmain() \n")
    currentFilePath = null
    markSaved()
    sbUpdateFile()
    sbUpdateCursor()
    sbUpdateLines()
    sbSetInfo("New file created")
    refreshFunctions()
}

def openFile() {
    path = ui_file_open(codeEditor)
    if path != "" {
        currentFilePath = path
        markSaved()
        sbUpdateFile()
        sbUpdateCursor()
        sbUpdateLines()
        ui_highlight(codeEditor)
        refreshFunctions()
        sbSetSuccess("Opened: " + path_file(path))
    }
}

def saveFile() {
    if currentFilePath == null {
        path = ui_file_save(codeEditor)
        if path != "" {
            currentFilePath = path
            content = ui_text_get(codeEditor)
            file_write(currentFilePath, content)
            markSaved()
            sbUpdateFile()
            sbSetSuccess("Saved: " + path_file(path))
        }
    } else {
        content = ui_text_get(codeEditor)
        file_write(currentFilePath, content)
        markSaved()
        sbSetSuccess("Saved: " + path_file(currentFilePath))
    }
}

def runCode() {
    if isDirty == true {
        if currentFilePath != null {
            content = ui_text_get(codeEditor)
            file_write(currentFilePath, content)
            markSaved()
        }
    }
    
    codeText = ui_text_get(codeEditor)
    projectDir = ""
    
    if currentFilePath != null {
        projectDir = path_dir(currentFilePath)
    } else {
        projectDir = path_cwd()
    }
    
    tempPath = path_join(projectDir, "temp_run.fms")
    file_write(tempPath, codeText)
    
    interp = interpreter_path()
    isExe = false
    ext = path_ext(interp)
    
    if lower(ext) == ".exe" {
        isExe = true
    }
    
    sbSetInfo("Running...")
    
    if isExe == true {
        exec(interp + " " + tempPath)
    } else {
        exePath = replace(interp, ".py", ".exe")
        if file_exists(exePath) {
            exec(exePath + " " + tempPath)
        } else {
            exec("python " + interp + " " + tempPath)
        }
    }
    
    sbSetSuccess("Run completed: " + path_file(tempPath))
}

def exitApp() {
    ui_close(win)
}

def applyHighlight() {
    ui_highlight(codeEditor)
    refreshFunctions()
    sbSetInfo("Syntax highlighted")
}

def refreshFunctions() {
    # Get current search text to maintain filter
    searchText = ""
    if funcSearchEntry != null {
        searchText = lower(ui_get(funcSearchEntry))
    }
    
    ui_listview_clear(funcList)
    funcs = ui_editor_get_functions(codeEditor)
    
    for f in funcs {
        funcName = lower(f[1])
        # If search text is empty or function name contains search text
        if searchText == "" or contains(funcName, searchText) {
            ui_listview_insert(funcList, [f[0], f[1]])
        }
    }
    sbUpdateLines()
}

# New function to handle search bar changes
def onFuncSearchChange() {
    refreshFunctions()
}

def onFunctionClick(widget) {
    selected = ui_listview_get_selected(funcList)
    if selected != null {
        lineNum = selected[0]
        ui_editor_goto_line(codeEditor, lineNum)
        sbUpdateCursor()
        sbSetInfo("Jumped to line " + lineNum)
    }
}

# ==============================================================================
# Edit Operations
# ==============================================================================

def doCut() {
    selected = ui_text_get_selection(codeEditor)
    if len(selected) == 0 {
        sbSetError("Nothing selected to cut")
        return
    }
    clipboard_set(selected)
    ui_text_delete_selection(codeEditor)
    markDirty()
    sbUpdateCursor()
    sbSetMessage("Cut " + len(selected) + " characters")
}

def doCopy() {
    selected = ui_text_get_selection(codeEditor)
    if len(selected) == 0 {
        sbSetError("Nothing selected to copy")
        return
    }
    clipboard_set(selected)
    sbSetMessage("Copied " + len(selected) + " characters")
}

def doPaste() {
    clip = clipboard_get()
    if len(clip) == 0 {
        sbSetError("Clipboard is empty")
        return
    }
    ui_text_insert_at_cursor(codeEditor, clip)
    ui_highlight(codeEditor)
    markDirty()
    sbUpdateCursor()
    sbUpdateLines()
    sbSetMessage("Pasted " + len(clip) + " characters")
}

def doSelectAll() {
    ui_text_select_all(codeEditor)
    sbSetMessage("Selected all text")
}

# ==============================================================================
# Find & Replace 
# ==============================================================================

def openFindReplace() {
    # Close existing popup if open
    if findReplacePopup != null {
        ui_close(findReplacePopup)
    }
    
    # Create popup with slightly larger size for breathing room
    findReplacePopup = ui_popup("Find & Replace", 540, 400)
    
    # =====================================================================
    # Header Bar (Blue accent bar at top)
    # =====================================================================
    frHeader = ui_panel(findReplacePopup, 0, 0, 520, 40)
    ui_color(frHeader, "", "#2c3e50")
    
    frTitle = ui_label(frHeader, "   Find & Replace", 0, 8, 300, 25)
    ui_color(frTitle, "#ffffff", "")
    
    # =====================================================================
    # Find Section
    # =====================================================================
    findLbl = ui_label(findReplacePopup, "Find what:", 20, 55, 90, 25)
    ui_color(findLbl, "#2c3e50", "")
    
    findEntry = ui_entry(findReplacePopup, "", 115, 53, 385, 28)
    
    # =====================================================================
    # Replace Section
    # =====================================================================
    replaceLbl = ui_label(findReplacePopup, "Replace with:", 20, 95, 90, 25)
    ui_color(replaceLbl, "#2c3e50", "")
    
    replaceEntry = ui_entry(findReplacePopup, "", 115, 93, 385, 28)
    
    # =====================================================================
    # Options Row (Checkboxes)
    # =====================================================================
    findCaseCb = ui_checkbox(findReplacePopup, "Match case", 20, 135, 130, 25)
    findWordCb = ui_checkbox(findReplacePopup, "Whole word", 160, 135, 130, 25)
    findWrapCb = ui_checkbox(findReplacePopup, "Wrap around", 300, 135, 130, 25)
    ui_checkbox_set(findWrapCb, true)
    
    # =====================================================================
    # Separator Line (Visual divider)
    # =====================================================================
    frSep = ui_panel(findReplacePopup, 20, 170, 480, 2)
    ui_color(frSep, "", "#dcdde1")
    
    # =====================================================================
    # Action Buttons (Color-coded for clarity)
    # =====================================================================
    # Find Next - Blue (Primary action)
    btnFind = ui_button(findReplacePopup, "Find Next", "doFindNext", 20, 185, 145, 32)
    ui_color(btnFind, "#ffffff", "#3498db")
    
    # Replace - Teal (Secondary action)
    btnReplace = ui_button(findReplacePopup, "Replace", "doReplace", 175, 185, 145, 32)
    ui_color(btnReplace, "#ffffff", "#16a085")
    
    # Replace All - Purple (Bulk action)
    btnReplaceAll = ui_button(findReplacePopup, "Replace All", "doReplaceAll", 330, 185, 170, 32)
    ui_color(btnReplaceAll, "#ffffff", "#8e44ad")
    
    # =====================================================================
    # Status Message Area
    # =====================================================================
    findStatusLbl = ui_label(findReplacePopup, "  Ready", 20, 230, 480, 25)
    ui_color(findStatusLbl, "#7f8c8d", "")
    
    # =====================================================================
    # Close Button (Bottom right, neutral gray)
    # =====================================================================
    btnCloseFr = ui_button(findReplacePopup, "Close", "closeFindReplace", 400, 270, 100, 30)
    ui_color(btnCloseFr, "#ffffff", "#95a5a6")
    
    # Clear the find entry and set focus
    ui_set(findEntry, "")
    ui_focus(findEntry)
}

def closeFindReplace() {
    if findReplacePopup != null {
        ui_close(findReplacePopup)
        findReplacePopup = null
        findEntry = null
        replaceEntry = null
        findStatusLbl = null
    }
}

def doFindNext() {
    
    if findEntry == null { return }
    
    searchText = ui_get(findEntry)
    
    if len(trim(searchText)) == 0 {
        ui_set(findStatusLbl, "Please enter text to find")
        return
    }
    
    result = ui_text_find(codeEditor, searchText)
    
    if result == "" {
        ui_set(findStatusLbl, "Not found: '" + searchText + "'")
    } else {
        ui_set(findStatusLbl, "Found at position: " + result)
        sbUpdateCursor()
    }
}

def doReplace() {
    if findEntry == null { return }
    if replaceEntry == null { return }
    
    searchText = ui_get(findEntry)
    replaceText = ui_get(replaceEntry)
    
    if len(trim(searchText)) == 0 {
        ui_set(findStatusLbl, "Please enter text to find")
        return
    }
    
    selected = ui_text_get_selection(codeEditor)
    if selected == searchText {
        ui_text_replace_selected(codeEditor, replaceText)
        ui_highlight(codeEditor)
        markDirty()
        refreshFunctions()
        ui_set(findStatusLbl, "Replaced 1 occurrence")
        doFindNext()
    } else {
        doFindNext()
    }
}

def doReplaceAll() {
    if findEntry == null { return }
    if replaceEntry == null { return }
    
    searchText = ui_get(findEntry)
    replaceText = ui_get(replaceEntry)
    
    if len(trim(searchText)) == 0 {
        ui_set(findStatusLbl, "Please enter text to find")
        return
    }
    
    fullText = ui_text_get(codeEditor)
    replacedText = replace(fullText, searchText, replaceText)
    
    originalLen = len(fullText)
    newLen = len(replacedText)
    searchLen = len(searchText)
    replaceLen = len(replaceText)
    
    if searchLen != replaceLen {
        count = (originalLen - newLen) / (searchLen - replaceLen)
    } else {
        count = -1
    }
    
    ui_text_set(codeEditor, replacedText)
    ui_highlight(codeEditor)
    markDirty()
    refreshFunctions()
    
    if count > 0 {
        ui_set(findStatusLbl, "Replaced " + count + " occurrences")
    } else {
        if fullText == replacedText {
            ui_set(findStatusLbl, "No occurrences found")
        } else {
            ui_set(findStatusLbl, "Replace all completed")
        }
    }
}

# ==============================================================================
# Help / Documentation 
# ==============================================================================

def openDocumentation() {
    # Attempt to locate docs relative to CWD (e.g. if run from projects/ide/)
    docsPath = path_norm(path_join(path_cwd(), "..", "..", "docs", "index.html"))
    
    # Fallback: Locate relative to the interpreter/main.py directory
    if file_exists(docsPath) == false {
        docsPath = path_norm(path_join(path_dir(interpreter_path()), "docs", "index.html"))
    }

    if file_exists(docsPath) {
        # Open in default system browser (Windows 'start' command)
        exec("start \"\" \"" + docsPath + "\"")
        sbSetSuccess("Opened documentation in default browser")
    } else {
        sbSetError("Documentation not found")
        ui_alert_err("Could not find documentation file.\nExpected at: " + docsPath)
    }
}

def showAbout() {
    ui_alert("AnikaLang Professional Editor IDE v7.2\n\nA custom scripting language with:\n• wxPython GUI framework\n• SQLite database support\n• Native menus and widgets\n• Project-aware execution\n• Real-time syntax highlighting\n• Blue simulated statusbar\n• Dynamic resizable layout\n• HTML documentation\n\nBuilt with AnikaLang")
}

# ==============================================================================
# UI Layout - wxPython with Dynamic Client-Area Sizing
# ==============================================================================

win = ui_window("AnikaLang Professional Editor IDE v7.2", 1400, 1000)

# ==============================================================================
# Menu Bar
# ==============================================================================

menubar = ui_menu(win)

fileMenu = ui_menu_add(menubar, "File")
ui_menu_item(fileMenu, "New              Ctrl+N", "newFile")
ui_menu_item(fileMenu, "Open...          Ctrl+O", "openFile")
ui_menu_item(fileMenu, "Save              Ctrl+S", "saveFile")
ui_menu_separator(fileMenu)
ui_menu_item(fileMenu, "Run                F5", "runCode")
ui_menu_separator(fileMenu)
ui_menu_item(fileMenu, "Exit", "exitApp")

editMenu = ui_menu_add(menubar, "Edit")
ui_menu_item(editMenu, "Cut                Ctrl+X", "doCut")
ui_menu_item(editMenu, "Copy              Ctrl+C", "doCopy")
ui_menu_item(editMenu, "Paste             Ctrl+V", "doPaste")
ui_menu_separator(editMenu)
ui_menu_item(editMenu, "Select All       Ctrl+A", "doSelectAll")
ui_menu_separator(editMenu)
ui_menu_item(editMenu, "Find & Replace  Ctrl+F", "openFindReplace")

viewMenu = ui_menu_add(menubar, "View")
ui_menu_item(viewMenu, "Highlight Syntax", "applyHighlight")
ui_menu_item(viewMenu, "Refresh Function List", "refreshFunctions")

helpMenu = ui_menu_add(menubar, "Help")
ui_menu_item(helpMenu, "Documentation (HTML)", "openDocumentation")
ui_menu_separator(helpMenu)
ui_menu_item(helpMenu, "About AnikaLang", "showAbout")

ui_set_menu(win, menubar)

# ==============================================================================
# Right-Click Context Menu
# ==============================================================================

ctxMenu = ui_popup_menu()
ui_popup_item(ctxMenu, "Cut", "doCut")
ui_popup_item(ctxMenu, "Copy", "doCopy")
ui_popup_item(ctxMenu, "Paste", "doPaste")
ui_popup_separator(ctxMenu)
ui_popup_item(ctxMenu, "Select All", "doSelectAll")
ui_popup_separator(ctxMenu)
ui_popup_item(ctxMenu, "Find & Replace...", "openFindReplace")
ui_popup_separator(ctxMenu)
ui_popup_item(ctxMenu, "Highlight Syntax", "applyHighlight")

# ==============================================================================
# Dynamic Client-Area Sizing (Initial Layout Calculation)
# ==============================================================================

# Get actual client area size after menu bar is attached
clientSize = ui_get_client_size(win)
cw = clientSize[0]
ch = clientSize[1]

# Layout constants
toolbarH = 40
statusbarH = 30
navW = 350
gap = 20
searchH = 25

# Calculate dynamic dimensions
contentY = toolbarH
contentH = ch - toolbarH - statusbarH
editorW = cw - navW - gap
navX = cw - navW
sbY = ch - statusbarH

# Fallback for minimum sizes
if contentH < 100 { contentH = 100 }
if editorW < 200 { editorW = 200 }

# ==============================================================================
# Main Layout - Absolute Positioning with Dynamic Variables
# ==============================================================================

# --- Toolbar (y=0, height=40) ---
toolbarBg = ui_panel(win, 0, 0, cw, toolbarH)
ui_color(toolbarBg, "", "#2c3e50")

# New (Green)
btnNew = ui_button(toolbarBg, "New", "newFile", 10, 5, 80, 30)
ui_color(btnNew, "#ffffff", "#27ae60")

# Open (Blue)
btnOpen = ui_button(toolbarBg, "Open", "openFile", 100, 5, 80, 30)
ui_color(btnOpen, "#ffffff", "#3498db")

# Save (Orange)
btnSave = ui_button(toolbarBg, "Save", "saveFile", 190, 5, 80, 30)
ui_color(btnSave, "#ffffff", "#e67e22")

# Run (Bright Green/Teal)
btnRun = ui_button(toolbarBg, "▶ Run", "runCode", 280, 5, 90, 30)
ui_color(btnRun, "#ffffff", "#2ecc71")

# Highlight (Purple)
btnHighlight = ui_button(toolbarBg, "Highlight", "applyHighlight", 380, 5, 100, 30)
ui_color(btnHighlight, "#ffffff", "#9b59b6")

# Refresh (Dark Teal)
btnRefresh = ui_button(toolbarBg, "Refresh Functions", "refreshFunctions", 490, 5, 160, 30)
ui_color(btnRefresh, "#ffffff", "#16a085")

# --- Code Editor (Left side) ---
codeEditor = ui_code_editor(win, 0, contentY, editorW, contentH)

ui_bind_popup(codeEditor, ctxMenu)
ui_bind(codeEditor, "change", "onEditorChange")
ui_bind(codeEditor, "cursor_move", "onCursorMove")

# --- Function Navigator (Right side) ---
navLabel = ui_label(win, "Function Navigator", navX, contentY + 5, navW, 25)
ui_color(navLabel, "#faf9f6", "#2c3e50")

# New: Search bar for functions
funcSearchEntry = ui_entry(win, "", navX, contentY + 35, navW, searchH)
ui_color(funcSearchEntry, "#2D2D2D", "#faf9f6")
ui_bind(funcSearchEntry, "change", "onFuncSearchChange")

funcList = ui_listview(win, ["Line", "Function Name"], navX, contentY + 35 + searchH + 5, navW, contentH - 35 - searchH - 5)
ui_listview_set_column_width(funcList, 0, 70)
ui_listview_set_column_width(funcList, 1, 250)
ui_color(funcList, "#2D2D2D", "#faf9f6")
ui_font(funcList, 10, "Consolas")
ui_bind(funcList, "double_click", "onFunctionClick")

# ==============================================================================
# Statusbar (Bottom) - Blue Simulated Statusbar
# ==============================================================================

statusbarBg = ui_panel(win, 0, sbY, cw, statusbarH)
ui_color(statusbarBg, "", "#2c3e50")

# Statusbar sections with fixed positions - White text on blue background
sbFile = ui_label(statusbarBg, "   Untitled.fms  ", 0, 0, 200, statusbarH)
ui_color(sbFile, "#ffffff", "#2c3e50")

sbSaved = ui_label(statusbarBg, "  ✓ Saved  ", 200, 0, 100, statusbarH)
ui_color(sbSaved, "#ffffff", "#2c3e50")

sbCursor = ui_label(statusbarBg, "  Ln 1:1  ", 300, 0, 100, statusbarH)
ui_color(sbCursor, "#ffffff", "#2c3e50")

sbLines = ui_label(statusbarBg, "  Lines: 0  ", 400, 0, 100, statusbarH)
ui_color(sbLines, "#ffffff", "#2c3e50")

sbEncoding = ui_label(statusbarBg, "  UTF-8  ", 500, 0, 80, statusbarH)
ui_color(sbEncoding, "#ffffff", "#2c3e50")

sbLanguage = ui_label(statusbarBg, "  AnikaLang  ", 580, 0, 100, statusbarH)
ui_color(sbLanguage, "#ffffff", "#2c3e50")

sbClock = ui_label(statusbarBg, "  🕐 --:--:--  ", 680, 0, 120, statusbarH)
ui_color(sbClock, "#ffffff", "#2c3e50")

# Message label stretches to fill remaining space
msgW = cw - 800
if msgW < 100 { msgW = 100 }
sbMessage = ui_label(statusbarBg, "  Ready  ", 800, 0, msgW, statusbarH)
ui_color(sbMessage, "#ffffff", "#2c3e50")

# ==============================================================================
# Bind Resize Event & Initialization
# ==============================================================================

# Bind the resize handler to dynamically adjust layout when window changes size
ui_bind(win, "resize", "onWindowResize")

# Initialize editor state and start the clock
newFile()
startClock()

# Enter the main event loop
ui_mainloop(win)