    ui_radio(dlg_sub, "Organize output by variables", "org", "multi", 30, 180, 200, 25)
    
    ui_checkbox(dlg_sub, "Suppress tables more than n categories", 20, 220, 300, 25)
    ui_entry(dlg_sub, "10", 330, 220, 40, 25)
    
    ui_button(dlg_sub, "Continue", "close_sub_dlg", 150, 300, 100, 30)
}

def run_frequencies() {
    close_main_dlg()
    ui_text_append(output_results, "\n> FREQUENCIES VARIABLES=VAR00001\n  /STATISTICS=MEAN MEDIAN MODE STDDEV VARIANCE RANGE MIN MAX\n  /CHARTS=BAR\n  /ORDER=ANALYSIS.\n")
}

# --- 2. LINEAR REGRESSION (Deep Nesting) ---
