    ui_label(dlg_sub, "Sort by", 20, 20, 100, 25)
    ui_radio(dlg_sub, "Values", "val", "sort_by", 30, 50, 100, 25)
    ui_radio(dlg_sub, "Counts", "cnt", "sort_by", 30, 80, 100, 25)
    
