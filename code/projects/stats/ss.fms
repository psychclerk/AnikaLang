    ui_label(dlg_main, "Method:", 240, 20, 80, 25)
    ui_combobox(dlg_main, ["Enter", "Stepwise", "Remove", "Forward", "Backward"], 240, 50, 150, 25)
    
    ui_label(dlg_main, "Selection Variable:", 240, 90, 120, 25)
    ui_entry(dlg_main, "", 240, 120, 150, 25)
    ui_button(dlg_main, "Rule...", "noop", 400, 120, 60, 25)
    
    ui_label(dlg_main, "Case Labels:", 240, 160, 100, 25)
    ui_listbox(dlg_main, 240, 190, 200, 260)
    
    # Buttons
    ui_button(dlg_main, "Statistics...", "open_reg_stats", 460, 20, 120, 30)
