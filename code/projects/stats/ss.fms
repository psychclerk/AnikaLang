# ==============================================================================
# IBM SPSS STATISTICS 29.0 - 1:1 GUI CLONE (AnikaLang 1.2)
# Full Menu Hierarchy, Deep Nested Dialogs, Dynamic Resizing
# ==============================================================================

# --- Global State ---
main_win = null
workspace_tabs = null
status_bar_lbl = null
toolbar = null
status_bg = null

# Workspace Widgets
data_view_sheet = null
var_view_sheet = null
output_tree = null
output_results = null
syntax_editor = null

# Dialog State (Stack for nested dialogs)
dlg_main = null
dlg_sub = null

# ==============================================================================
# RESIZE HANDLER
# ==============================================================================

def on_window_resize(widget, newW, newH) {
    ui_pos(toolbar, 0, 0, newW, 40)
    ui_pos(workspace_tabs, 0, 40, newW, newH - 70)
    ui_pos(status_bg, 0, newH - 30, newW, 30)
    
    inner_w = newW - 40
    inner_h = newH - 120
    
    if data_view_sheet != null { ui_pos(data_view_sheet, 10, 10, inner_w, inner_h) }
    if var_view_sheet != null { ui_pos(var_view_sheet, 10, 10, inner_w, inner_h) }
    if output_tree != null { ui_pos(output_tree, 10, 10, 300, inner_h) }
    if output_results != null { ui_pos(output_results, 320, 10, inner_w - 320, inner_h) }
    if syntax_editor != null { ui_pos(syntax_editor, 10, 10, inner_w, inner_h) }
}

# ==============================================================================
# MENU WRAPPERS (Parameterless)
# ==============================================================================

# File
def m_file_new_data() { switch_tab(0) }
def m_file_new_output() { switch_tab(2) }
def m_file_new_syntax() { switch_tab(3) }
def m_file_open() { ui_alert("Open Data File Dialog (Native)") }
def m_file_save() { ui_alert("Save Data As Dialog (Native)") }
def m_file_print() { ui_alert("Print Dialog (Native)") }
def m_file_exit() { ui_close(main_win) }

