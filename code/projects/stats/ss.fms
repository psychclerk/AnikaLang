    ui_button(dlg_main, "Save...", "open_reg_save", 460, 100, 120, 30)
    ui_button(dlg_main, "Options...", "open_reg_options", 460, 140, 120, 30)
    ui_button(dlg_main, "WLS Weight...", "noop", 460, 180, 120, 30)
    
    ui_button(dlg_main, "OK", "run_regression", 500, 450, 80, 30)
    ui_button(dlg_main, "Paste", "noop", 590, 450, 80, 30)
    ui_button(dlg_main, "Reset", "noop", 500, 490, 80, 30)
    ui_button(dlg_main, "Cancel", "close_main_dlg", 590, 490, 80, 30)
    ui_button(dlg_main, "Help", "noop", 680, 490, 50, 30)
}

