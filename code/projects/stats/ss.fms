def open_recode_oldnew() {
    close_sub_dlg()
    dlg_sub = ui_popup("Recode into Different Variables: Old and New Values", 600, 450)
    
    ui_label(dlg_sub, "Old Value", 20, 20, 100, 25)
    ui_radio(dlg_sub, "Value", "val", "old", 30, 50, 100, 25)
    ui_entry(dlg_sub, "", 140, 50, 60, 25)
    ui_radio(dlg_sub, "System-missing", "sys", "old", 30, 80, 120, 25)
    ui_radio(dlg_sub, "Range", "rng", "old", 30, 110, 100, 25)
    ui_entry(dlg_sub, "0", 140, 110, 40, 25)
