    ui_checkbox(dlg_sub, "Cut points for", 30, 80, 100, 25)
    ui_entry(dlg_sub, "0", 140, 80, 40, 25)
    ui_checkbox(dlg_sub, "Percentiles", 30, 110, 100, 25)
    ui_entry(dlg_sub, "0", 140, 110, 40, 25)
    
    ui_label(dlg_sub, "Central Tendency", 20, 150, 150, 25)
    ui_checkbox(dlg_sub, "Mean", 30, 180, 100, 25)
    ui_checkbox(dlg_sub, "Median", 30, 210, 100, 25)
    ui_checkbox(dlg_sub, "Mode", 30, 240, 100, 25)
    ui_checkbox(dlg_sub, "Sum", 150, 180, 100, 25)
    
    ui_label(dlg_sub, "Dispersion", 20, 280, 150, 25)
    ui_checkbox(dlg_sub, "Std. deviation", 30, 310, 120, 25)
    ui_checkbox(dlg_sub, "Variance", 30, 340, 100, 25)
    ui_checkbox(dlg_sub, "Range", 150, 310, 100, 25)
    ui_checkbox(dlg_sub, "Minimum", 30, 370, 100, 25)
    ui_checkbox(dlg_sub, "Maximum", 150, 340, 100, 25)
    ui_checkbox(dlg_sub, "S.E. mean", 150, 370, 100, 25)
    
    ui_label(dlg_sub, "Distribution", 220, 280, 150, 25)
    ui_checkbox(dlg_sub, "Skewness", 230, 310, 100, 25)
    ui_checkbox(dlg_sub, "Kurtosis", 230, 340, 100, 25)
    
    ui_button(dlg_sub, "Continue", "close_sub_dlg", 150, 400, 100, 30)
}

def open_freq_charts() {
    close_sub_dlg()
    dlg_sub = ui_popup("Frequencies: Charts", 400, 350)
    
    ui_label(dlg_sub, "Chart Type", 20, 20, 100, 25)
    ui_radio(dlg_sub, "None", "none", "chart_type", 30, 50, 100, 25)
