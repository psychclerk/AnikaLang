def m_trans_visual_binning() { ui_alert("Visual Binning") }
def m_trans_rank() { ui_alert("Rank Cases") }

# Analyze (Deep Nesting Implemented)
def m_analyze_freq() { open_frequencies() }
def m_analyze_desc() { open_descriptives() }
def m_analyze_explore() { ui_alert("Explore Dialog") }
def m_analyze_crosstabs() { ui_alert("Crosstabs Dialog") }
