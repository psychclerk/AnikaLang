def m_help_tutorial() { ui_alert("Tutorial") }
def m_help_about() { ui_alert("About IBM SPSS Statistics 29.0.0.0") }

# ==============================================================================
# CORE WORKSPACE FUNCTIONS
# ==============================================================================

def switch_tab(idx) { ui_tab_select(workspace_tabs, idx) }

def init_data_view() {
    data_view_sheet = ui_sheet(data_tab, 50, 10, 10, 10, 900, 600)
    ui_sheet_set_column_width(data_view_sheet, 0, 60)
    headers = []
    i = 1
    while i <= 10 {
        list_append(headers, rejoin("VAR0000", i))
        i = i + 1
    }
    ui_sheet_headers(data_view_sheet, headers)
}

def init_variable_view() {
    var_view_sheet = ui_sheet(var_tab, 50, 11, 10, 10, 900, 600)
    var_headers = ["Name", "Type", "Width", "Decimals", "Label", "Values", "Missing", "Columns", "Align", "Measure", "Role"]
    ui_sheet_headers(var_view_sheet, var_headers)
    ui_sheet_set_column_width(var_view_sheet, 0, 100)
    ui_sheet_set_column_width(var_view_sheet, 1, 60)
    ui_sheet_set_column_width(var_view_sheet, 2, 50)
    ui_sheet_set_column_width(var_view_sheet, 3, 60)
    ui_sheet_set_column_width(var_view_sheet, 4, 200)
    ui_sheet_set_column_width(var_view_sheet, 5, 80)
    ui_sheet_set_column_width(var_view_sheet, 6, 70)
    ui_sheet_set_column_width(var_view_sheet, 7, 60)
    ui_sheet_set_column_width(var_view_sheet, 8, 60)
    ui_sheet_set_column_width(var_view_sheet, 9, 80)
    ui_sheet_set_column_width(var_view_sheet, 10, 80)
    ui_sheet_cell_set(var_view_sheet, 0, 0, "ID")
    ui_sheet_cell_set(var_view_sheet, 0, 1, "Numeric")
    ui_sheet_cell_set(var_view_sheet, 0, 2, "8")
    ui_sheet_cell_set(var_view_sheet, 0, 3, "0")
    ui_sheet_cell_set(var_view_sheet, 0, 9, "Scale")
    ui_sheet_cell_set(var_view_sheet, 0, 10, "Input")
}

def init_output_viewer() {
    output_tree = ui_tree(output_tab, 10, 10, 300, 600)
    ui_tree_insert(output_tree, "root", "output1", "Output")
    ui_tree_insert(output_tree, "output1", "log1", "Log")
    ui_tree_expand(output_tree, "output1", true)
    output_results = ui_text(output_tab, "IBM SPSS Statistics 29.0.0.0\n\nOutput Document - Ready.\n", false, 320, 10, 650, 600)
}

def init_syntax_editor() {
    syntax_editor = ui_code_editor(syntax_tab, 10, 10, 960, 600)
    ui_text_set(syntax_editor, "* SPSS Syntax Editor.\nGET FILE='C:\\Data\\sample.sav'.\nFREQUENCIES VARIABLES=ID.\nEXECUTE.")
    ui_highlight(syntax_editor)
}

# ==============================================================================
# DIALOG ENGINE & SUB-DIALOGS (1:1 Parity Depth)
# ==============================================================================

def close_main_dlg() {
    if dlg_main != null { ui_close(dlg_main)
        dlg_main = null }
}

def close_sub_dlg() {
    if dlg_sub != null { ui_close(dlg_sub)
        dlg_sub = null }
}

# --- 1. FREQUENCIES (Deep Nesting) ---
def open_frequencies() {
    close_main_dlg()
    dlg_main = ui_popup("Frequencies", 750, 550)
    
    # Left Pane
    ui_label(dlg_main, "Variable(s):", 20, 20, 100, 25)
    ui_listbox(dlg_main, 20, 50, 200, 400)
    
    # Transfer Buttons
    ui_button(dlg_main, ">", "noop", 230, 150, 40, 30)
    ui_button(dlg_main, "<", "noop", 230, 190, 40, 30)
    
    # Right Pane
    ui_label(dlg_main, "Variable(s):", 280, 20, 100, 25)
    ui_listbox(dlg_main, 280, 50, 200, 400)
    
    # Bottom Options
    ui_checkbox(dlg_main, "Display frequency tables", 20, 470, 200, 25)
    
    # Specific Buttons
    ui_button(dlg_main, "Statistics...", "open_freq_stats", 500, 20, 120, 30)
    ui_button(dlg_main, "Charts...", "open_freq_charts", 500, 60, 120, 30)
    ui_button(dlg_main, "Format...", "open_freq_format", 500, 100, 120, 30)
    
    # Standard Action Buttons
    ui_button(dlg_main, "OK", "run_frequencies", 500, 450, 80, 30)
    ui_button(dlg_main, "Paste", "noop", 590, 450, 80, 30)
    ui_button(dlg_main, "Reset", "noop", 500, 490, 80, 30)
    ui_button(dlg_main, "Cancel", "close_main_dlg", 590, 490, 80, 30)
    ui_button(dlg_main, "Help", "noop", 680, 490, 50, 30)
}

def open_freq_stats() {
    close_sub_dlg()
    dlg_sub = ui_popup("Frequencies: Statistics", 400, 450)
    
    ui_label(dlg_sub, "Percentile Values", 20, 20, 150, 25)
