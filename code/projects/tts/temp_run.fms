# Swap button (between language selectors)
btn_swap = ui_button(header_bg, "⇄", "do_swap_languages", 695, 10, 40, 30)
ui_color(btn_swap, "#ffffff", "#3498db")
ui_font(btn_swap, 14, "Segoe UI", true)

# Target language selector
tgt_lang_lbl = ui_label(header_bg, "To:", 745, 15, 30, 20)
ui_color(tgt_lang_lbl, "#8b949e", "")
